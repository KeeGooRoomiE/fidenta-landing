---
const families = ['Forum', 'Inter', 'Playfair Display', 'Georgia', 'Arial'];
const roles = [['heading', 'Заголовки'], ['copy', 'Основной текст'], ['action', 'Кнопки']];
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Примерка шрифтов — Фидента</title>
  </head>
  <body>
    <form>
      <h1>Примерка шрифтов</h1>
      {roles.map(([name, label]) => <label>{label}
        <select name={name}>
          <option value="">Как на сайте</option>
          {families.map(font => <option>{font}</option>)}
        </select>
      </label>)}
      <button type="reset">Сбросить</button>
    </form>
    <iframe src={import.meta.env.BASE_URL} title="Главная страница Фиденты"></iframe>
    <script>
      const frame = document.querySelector('iframe')!;
      const form = document.querySelector('form')!;
      const selectors = {
        heading: 'h1,h2,h3,h4',
        copy: 'p,dd,dt,label,textarea,input,li[data-step],.text-lead',
        action: 'button,button span,.hero-btn,.btn-hero,.contact-action,.contact-action span',
      };
      function applyFonts() {
        const doc = frame.contentDocument;
        if (!doc?.head) return;
        const sheet = doc.getElementById('font-preview') || doc.createElement('style');
        sheet.id = 'font-preview';
        const values = new FormData(form);
        sheet.textContent = Object.entries(selectors).map(([role, selector]) => {
          const font = String(values.get(role) || '');
          return font ? selector + '{font-family:"' + CSS.escape(font) + '" !important}' : '';
        }).join('\n');
        if (!sheet.isConnected) doc.head.append(sheet);
      }
      frame.addEventListener('load', applyFonts);
      form.addEventListener('change', applyFonts);
      form.addEventListener('reset', () => requestAnimationFrame(applyFonts));
      applyFonts();
    </script>
  </body>
</html>
<style>
  * { box-sizing: border-box; }
  body { margin: 0; height: 100dvh; display: flex; flex-direction: column; background: #071814; color: #efe6d4; font: 14px system-ui, sans-serif; }
  form { display: flex; align-items: end; flex-wrap: wrap; gap: 10px 20px; padding: 12px clamp(12px, 3vw, 48px); border-bottom: 1px solid #786f57; }
  h1 { align-self: center; margin: 0 auto 0 0; font: 24px Georgia, serif; }
  label { display: grid; gap: 3px; }
  select, button { background: #132921; border: 1px solid #786f57; padding: 6px 9px; color: inherit; border-radius: 5px; }
  iframe { flex: 1; width: 100%; min-height: 0; border: 0; }
  @media (width < 600px) { form { gap: 6px; } h1 { width: 100%; font-size: 18px; } select { max-width: 110px; } }
</style>
