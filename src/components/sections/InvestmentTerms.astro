---
/*
  УРОВЕНЬ 3 — БЛОК «Условия участия» (Инвестиции для тех, кто ценит время)
  Источник: Figma, узел 974:65641 — своя разметка (не через SectionHeading):
  заголовок здесь ПРАВОВЫРОВНЕННЫЙ и двухстрочный с переносом ВНУТРИ строки
  (золотая строка на отдельной строке, не инлайн-акцент после текста), под
  паттерн SectionHeading (title+inline accent, left/center) не подходит.
  На мобильном выравнивание вправо снимается (сплошной текст вправо на узком
  экране читается плохо) — только md: и шире.

  Структура: eyebrow (текст + декоративная линия после) → H2 (бело/золото) →
  подзаголовок → хайрлайн → два списка «Подходит/Не подходит, если» с
  вертикальным разделителем между колонками на md+ → хайрлайн → футер
  (мета-текст условий + CTA-кнопка).

  Плейсхолдеры "00 лет"/"раз в 00 месяцев" — так в Figma (значения ещё не
  согласованы с клиентом), оставлены как есть, а не выдуманы.
*/
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
const fitsIf = [
  'свободные 200 000 ₽ и больше, которые не понадобятся 00 лет',
  'нужен конкретный адрес и конкретный арендатор, а не пай в фонде',
  'готовы прочитать договор и отчёт оценщика до перевода денег',
  'доход от аренды важнее прибыли на перепродаже',
];

const doesNotFitIf = [
  'деньги могут понадобиться раньше срока',
  'нужен гарантированный результат',
  'это последние сбережения или заёмные деньги',
  'хотите сами принимать решения по объекту',
];
---

<Section id="terms">
    {/* Заголовок секции: вправо на md+, влево на мобильном.
         relative — для декоративных часов в пустой левой части (только md+) */}
    <div class="relative flex flex-col items-start gap-3 text-left md:items-end md:text-right">
      {/*
        ПЕСОЧНЫЕ ЧАСЫ (по правке дизайнера вместо аналоговых: «не цепляют»). Декоративный SVG в золотой линии:
        золотой песок за 60 секунд перетекает сверху вниз, затем колба плавно переворачивается и цикл
        повторяется (в перевёрнутом виде кадр совпадает с началом — шва не видно). Анимация — скрипт ниже,
        атрибутами SVG (не CSS), чтобы одинаково работать в Safari и при CSS zoom на больших экранах.
        Песок — прямоугольники под clipPath по форме колбы; их высота = прогресс цикла.
        aria-hidden — для скринридеров это украшение. При prefers-reduced-motion песок стоит.
      */}
      <svg
        id="terms-glass"
        class="pointer-events-none absolute left-0 top-0 hidden size-[190px] md:block lg:size-[220px]"
        viewBox="0 0 200 200"
        fill="none"
        aria-hidden="true"
      >
        <defs>
          <linearGradient id="glass-gold" x1="0" y1="0" x2="200" y2="200" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#FFF1D9" stop-opacity="0.9"></stop>
            <stop offset="1" stop-color="#A88548" stop-opacity="0.9"></stop>
          </linearGradient>
          <linearGradient id="glass-sand" x1="0" y1="24" x2="0" y2="176" gradientUnits="userSpaceOnUse">
            <stop offset="0" stop-color="#E6C77A"></stop>
            <stop offset="1" stop-color="#B8903F"></stop>
          </linearGradient>
          {/* Внутренность колбы: по ней обрезается песок */}
          <clipPath id="glass-clip">
            <path d="M66 26H134C134 66 106 84 105 100C106 116 134 134 134 174H66C66 134 94 116 95 100C94 84 66 66 66 26Z"></path>
          </clipPath>
        </defs>

        <g id="glass-body">
          <g clip-path="url(#glass-clip)">
            <rect id="sand-top" x="0" y="26" width="200" height="74" fill="url(#glass-sand)" fill-opacity="0.85"></rect>
            <rect id="sand-bottom" x="0" y="174" width="200" height="0" fill="url(#glass-sand)" fill-opacity="0.85"></rect>
          </g>
          {/* Струйка песка через горлышко */}
          <line id="sand-stream" x1="100" y1="98" x2="100" y2="174" stroke="#E6C77A" stroke-width="1.3" stroke-dasharray="2 3" stroke-linecap="round"></line>
          {/* Стекло */}
          <path d="M66 26H134C134 66 106 84 105 100C106 116 134 134 134 174H66C66 134 94 116 95 100C94 84 66 66 66 26Z" stroke="url(#glass-gold)" stroke-width="1.5" stroke-linejoin="round"></path>
          {/* Верхняя и нижняя опоры */}
          <g stroke="url(#glass-gold)" stroke-linecap="round">
            <line x1="52" y1="20" x2="148" y2="20" stroke-width="3"></line>
            <line x1="52" y1="180" x2="148" y2="180" stroke-width="3"></line>
            <line x1="60" y1="14" x2="140" y2="14" stroke-width="1" stroke-opacity="0.45"></line>
            <line x1="60" y1="186" x2="140" y2="186" stroke-width="1" stroke-opacity="0.45"></line>
          </g>
        </g>
      </svg>

      <div class="flex items-center gap-2.5">
        <span class="text-eyebrow text-gold-plate">условия участия</span>
        <span class="hidden h-px w-5 md:block bg-gold-line"></span>
      </div>
      <h2 class="text-h2">
        <span class="block text-fg">Инвестиции для тех,</span>
        <span class="block text-gold-plate">кто ценит время</span>
      </h2>
      <p class="max-w-2xl text-lead text-fg md:ml-auto">
        Берём на себя все задачи по управлению объектом, чтобы вы могли сосредоточиться на развитии капитала.
      </p>
    </div>

    {/* Блок условий */}
    <div class="mt-10 flex flex-col gap-8 md:mt-16">
      <div class="h-px w-full bg-gold-line"></div>

      <div class="grid gap-8 md:grid-cols-[1fr_auto_1fr] md:gap-0">
        <div class="flex flex-col gap-4 md:gap-6 md:pr-10">
          <p class="font-accent text-xl text-fg md:text-2xl">Подходит, если</p>
          <ul class="flex flex-col gap-3 md:gap-[18px]">
            {fitsIf.map((text) => (
              <li class="flex items-start gap-3 md:gap-4">
                {/* Тире по центру ПЕРВОЙ строки (items-start + mt), а не по центру всего пункта */}
                <span class="mt-[11px] h-px w-4 shrink-0 md:mt-3.5 md:w-5 bg-gold-line"></span>
                <span class="font-accent text-base leading-[1.4] text-fg md:text-lg md:leading-[1.55]">{text}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="hidden md:block md:w-px md:self-stretch md:justify-self-center bg-gold-line"></div>

        <div class="flex flex-col gap-4 md:gap-6 md:pl-10">
          <p class="font-accent text-xl text-fg md:text-2xl">Не подходит, если</p>
          <ul class="flex flex-col gap-3 md:gap-[18px]">
            {doesNotFitIf.map((text) => (
              <li class="flex items-start gap-3 md:gap-4">
                {/* Тире по центру ПЕРВОЙ строки (items-start + mt), а не по центру всего пункта */}
                <span class="mt-[11px] h-px w-4 shrink-0 md:mt-3.5 md:w-5 bg-gold-line"></span>
                <span class="font-accent text-base leading-[1.4] text-fg md:text-lg md:leading-[1.55]">{text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="h-px w-full bg-gold-line"></div>

      <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
        <p class="max-w-3xl font-accent text-sm leading-relaxed text-gold-plate md:text-base">
          Горизонт участия — 2–10 лет · Выплаты арендного дохода — раз в 00 месяцев · Что оформляется на инвестора — доля собственности
        </p>
        <Button variant="outline" block href="#cta" data-cta-audience="investor">Разобрать условия по объекту →</Button>
      </div>
    </div>
</Section>


<script>
  // Песочные часы: цикл 60 с — песок перетекает, затем колба переворачивается (1.4 с) и всё сначала.
  // Всё через атрибуты SVG (rect height/y, transform="rotate(угол 100 100)"): так же надёжно в Safari и при CSS zoom.
  const body = document.getElementById('glass-body');
  const sandTop = document.getElementById('sand-top');
  const sandBottom = document.getElementById('sand-bottom');
  const stream = document.getElementById('sand-stream');

  if (body && sandTop && sandBottom && stream) {
    const FLOW = 60000; // перетекание, мс
    const FLIP = 1400; // переворот, мс
    const TOP = 26; // верх внутренней части колбы
    const MID = 100; // горлышко
    const BOT = 174; // низ

    // p: 0 — весь песок сверху, 1 — весь внизу; angle — поворот колбы
    const draw = (p: number, angle: number) => {
      sandTop.setAttribute('y', String(TOP + (MID - TOP) * p));
      sandTop.setAttribute('height', String((MID - TOP) * (1 - p)));
      sandBottom.setAttribute('y', String(BOT - (BOT - MID) * p));
      sandBottom.setAttribute('height', String((BOT - MID) * p));
      // струйка есть, пока песок течёт (на старте и в конце — нет)
      stream.setAttribute('y2', String(BOT - (BOT - MID) * p));
      stream.setAttribute('opacity', p > 0 && p < 1 ? '1' : '0');
      body.setAttribute('transform', `rotate(${angle} 100 100)`);
    };

    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      draw(0.4, 0);
    } else {
      const tick = () => {
        const t = Date.now() % (FLOW + FLIP);
        if (t < FLOW) {
          draw(t / FLOW, 0);
        } else {
          // переворот: ease-in-out, песок уже внизу (p=1); после 180° кадр = «всё сверху»
          const k = (t - FLOW) / FLIP;
          const e = k < 0.5 ? 2 * k * k : 1 - Math.pow(-2 * k + 2, 2) / 2;
          draw(1, 180 * e);
        }
        // «бегущая» струйка: штрихи едут вниз (отрицательный dashoffset двигает узор по направлению линии)
        stream.setAttribute('stroke-dashoffset', String(-((Date.now() / 60) % 5)));
      };
      tick();
      setInterval(tick, 80);
    }
  }
</script>
