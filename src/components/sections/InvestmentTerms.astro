---
/*
  УРОВЕНЬ 3 — БЛОК «Условия участия» (Инвестиции для тех, кто ценит время)
  Источник: Figma, узел 974:65641 — своя разметка (не через SectionHeading):
  заголовок здесь ПРАВОВЫРОВНЕННЫЙ и двухстрочный с переносом ВНУТРИ строки
  (золотая строка на отдельной строке, не инлайн-акцент после текста), под
  паттерн SectionHeading (title+inline accent, left/center) не подходит.
  На мобильном выравнивание вправо снимается (сплошной текст вправо на узком
  экране читается плохо) — только md: и шире.

  Структура: eyebrow (текст + декоративная линия после) → H2 (бело/золото) →
  подзаголовок → хайрлайн → два списка «Подходит/Не подходит, если» с
  вертикальным разделителем между колонками на md+ → хайрлайн → футер
  (мета-текст условий + CTA-кнопка).

  Плейсхолдеры "00 лет"/"раз в 00 месяцев" — так в Figma (значения ещё не
  согласованы с клиентом), оставлены как есть, а не выдуманы.
*/
const fitsIf = [
  'свободные 200 000 ₽ и больше, которые не понадобятся 00 лет',
  'нужен конкретный адрес и конкретный арендатор, а не пай в фонде',
  'готовы прочитать договор и отчёт оценщика до перевода денег',
  'доход от аренды важнее прибыли на перепродаже',
];

const doesNotFitIf = [
  'деньги могут понадобиться раньше срока',
  'нужен гарантированный результат',
  'это последние сбережения или заёмные деньги',
  'хотите сами принимать решения по объекту',
];
---

<section id="terms" class="py-20 md:py-28">
  <div class="container-page">
    <!-- Заголовок секции: вправо на md+, влево на мобильном -->
    <div class="flex flex-col items-start gap-3 text-left md:items-end md:text-right">
      <div class="flex items-center gap-2.5">
        <span class="terms-gold font-accent text-sm uppercase tracking-[0.12em]">условия участия</span>
        <span class="hidden h-px w-5 md:block" style="background-image: var(--gradient-gold);"></span>
      </div>
      <h2 class="font-accent text-4xl leading-[1.1] tracking-[-0.01em] sm:text-5xl md:text-[50px]">
        <span class="block text-fg">Инвестиции для тех,</span>
        <span class="terms-gold block">кто ценит время</span>
      </h2>
      <p class="max-w-2xl text-lg text-fg md:ml-auto">
        Берём на себя все задачи по управлению объектом, чтобы вы могли сосредоточиться на развитии капитала.
      </p>
    </div>

    <!-- Блок условий -->
    <div class="mt-10 flex flex-col gap-8 md:mt-16">
      <div class="h-px w-full" style="background-image: var(--gradient-gold);"></div>

      <div class="grid gap-10 md:grid-cols-[1fr_auto_1fr] md:gap-0">
        <div class="flex flex-col gap-6 md:pr-10">
          <p class="font-accent text-2xl text-fg">Подходит, если</p>
          <ul class="flex flex-col gap-[18px]">
            {fitsIf.map((text) => (
              <li class="flex items-center gap-4">
                <span class="h-px w-5 shrink-0" style="background-image: var(--gradient-gold);"></span>
                <span class="font-accent text-lg leading-[1.55] text-fg">{text}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="hidden md:block md:w-px md:self-stretch md:justify-self-center" style="background-image: var(--gradient-gold);"></div>

        <div class="flex flex-col gap-6 md:pl-10">
          <p class="font-accent text-2xl text-fg">Не подходит, если</p>
          <ul class="flex flex-col gap-[18px]">
            {doesNotFitIf.map((text) => (
              <li class="flex items-center gap-4">
                <span class="h-px w-5 shrink-0" style="background-image: var(--gradient-gold);"></span>
                <span class="font-accent text-lg leading-[1.55] text-fg">{text}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      <div class="h-px w-full" style="background-image: var(--gradient-gold);"></div>

      <div class="flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
        <p class="terms-gold max-w-3xl font-accent text-base leading-relaxed">
          Горизонт участия — 2–10 лет · Выплаты арендного дохода — раз в 00 месяцев · Что оформляется на инвестора — доля собственности
        </p>
        <a href="#cta" class="btn-hero btn-outline w-full justify-center text-center md:w-auto">
          <span class="text-gold-plate">Разобрать условия по объекту →</span>
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .terms-gold {
    background-image: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
</style>
