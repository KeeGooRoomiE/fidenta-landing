---
import SectionHeading from '../ui/SectionHeading.astro';
import Section from '../ui/Section.astro';
import ObjectCard from '../ui/ObjectCard.astro';

const base = import.meta.env.BASE_URL;
const photo = (name: string) => `${base}images/objects/${name}.jpg`;
const exterior = (album: number, ...frames: number[]) =>
  frames.map((frame) => photo(`exterior-${album}-${frame}`));
const cover = (object: number) => `${base}images/objects/obj${object}-1.webp`;

const objects = [
  {
    id: 'bogatyrsky', type: 'Редевелопмент', title: 'Автомобильный комплекс', storyTitle: 'Объект на Богатырском',
    photos: [cover(3)],
    lead: 'Здание требовало реконструкции. Обновили помещения и территорию, нашли арендаторов — сегодня здесь работает автоцентр.',
    facts: ['С 2022 года', 'Автоцентр', 'Полная'],
    story: [
      { title: 'Исходная точка', text: 'Здание требовало реконструкции, помещения и территория — обновления.' },
      { title: 'Что изменилось', text: 'Реконструировали здание, обновили помещения и территорию, нашли арендаторов.' },
      { title: 'Результат', text: 'Уже в 2022 году\nВсе помещения сданы в аренду' },
    ],
  },
  {
    id: 'park-five', type: 'Строительство', title: 'Автосервис «ПАРК 5»', photos: [cover(1)],
    lead: 'Автосервис построен с нуля в 2022 году. Отдельный объект для обслуживания автомобилей.',
    facts: ['С 2022 года', 'Автосервис', 'Полная'],
    story: [
      { title: 'Исходная точка', text: 'Создание нового объекта под автосервис.' },
      { title: 'Что изменилось', text: 'Построили здание с нуля.' },
      { title: 'Результат', text: 'В 2022 году\nЗавершено строительство' },
    ],
  },
  {
    id: 'wash', type: 'Субаренда', title: 'Автомойка', photos: exterior(3, 3),
    lead: 'Автомойка и детейлинг на одной площадке. Объект работает в формате субаренды с 2024 года.',
    facts: ['С 2024 года', 'Автомойка', '3 помещения — 100% на площадке'],
    story: [
      { title: 'Исходная точка', text: 'Площадка для автомойки и детейлинга.' },
      { title: 'Что изменилось', text: 'Взяли объект в субаренду.' },
      { title: 'Результат', text: 'С 2024 года\nРабота в формате субаренды' },
    ],
  },
  {
    id: 'warehouse', type: 'Склад', title: 'Помещение под склад', photos: [photo('disk-6-5')],
    lead: '450 м² складских помещений, сданных в аренду «Яндексу».',
    facts: ['С 2024 года', 'Склад', 'Полная'],
    story: [
      { title: 'Исходная точка', text: 'Коммерческое помещение площадью 450 м².' },
      { title: 'Что изменилось', text: 'Нашли арендатора для складского использования.' },
      { title: 'Результат', text: 'Сдано в аренду\nАрендатор — Яндекс' },
    ],
  },
  {
    id: 'containers', type: 'Контейнеры', title: 'Контейнерная площадка', photos: [cover(5), ...exterior(2, 7)],
    lead: 'Пустой участок получил новое назначение: площадка для складских контейнеров. Найдены арендаторы.',
    facts: ['С 2022 года', 'Хранение', '—'],
    story: [
      { title: 'Исходная точка', text: 'Пустой земельный участок. Земля не предназначена для строительства' },
      { title: 'Что изменилось', text: 'Закуплены контейнеры под склад временного хранения' },
      { title: 'Результат', text: 'Новое назначение\nДополнительные складские мощности и доход для объекта' },
    ],
  },
  {
    id: 'sewing', type: 'Производство', title: 'Швейный цех', photos: [cover(6), photo('production-4'), ...exterior(5, 2)],
    lead: 'Производственный объект на арендованном участке. Швейный цех построен и запущен в 2019 году.',
    facts: ['С 2019 года', 'Швейный цех', '3 помещения — 100%'],
    story: [
      { title: 'Исходная точка', text: 'Арендованный земельный участок — пустая площадка' },
      { title: 'Что изменилось', text: 'Построили и запустили швейный цех. Произведен ремонт, поиск арендаторов' },
      { title: 'Результат', text: 'В 2019 году\n3 помещения с 2019 года сданы в аренду на постоянной основе' },
    ],
  },
  {
    id: 'detailing', type: 'Субаренда', title: 'Детейлинг-студия', photos: [photo('detailing-facade')],
    lead: 'Отдельное помещение для детейлинга на одной площадке с автомойкой.',
    facts: ['С 2024 года', 'Детейлинг', '—'],
    story: [{ title: 'Площадка', text: 'Детейлинг занимает отдельное помещение по соседству с моечными постами.' }],
  },
  {
    id: 'kudrovo-service', type: 'Автосервис', title: 'Автосервис в Кудрово', photos: [photo('disk-1-0'), ...exterior(1, 25)],
    lead: 'Помещение с ремонтными постами для обслуживания автомобилей.',
    facts: ['—', 'Автосервис', '—'],
    story: [{ title: 'Назначение', text: 'На площадке работает сервис по ремонту и техническому обслуживанию автомобилей.' }],
  },
  {
    id: 'cnc', type: 'Производство', title: 'ЧПУ-мастерская в Кудрово', photos: [photo('production-3'), ...exterior(5, 7)],
    lead: 'Мастерская со станками с ЧПУ расположена в сером здании между двумя корпусами швейного цеха.',
    facts: ['—', 'ЧПУ-мастерская', '—'],
    story: [{ title: 'Площадка', text: 'Среднее здание производственной площадки в Кудрово занимает ЧПУ-мастерская. В двух соседних зданиях работает швейный цех.' }],
  },
  {
    id: 'autograd', type: 'Автосервис', title: 'Автосервис «Ауто Град»', photos: [photo('autograd-facade'), ...exterior(4, 6)],
    lead: 'Отдельный автосервис с малярно-кузовным центром.',
    facts: ['—', 'Кузовной ремонт', '—'],
    story: [{ title: 'Назначение', text: 'В здании работают посты диагностики, обслуживания и кузовного ремонта автомобилей.' }],
  },
];
---

<Section id="portfolio">
  <SectionHeading eyebrow="Объекты">
    Как работает недвижимость <span class="text-gold-plate">под нашим управлением</span>
    <Fragment slot="lead">
      Автосервис на Васильевском острове, швейный цех и ЧПУ-мастерская в Кудрово, современный склад. Что делает помещение подходящим для одного бизнеса и неудобным для другого?
      <span class="mt-3 block portfolio-details" id="portfolio-details">Для автосервиса важны удобный заезд с улицы и автомобильный трафик, для производства — запас электрической мощности, для склада — площадь и расположение. Такие детали мы учитываем, когда подбираем арендаторов и обсуждаем с собственником стратегию развития объекта.</span>
    </Fragment>
  </SectionHeading>
  <button class="portfolio-read" type="button" data-portfolio-read aria-expanded="false" aria-controls="portfolio-details">
    <span class="text-gold-plate">читать далее</span>
  </button>

  <div class="object-grid mt-8 grid gap-5 lg:mt-12 lg:grid-cols-3 lg:gap-8">
    {objects.slice(0, 6).map((object) => <ObjectCard {...object} />)}
  </div>

  <div class="mt-8 flex justify-center" data-portfolio-more>
    <button class="min-h-12 rounded-md border border-cream/40 px-6 font-accent text-lg text-cream hover:bg-cream/10" type="button" aria-controls="portfolio-more" aria-expanded="false">Показать ещё объекты</button>
  </div>

  <div class="mt-8" id="portfolio-more" hidden>
    <div class="mb-4 flex items-center justify-between gap-4">
      <h3 class="text-2xl leading-tight text-fg" tabindex="-1">Другие объекты</h3>
      <div class="flex shrink-0 gap-2">
        <button class="slider-arrow" type="button" data-track-step="-1" aria-label="Предыдущий объект">←</button>
        <button class="slider-arrow" type="button" data-track-step="1" aria-label="Следующий объект">→</button>
      </div>
    </div>
    <div class="object-track" data-object-track>
      {objects.slice(2).map((object, index) => (
        <ObjectCard {...object} id={`${object.id}-slider`} class={index < 4 ? 'track-mobile' : undefined} />
      ))}
      <article class="project-card relative isolate flex min-h-[480px] flex-col items-start justify-end gap-3 overflow-hidden rounded-[9px] border border-cream/60 p-6 font-accent sm:p-7">
        {/* Azamat Hatypov, Pexels: https://www.pexels.com/photo/26711212/ */}
        <img class="project-photo" src={`${base}images/project-redevelopment.jpg`} alt="" width="900" height="810" loading="lazy" decoding="async" />
        <p class="text-gold-plate text-base leading-tight tracking-[0.04em] uppercase">Следующая история</p>
        <h4 class="project-title leading-[1.05] text-fg">
          <span class="block">Здесь может начаться</span>
          <span class="text-gold-plate">ваш проект</span>
        </h4>
        <p class="max-w-[29ch] text-lg leading-snug text-fg">Хотите вложиться в коммерческую недвижимость или предложить свой объект? Обсудим вашу задачу.</p>
        <a href="#cta" class="mt-2 inline-flex min-h-11 items-center gap-2 border-t border-cream/30 pt-2 text-xl hover:underline"><span class="text-gold-plate">Обсудить проект <span aria-hidden="true">→</span></span></a>
      </article>
    </div>
    <input class="object-position" type="range" min="0" max="1" value="0" aria-label="Позиция в галерее объектов" data-track-position />
  </div>
</Section>

<script>
  import { initPortfolio } from '../../scripts/portfolio';

  const portfolio = document.getElementById('portfolio');
  if (portfolio) initPortfolio(portfolio);
</script>

<style>
  .object-grid > :global(article:nth-child(n + 3)) {
    display: none;
  }

  .object-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .object-track::-webkit-scrollbar {
    display: none;
  }

  .object-position {
    --position-track: linear-gradient(176deg, rgb(255 241 217 / 50%) 25.714%, rgb(168 133 72 / 50%) 120.56%);
    display: block;
    width: 100%;
    height: 32px;
    margin-top: 6px;
    appearance: none;
    background: var(--position-track) center / 100% 2px no-repeat;
    cursor: ew-resize;
  }

  .object-position::-webkit-slider-runnable-track {
    height: 2px;
    background: transparent;
  }

  .object-position::-moz-range-track {
    height: 2px;
    background: transparent;
  }

  .object-position::-webkit-slider-thumb {
    appearance: none;
    width: 28px;
    height: 6px;
    margin-top: -2px;
    border-radius: 3px;
    background: var(--gradient-gold);
  }

  .object-position::-moz-range-thumb {
    width: 28px;
    height: 6px;
    border: 0;
    border-radius: 3px;
    background: var(--gradient-gold);
  }

  .portfolio-read {
    display: none;
  }

  @media (width < 1024px) {
    [data-portfolio-ready] .portfolio-read {
      display: inline-flex;
      min-height: 36px;
      align-items: center;
      gap: 8px;
      padding-right: 8px;
      color: #d9bc83;
      font-family: var(--font-accent);
      cursor: pointer;
    }

    [data-portfolio-ready]:not([data-portfolio-expanded]) .portfolio-details {
      display: none;
    }

    .portfolio-read::after {
      width: 7px;
      height: 7px;
      border: solid currentColor;
      border-width: 0 1px 1px 0;
      transform: translateY(-2px) rotate(45deg);
      content: '';
    }

    .portfolio-read[aria-expanded='true']::after {
      transform: translateY(2px) rotate(225deg);
    }

    .portfolio-read:is(:hover, :focus-visible) span {
      text-decoration: underline #b9a274;
      text-underline-offset: 3px;
    }

    .portfolio-details {
      scroll-margin-top: 98px;
    }
  }

  .object-track > :global(article) {
    scroll-snap-align: start;
  }

  @media (min-width: 1024px) {
    .object-track > :global(.track-mobile) {
      display: none;
    }

    .object-grid > :global(article:nth-child(n + 3)) {
      display: flex;
    }

    .object-track {
      gap: 32px;
      grid-auto-columns: calc((100% - 64px) / 3);
    }
  }

  .slider-arrow {
    position: relative;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    color: #fff1d9;
    cursor: pointer;
  }

  .slider-arrow::before {
    position: absolute;
    inset: 0;
    padding: 0.7px;
    border-radius: inherit;
    background: var(--gradient-gold);
    opacity: 0.5;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    content: '';
  }

  .slider-arrow:disabled {
    color: rgb(255 241 217 / 40%);
    cursor: default;
  }

  .slider-arrow:hover:not(:disabled) {
    background: rgb(255 241 217 / 10%);
  }

  .project-card {
    container-type: inline-size;
    background: radial-gradient(ellipse at 82% 9%, #173d53, transparent 70%), #091c17;
  }

  .project-title {
    font-size: clamp(20px, 10.5cqi, 40px);
  }

  .project-photo,
  .project-card::before {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .project-photo {
    z-index: -2;
    height: 62%;
    object-fit: cover;
    object-position: center top;
  }

  .project-card::before {
    z-index: -1;
    background: linear-gradient(180deg, rgb(7 21 52 / 12%), rgb(9 28 23 / 32%) 29%, #091c17 66%);
    content: '';
  }
</style>
