---
import SectionHeading from '../ui/SectionHeading.astro';
import Section from '../ui/Section.astro';
import ObjectCard from '../ui/ObjectCard.astro';

const base = import.meta.env.BASE_URL;
const photo = (name: string) => `${base}images/objects/${name}.jpg`;
const exterior = (album: number, ...frames: number[]) =>
  frames.map((frame) => photo(`exterior-${album}-${frame}`));
const cover = (object: number) => `${base}images/objects/obj${object}-1.webp`;

const objects = [
  {
    id: 'bogatyrsky', type: 'Редевелопмент', title: 'Автомобильный комплекс', photos: [cover(3), ...exterior(2, 10, 12)],
    lead: 'На Богатырском проспекте реконструировали здание и нашли арендаторов для автоцентра.',
    facts: [{ label: 'В управлении', value: 'С 2022 года' }, { label: 'Заполняемость', value: 'Все помещения сданы' }],
    story: [
      { title: 'Исходная точка', text: 'Здание требовало реконструкции, помещения и территория — обновления.' },
      { title: 'Что изменилось', text: 'Реконструировали здание, обновили помещения и территорию, нашли арендаторов.' },
      { title: 'Результат', text: 'Все помещения сданы в аренду.' },
    ],
  },
  {
    id: 'park-five', type: 'Строительство', title: 'Автосервис «ПАРК 5»', photos: [cover(1), ...exterior(7, 0, 5)],
    lead: 'Отдельный объект для обслуживания автомобилей, построенный с нуля в 2022 году.',
    facts: [{ label: 'Построен', value: 'В 2022 году' }, { label: 'Заполняемость', value: 'Полная' }],
    story: [
      { title: 'Что изменилось', text: 'Построили здание с отдельными ремонтными постами.' },
      { title: 'Результат', text: 'На площадке работает автосервис с постом развала-схождения.' },
    ],
  },
  {
    id: 'wash', type: 'Субаренда', title: 'Автомойка', photos: [photo('disk-3-0'), ...exterior(3, 2, 3)],
    lead: 'Помещение под автомойку на общей площадке с детейлингом.',
    facts: [{ label: 'Формат', value: 'Субаренда' }],
    story: [{ title: 'Площадка', text: 'Моечные посты расположены рядом с детейлинг-студией. Площадка работает в формате субаренды с 2024 года.' }],
  },
  {
    id: 'warehouse', type: 'Склад', title: 'Помещение под склад', photos: [photo('disk-6-5'), ...exterior(6, 19, 20)],
    lead: '450 м² складских помещений, сданных в аренду «Яндексу».',
    facts: [{ label: 'Площадь', value: '450 м²' }, { label: 'В управлении', value: 'С 2024 года' }],
    story: [{ title: 'Результат', text: 'Складское помещение полностью сдано в аренду.' }],
  },
  {
    id: 'containers', type: 'Контейнеры', title: 'Контейнерная площадка', photos: [cover(5), ...exterior(2, 4, 7, 9)],
    lead: 'Пустой участок переоборудовали в площадку для складских контейнеров.',
    facts: [{ label: 'В управлении', value: 'С 2022 года' }],
    story: [
      { title: 'Исходная точка', text: 'Участок пустовал.' },
      { title: 'Результат', text: 'Организовали контейнерное хранение и нашли арендаторов.' },
    ],
  },
  {
    id: 'sewing', type: 'Производство', title: 'Швейный цех в Кудрово', photos: [cover(6), photo('production-4'), ...exterior(5, 2)],
    lead: 'Производственный объект на арендованном участке.',
    facts: [{ label: 'Цех запущен', value: 'В 2019 году' }],
    story: [{ title: 'Результат', text: 'Швейный цех построили и запустили в 2019 году.' }],
  },
  {
    id: 'detailing', type: 'Субаренда', title: 'Детейлинг-студия', photos: [photo('detailing-facade'), ...exterior(4, 0, 2)],
    lead: 'Отдельное помещение для детейлинга на одной площадке с автомойкой.',
    facts: [{ label: 'Формат', value: 'Субаренда' }],
    story: [{ title: 'Площадка', text: 'Детейлинг занимает отдельное помещение по соседству с моечными постами.' }],
  },
  {
    id: 'kudrovo-service', type: 'Автосервис', title: 'Автосервис в Кудрово', photos: [photo('disk-1-0'), photo('exterior-kudrovo-side'), ...exterior(1, 25)],
    lead: 'Помещение с ремонтными постами для обслуживания автомобилей.',
    story: [{ title: 'Назначение', text: 'На площадке работает сервис по ремонту и техническому обслуживанию автомобилей.' }],
  },
  {
    id: 'cnc', type: 'Производство', title: 'ЧПУ-мастерская в Кудрово', photos: [photo('production-3'), ...exterior(5, 7, 8)],
    lead: 'Мастерская со станками с ЧПУ расположена в сером здании между двумя корпусами швейного цеха.',
    story: [{ title: 'Площадка', text: 'Среднее здание производственной площадки в Кудрово занимает ЧПУ-мастерская. В двух соседних зданиях работает швейный цех.' }],
  },
  {
    id: 'autograd', type: 'Автосервис', title: 'Автосервис «Ауто Град»', photos: [photo('autograd-facade'), ...exterior(4, 6, 1)],
    lead: 'Отдельный автосервис с малярно-кузовным центром.',
    story: [{ title: 'Назначение', text: 'В здании работают посты диагностики, обслуживания и кузовного ремонта автомобилей.' }],
  },
];
---

<Section id="portfolio">
  <SectionHeading eyebrow="Объекты">
    Как работает недвижимость <span class="text-gold-plate">под нашим управлением</span>
    <Fragment slot="lead">
      Автосервис на Васильевском острове, швейный цех и ЧПУ-мастерская в Кудрово, современный склад. Что делает помещение подходящим для одного бизнеса и неудобным для другого?
      <span class="mt-3 block">Для автосервиса важны удобный заезд с улицы и автомобильный трафик, для производства — запас электрической мощности, для склада — площадь и расположение. Такие детали мы учитываем, когда подбираем арендаторов и обсуждаем с собственником стратегию развития объекта.</span>
    </Fragment>
  </SectionHeading>

  <div class="object-grid mt-8 grid gap-5 lg:mt-12 lg:grid-cols-3 lg:gap-8">
    {objects.slice(0, 6).map((object) => <ObjectCard {...object} />)}
  </div>

  <div class="mt-8 flex justify-center" data-portfolio-more>
    <button class="min-h-12 rounded-md border border-cream/40 px-6 font-accent text-lg text-cream hover:bg-cream/10" type="button" aria-controls="portfolio-more" aria-expanded="false">Показать ещё объекты</button>
  </div>

  <div class="mt-8" id="portfolio-more" hidden>
    <div class="mb-4 flex items-center justify-between gap-4">
      <h3 class="text-2xl text-fg" tabindex="-1">Другие объекты Фиденты</h3>
      <div class="flex shrink-0 gap-2">
        <button class="slider-arrow" type="button" data-track-step="-1" aria-label="Предыдущий объект">←</button>
        <button class="slider-arrow" type="button" data-track-step="1" aria-label="Следующий объект">→</button>
      </div>
    </div>
    <div class="object-track" data-object-track>
      {objects.slice(2).map((object, index) => (
        <ObjectCard {...object} id={`${object.id}-slider`} class={index < 4 ? 'track-mobile' : undefined} />
      ))}
      <article class="project-card relative flex min-h-80 flex-col items-start justify-center gap-5 overflow-hidden rounded-[9px] border border-cream/50 p-6 font-accent sm:p-8">
        <h4 class="text-gold-plate text-3xl">Ваш проект</h4>
        <p class="max-w-[26ch] text-lg text-fg">Расскажите о вашем объекте. Обсудим его потенциал и стратегию развития.</p>
        <a href="#contacts" class="rounded-md border border-cream/50 px-5 py-3 text-cream hover:bg-cream/10">Обсудить объект</a>
      </article>
    </div>
  </div>
</Section>

<script>
  import { initPortfolio } from '../../scripts/portfolio';

  const portfolio = document.getElementById('portfolio');
  if (portfolio) initPortfolio(portfolio);
</script>

<style>
  .object-grid > :global(article:nth-child(n + 3)) {
    display: none;
  }

  .object-track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    padding-bottom: 8px;
  }

  .object-track > :global(article) {
    scroll-snap-align: start;
  }

  @media (min-width: 1024px) {
    .object-track > :global(.track-mobile) {
      display: none;
    }

    .object-grid > :global(article:nth-child(n + 3)) {
      display: flex;
    }

    .object-track {
      gap: 32px;
      grid-auto-columns: calc((100% - 64px) / 3);
    }
  }

  .slider-arrow {
    width: 44px;
    height: 44px;
    border: 1px solid rgb(255 241 217 / 35%);
    border-radius: 6px;
    color: #fff1d9;
    cursor: pointer;
  }

  .slider-arrow:disabled {
    opacity: 0.4;
    cursor: default;
  }

  .slider-arrow:hover:not(:disabled) {
    background: rgb(255 241 217 / 10%);
  }

  .project-card {
    background: radial-gradient(ellipse at 100% 0%, #15364a, transparent 70%), #091c17;
  }
</style>
