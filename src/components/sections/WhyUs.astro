---
/*
  УРОВЕНЬ 3 — БЛОК WhyUs («Почему выбирают Фидента»)

  Две части в одной секции:
   1. Ряд ключевых показателей (StatBlock) — в рамке-панели.
   2. Сетка направлений работы 01–06 (ServiceCard).

  id="why" — якорь для ссылки «О компании» из шапки.
*/
import SectionHeading from '../ui/SectionHeading.astro';
import StatBlock from '../ui/StatBlock.astro';
import ServiceCard from '../ui/ServiceCard.astro';

const stats = [
  { value: '12', label: 'Лет на рынке управления', text: 'С 2013 года обслуживаем объекты Санкт-Петербурга. Накопленная экспертиза позволяет предвидеть риски и решать нестандартные задачи без участия собственника.' },
  { value: '47', suffix: '+', label: 'Объектов под управлением', text: 'Диверсифицированный портфель: офисы, ритейл, склады, апартаменты. Опыт в разных сегментах позволяет применять лучшие практики каждого из них.' },
  { value: '98', suffix: '%', label: 'Средняя заполняемость', text: 'Проактивный поиск арендаторов, конкурентный анализ ставок и быстрая ротация при смене арендатора обеспечивают минимальный простой площадей.' },
  { value: '24/7', label: 'Аварийная служба', text: 'Собственная диспетчерская и бригада аварийного реагирования. Среднее время прибытия — 40 минут в пределах КАД.' },
  { value: '0', label: 'Скрытых платежей', text: 'Прозрачная структура вознаграждения: фиксированная часть + процент от арендного дохода. Полная расшифровка в ежемесячном отчёте.' },
  { value: '1', label: 'Персональный менеджер', text: 'Каждый собственник работает с выделенным менеджером. Один контакт — ответственность за весь объект и полная осведомлённость о каждой детали.' },
];

const services = [
  { number: '01', title: 'Арендные отношения', text: 'Поиск надёжных арендаторов, юридическое оформление договоров, контроль расчётов и своевременное пополнение вакансий. Минимальный простой — максимальный доход.' },
  { number: '02', title: 'Техническая эксплуатация', text: 'Плановое и аварийное техобслуживание, регламентные работы по инженерным системам, надзор за подрядчиками, ведение технической документации.' },
  { number: '03', title: 'Юридическое сопровождение', text: 'Договорная работа, взаимодействие с контролирующими органами, защита интересов собственника, урегулирование споров и работа с дебиторской задолженностью.' },
  { number: '04', title: 'Финансовое управление', text: 'Бюджетирование, ведение реестра платежей, регулярная отчётность для собственника. Прозрачный учёт каждого рубля: от коммунальных платежей до арендных поступлений.' },
  { number: '05', title: 'Клининг и благоустройство', text: 'Профессиональная уборка общих зон и территории, контроль подрядчика, ведение графика работ. Объект всегда в представительном состоянии.' },
  { number: '06', title: 'Консалтинг и оценка', text: 'Аудит объекта, анализ доходности, рекомендации по повышению ликвидности и капитализации, подготовка к продаже или реструктуризация активов.' },
];
---

<section id="why" class="bg-panel py-20 md:py-28">
  <div class="container-page">
    <SectionHeading eyebrow="О компании" title="Почему выбирают" accent="Фидента" />

    <!-- Панель с ключевыми показателями -->
    <div class="mt-12 grid gap-x-10 gap-y-10 rounded-2xl border border-border bg-surface/50 p-8 sm:grid-cols-2 lg:grid-cols-3 md:p-10">
      {stats.map((stat) => (
        <StatBlock value={stat.value} suffix={stat.suffix} label={stat.label} text={stat.text} />
      ))}
    </div>

    <!-- Направления работы 01–06 -->
    <div class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {services.map((service) => (
        <ServiceCard number={service.number} title={service.title} text={service.text} />
      ))}
    </div>
  </div>
</section>
