---
/*
  УРОВЕНЬ 3 — БЛОК «Заявка» (CTA-форма с переключателем «Я инвестор / Я собственник»)
  Источник: Figma, узел 974:64820 («block 13 Zayavka»)

  Слева — призыв и «Что будет дальше», справа — переключатель аудитории и форма.

  ПЕРЕКЛЮЧАТЕЛЬ: сейчас меняет ТОЛЬКО ТЕКСТЫ блока (словарь copy ниже, ключи
  investor / owner). Позже тот же выбор будет определять целевую почту
  отправки (см. TODO(CTA) в скрипте внизу): аудитория уходит в форму скрытым
  полем audience, на стороне отправки по ней выбирается получатель.

  ⚠️ В Figma нарисован только вариант «инвестор». Тексты варианта «собственник»
  (copy.owner) — ЧЕРНОВИК по смыслу сайта (баннер «Передайте недвижимость под
  управление», блок «Полный спектр»), НЕ из макета: показать клиенту / получить
  от дизайнера второй вариант.

  Поля формы: name / phone / client_email / message — совпадают с inputs
  воркфлоу cta-email.yml и переменными scripts/send_cta.py
  (FORM_NAME, FORM_PHONE, FORM_CLIENT_EMAIL, FORM_MESSAGE).

  Состояние кнопки-переключателя: активная — золотая заливка (btn-plat),
  неактивная — только кремовая рамка (btn-outline) с золотым текстом.

  id="cta" — якорь для кнопок «Консультация» / «Передать объект…» и ссылки «Контакты».
*/
const copy = {
  investor: {
    eyebrow: 'заявка инвестора',
    title: 'Покажем объекты, открытые для входа, подберем решение',
    lead: 'Оставьте заявку — пришлём карточку объекта: адрес, арендатор, срок договора и порядок выхода.',
    steps: [
      'Свяжемся в течение одного рабочего дня',
      'Пришлём карточку объекта с адресом и арендатором',
      'Съездим на объект вместе, если захотите',
    ],
    formTitle: 'Заявка инвестора',
    placeholder: 'Например, интересуют склады в Ленобласти',
    submit: 'Получить карточку объекта',
  },
  // ЧЕРНОВИК — см. примечание в шапке файла
  owner: {
    eyebrow: 'заявка собственника',
    title: 'Передайте объект под управление — расскажем, как повысить доход',
    lead: 'Оставьте заявку — оценим объект и предложим схему управления: от эксплуатации до роста стоимости актива.',
    steps: [
      'Свяжемся в течение одного рабочего дня',
      'Запросим данные по объекту и оценим его потенциал',
      'Приедем на объект и предложим условия управления',
    ],
    formTitle: 'Заявка собственника',
    placeholder: 'Например, офисное здание, 3 000 м², Санкт-Петербург',
    submit: 'Передать объект под управление',
  },
};
// Поле-подпись «Комментарий» одинаково для обоих вариантов (в Figma — «Комментарий / интересующий формат участия»)
---

<section id="cta" class="py-20 md:py-28" data-cta data-copy={JSON.stringify(copy)}>
  <div class="container-page grid gap-12 lg:grid-cols-[minmax(0,1fr)_560px] lg:gap-12">
    <!-- Левая колонка: призыв (тексты подменяются скриптом по data-copy) -->
    <div class="flex flex-col gap-[15px] font-accent">
      <div class="flex items-center gap-2.5">
        <span class="h-px w-5 shrink-0" style="background-image: var(--gradient-gold);"></span>
        <span data-t="eyebrow" class="font-body text-xl font-medium uppercase tracking-[0.1em] text-gold-plate">
          {copy.investor.eyebrow}
        </span>
      </div>
      <h2
        data-t="title"
        class="max-w-[437px] font-accent text-4xl font-normal leading-[1.1] tracking-[-0.03em] text-white sm:text-5xl md:text-[50px]"
      >
        {copy.investor.title}
      </h2>
      <p data-t="lead" class="max-w-[428px] text-xl leading-[1.43] text-fg">{copy.investor.lead}</p>
      <p class="text-xl text-white">Что будет дальше?</p>
      <ul class="list-disc ps-[30px] text-xl leading-5 text-white [&>li+li]:mt-0">
        {copy.investor.steps.map((s, i) => <li data-step={i}>{s}</li>)}
      </ul>
    </div>

    <!-- Правая колонка: переключатель + форма -->
    <div class="flex flex-col gap-4 font-accent lg:pt-0">
      <div class="flex gap-5" role="group" aria-label="Тип заявки">
        <button type="button" data-audience="investor" aria-pressed="true" class="aud-btn">Я инвестор</button>
        <button type="button" data-audience="owner" aria-pressed="false" class="aud-btn">Я собственник</button>
      </div>

      <h3 data-t="formTitle" class="mt-3 font-accent text-4xl font-normal leading-[1.1] text-fg">
        {copy.investor.formTitle}
      </h3>
      <p class="text-xl leading-[1.12] text-fg">Ответим в течение одного рабочего дня.</p>

      <form id="cta-form" class="flex flex-col gap-4" novalidate>
        <!-- Аудитория уходит в отправку скрытым полем (TODO(CTA): по ней выбрать получателя) -->
        <input type="hidden" name="audience" value="investor" />

        <div class="grid gap-4 sm:grid-cols-2">
          <label class="flex flex-col gap-2 text-xl tracking-[0.013em] text-fg">
            Имя
            <input name="name" required autocomplete="name" placeholder="Александр" class="cta-input" />
          </label>
          <label class="flex flex-col gap-2 text-xl tracking-[0.013em] text-fg">
            Телефон
            <input name="phone" type="tel" required autocomplete="tel" placeholder="+7 (812) ..." class="cta-input" />
          </label>
        </div>

        <label class="flex flex-col gap-2 text-xl tracking-[0.013em] text-fg">
          E-mail
          <span class="relative block">
            <input name="client_email" type="email" autocomplete="email" placeholder="example@mail.ru" class="cta-input w-full !pr-[140px]" />
            <span class="pointer-events-none absolute right-[17px] top-1/2 hidden -translate-y-1/2 font-body text-base text-[rgba(244,241,234,0.5)] sm:block">не обязательно</span>
          </span>
        </label>

        <label class="flex flex-col gap-2 text-xl tracking-[0.013em] text-fg">
          Комментарий / интересующий формат участия
          <input name="message" data-t-placeholder="placeholder" placeholder={copy.investor.placeholder} class="cta-input" />
        </label>

        <!-- Согласие: ссылка #privacy — страница политики появится позже -->
        <label class="flex items-start gap-2.5 text-xl leading-[1.04] tracking-[0.013em] text-fg">
          <input type="checkbox" name="consent" required checked class="mt-0.5 size-[18px] shrink-0 accent-[#c29e4b]" />
          <span>
            Даю согласие на
            <a href="#privacy" class="text-[#c29e4b] underline">обработку персональных данных</a>
            в соответствии с политикой конфиденциальности
          </span>
        </label>

        <button
          type="submit"
          data-t="submit"
          class="btn-plat h-[52px] w-full rounded-[9px] border border-transparent px-[29px] font-accent text-xl tracking-[0.008em] transition-[filter] hover:brightness-110"
        >
          {copy.investor.submit}
        </button>

        <!-- Статус отправки -->
        <p id="cta-status" class="hidden font-accent text-base" role="status"></p>
      </form>

      <p class="mt-2 font-accent text-sm leading-5 text-[#bdaf92]">
        Не является публичной офертой. Условия конкретной сделки фиксируются в договоре.
      </p>
    </div>
  </div>
</section>

<script>
  type Audience = 'investor' | 'owner';
  const root = document.querySelector<HTMLElement>('[data-cta]');

  if (root) {
    const copy = JSON.parse(root.dataset.copy ?? '{}') as Record<Audience, Record<string, any>>;
    const form = root.querySelector<HTMLFormElement>('#cta-form')!;
    const hidden = form.elements.namedItem('audience') as HTMLInputElement;

    // --- Переключатель «инвестор / собственник»: меняем только тексты ---
    function setAudience(a: Audience) {
      const c = copy[a];
      hidden.value = a;
      root!.querySelectorAll<HTMLElement>('[data-t]').forEach((el) => (el.textContent = c[el.dataset.t!]));
      root!.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => (el.textContent = c.steps[Number(el.dataset.step)]));
      root!.querySelector<HTMLInputElement>('[data-t-placeholder]')!.placeholder = c.placeholder;
      root!.querySelectorAll<HTMLElement>('[data-audience]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.audience === a)),
      );
    }
    root.querySelectorAll<HTMLElement>('[data-audience]').forEach((b) =>
      b.addEventListener('click', () => setAudience(b.dataset.audience as Audience)),
    );

    // --- Отправка формы ---
    const status = root.querySelector<HTMLElement>('#cta-status')!;
    function show(text: string, ok: boolean) {
      status.textContent = text;
      status.classList.remove('hidden', 'text-accent', 'text-red-300');
      status.classList.add(ok ? 'text-accent' : 'text-red-300');
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (!String(data.get('name')).trim() || !String(data.get('phone')).trim()) {
        return show('Укажите имя и телефон.', false);
      }
      if (!(form.elements.namedItem('consent') as HTMLInputElement).checked) {
        return show('Нужно согласие на обработку персональных данных.', false);
      }

      // TODO(CTA): отправка заявки письмом — пока доступов нет, это заглушка.
      //   Что сделать, когда будут доступы:
      //   1) fetch POST на GitHub API → workflow_dispatch воркфлоу cta-email.yml
      //      (адрес и inputs описаны в шапке .github/workflows/cta-email.yml;
      //      токен НЕ хранить в клиентском коде — нужен прокси/serverless-эндпоинт);
      //   2) передать поля: name, phone, client_email, message (+ audience);
      //   3) целевая почта зависит от audience (investor / owner): завести словарь
      //      «аудитория → адрес» на стороне отправки (secrets), а не в браузере;
      //   4) показать успех/ошибку по ответу, очистить форму при успехе.
      console.info('[CTA] заявка (отправка не подключена):', Object.fromEntries(data));
      show('Форма собрана. Отправка письма будет подключена позже.', true);
    });
  }
</script>

<style is:global>
  /* Поле ввода по спеке Figma: фон #143a30, рамка #1c4a3d, radius 9, высота 52 */
  .cta-input {
    height: 52px;
    width: 100%;
    border-radius: 9px;
    border: 1px solid #1c4a3d;
    background: #143a30;
    padding: 0 17px;
    font-family: var(--font-body);
    font-size: 16px;
    color: #f4f1ea;
    outline: none;
    transition: border-color 0.15s;
  }
  .cta-input::placeholder {
    color: rgba(244, 241, 234, 0.5);
  }
  .cta-input:focus {
    border-color: #c7a24b;
  }
  /* Кнопки-переключатели аудитории: активная — золото, неактивная — рамка */
  .aud-btn {
    border: 1px solid #fff1d9;
    border-radius: 9px;
    padding: 9px 17px;
    font-family: var(--font-accent);
    font-size: 20px;
    line-height: 1.2;
    background-image: none;
    color: transparent;
    background-clip: text;
    -webkit-background-clip: text;
    background-image: var(--gradient-gold);
    transition: filter 0.15s;
  }
  .aud-btn[aria-pressed='true'] {
    background-clip: border-box;
    -webkit-background-clip: border-box;
    color: #0a2019;
  }
  .aud-btn:hover {
    filter: brightness(1.1);
  }
</style>
