---
/*
  УРОВЕНЬ 3 — БЛОК «Заявка» (CTA-форма с переключателем «Я инвестор / Я собственник»)
  Источник: Figma, узел 974:64820 («block 13 Zayavka»)

  Слева — призыв и «Что будет дальше», справа — переключатель аудитории и форма.

  ПЕРЕКЛЮЧАТЕЛЬ: сейчас меняет ТОЛЬКО ТЕКСТЫ блока (словарь copy ниже, ключи
  investor / owner). Позже тот же выбор будет определять целевую почту
  отправки (см. TODO(CTA) в скрипте внизу): аудитория уходит в форму скрытым
  полем audience, на стороне отправки по ней выбирается получатель.

  ⚠️ В Figma нарисован только вариант «инвестор». Тексты варианта «собственник»
  (copy.owner) — ЧЕРНОВИК по смыслу сайта (баннер «Передайте недвижимость под
  управление», блок «Полный спектр»), НЕ из макета: показать клиенту / получить
  от дизайнера второй вариант.

  Поля формы: name / phone / client_email / message — совпадают с inputs
  воркфлоу cta-email.yml и переменными scripts/send_cta.py
  (FORM_NAME, FORM_PHONE, FORM_CLIENT_EMAIL, FORM_MESSAGE).

  Состояние кнопки-переключателя: активная — золотая заливка (btn-plat),
  неактивная — только кремовая рамка (btn-outline) с золотым текстом.

  Кнопки в других блоках с атрибутом data-cta-audience="investor|owner" (Hero: «Доступ к сделкам» →
  инвестор, «Передать объект в управление» → собственник; баннер, «Крупный актив», «Условия участия»)
  при клике сами переключают форму на нужную аудиторию.

  id="cta" — якорь для кнопок «Консультация» / «Передать объект…» и ссылки «Контакты».
*/
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
const copy = {
  investor: {
    eyebrow: 'Обратная связь',
    title: 'Покажем объекты, открытые для входа',
    accent: 'и подберём решение',
    lead: 'Оставьте заявку — пришлём карточку объекта: адрес, арендатор, срок договора и порядок выхода.',
    steps: [
      'Свяжемся в течение одного рабочего дня',
      'Пришлём карточку объекта с адресом и арендатором',
      'Съездим на объект вместе, если захотите',
    ],
    formTitle: 'Заявка инвестора',
    placeholder: 'Несколько слов о вашем запросе',
    submit: 'Отправить обращение →',
  },
  // ЧЕРНОВИК — см. примечание в шапке файла
  owner: {
    eyebrow: 'Обратная связь',
    title: 'Передайте объект под управление',
    accent: 'и обсудим его потенциал',
    lead: 'Оставьте заявку — оценим объект и предложим схему управления: от эксплуатации до роста стоимости актива.',
    steps: [
      'Свяжемся в течение одного рабочего дня',
      'Запросим данные по объекту и оценим его потенциал',
      'Приедем на объект и предложим условия управления',
    ],
    formTitle: 'Заявка собственника',
    placeholder: 'Например, офисное здание, 3 000 м², Санкт-Петербург',
    submit: 'Отправить обращение →',
  },
};
// Поле-подпись «Комментарий» одинаково для обоих вариантов (в Figma — «Комментарий / интересующий формат участия»)
---

<Section id="cta" class="contact-form-section" data-cta data-copy={JSON.stringify(copy)}>
    <div class="cta-layout grid gap-6 border-t border-cream/25 pt-8 lg:grid-cols-[minmax(0,0.65fr)_minmax(0,1fr)] lg:gap-12 lg:pt-14">
    {/* Левая колонка: призыв (тексты подменяются скриптом по data-copy) */}
    <div class="cta-intro flex flex-col gap-3 font-accent lg:gap-[15px]">
      <div class="flex items-center gap-2.5">
        <span class="h-px w-5 shrink-0 bg-gold-line"></span>
        <span data-t="eyebrow" class="text-eyebrow text-gold-plate">
          {copy.investor.eyebrow}
        </span>
      </div>
      <h2
        class="max-w-[437px] text-h2 text-fg"
      >
        <span data-t="title">{copy.investor.title}</span><br />
        <span data-t="accent" class="text-gold-plate">{copy.investor.accent}</span>
      </h2>
      <p data-t="lead" class="max-w-[428px] text-lead text-copy">{copy.investor.lead}</p>
      <p class="cta-next text-base text-white md:text-xl">Что будет дальше?</p>
      <ul class="list-disc ps-6 text-base leading-snug text-copy md:ps-[30px] md:text-xl md:leading-5 [&>li+li]:mt-1 md:[&>li+li]:mt-0">
        {copy.investor.steps.map((s, i) => <li data-step={i}>{s}</li>)}
      </ul>
    </div>

    {/* Правая колонка: переключатель + форма */}
    <div class="cta-form-column flex min-w-0 flex-col gap-4 font-accent">
      <div class="cta-audiences grid grid-cols-2 gap-3 md:gap-5" role="group" aria-label="Тип заявки">
        <button type="button" data-audience="investor" aria-pressed="true" class="aud-btn aud-btn--sm-mobile plat-outline">Я инвестор</button>
        <button type="button" data-audience="owner" aria-pressed="false" class="aud-btn aud-btn--sm-mobile plat-outline">Я собственник</button>
      </div>

      {/* Заголовок формы и «Ответим…» на мобильном скрыты: повторяют надпись и первый пункт сверху */}
      <h3 data-t="formTitle" class="mt-3 hidden font-accent text-4xl font-normal leading-[1.1] text-fg lg:block">
        {copy.investor.formTitle}
      </h3>
      <p class="hidden text-xl leading-[1.12] text-copy lg:block">Ответим в течение одного рабочего дня.</p>

      <form id="cta-form" class="flex flex-col gap-3 md:gap-4" novalidate>
        {/* Аудитория уходит в отправку скрытым полем (TODO(CTA): по ней выбрать получателя) */}
        <input type="hidden" name="audience" value="investor" />

        <div class="grid gap-3 sm:grid-cols-2 md:gap-4">
          <label class="flex flex-col gap-2 text-base tracking-[0.013em] text-fg md:text-xl">
            Имя
            <input name="name" required autocomplete="name" placeholder="Как к вам обращаться" class="cta-input" />
          </label>
          <label class="flex flex-col gap-2 text-base tracking-[0.013em] text-fg md:text-xl">
            Телефон *
            <input name="phone" type="tel" required autocomplete="tel" placeholder="+7 (___) ___-__-__" class="cta-input" />
          </label>
        </div>

        <label class="flex flex-col gap-2 text-base tracking-[0.013em] text-fg md:text-xl">
          Электронная почта (по желанию)
          <input name="client_email" type="email" autocomplete="email" placeholder="name@example.ru" class="cta-input" />
          <span class="text-sm text-copy">
            <span class="lg:hidden">Для документов или письменного ответа.</span>
            <span class="hidden lg:inline">Если удобнее получить документы или ответ письменно.</span>
          </span>
        </label>

        <label class="flex flex-col gap-2 text-base tracking-[0.013em] text-fg md:text-xl">
          Кратко о задаче (по желанию)
          <textarea name="message" rows="3" data-t-placeholder="placeholder" placeholder={copy.investor.placeholder} class="cta-input"></textarea>
        </label>

        {/* Согласие: ссылка #privacy — страница политики появится позже */}
        <label class="flex items-start gap-2.5 text-sm leading-snug tracking-[0.013em] text-legal md:text-xl md:leading-[1.04]">
          <input type="checkbox" name="consent" required class="mt-0.5 size-[18px] shrink-0 accent-link" />
          <span>
            Согласие на обработку данных для ответа на обращение
          </span>
        </label>

        <Button variant="plat-form" type="submit" data-t="submit">{copy.investor.submit}</Button>

        {/* Статус отправки */}
        <p id="cta-status" class="hidden font-accent text-base" role="status"></p>
      </form>

      <p class="cta-note mt-2 font-accent text-sm leading-5 text-copy">
        <span class="lg:hidden">Телефон обязателен. Email и сообщение можно не заполнять.</span>
        <span class="hidden text-legal lg:inline">Не является публичной офертой. Условия конкретной сделки фиксируются в договоре.</span>
      </p>
    </div>
  </div>
</Section>

<style>
  @media (width < 768px) {
    .cta-layout { gap: 36px; }
    .cta-intro { gap: 14px; }
    .cta-intro > [data-t='lead'] { margin-top: 6px; }
    .cta-next { margin-top: 6px; color: #d9c49c; }
    .cta-form-column { gap: 24px; }
    .cta-audiences { padding-inline: 13px; }
    .cta-audiences button { min-height: 44px; font-size: 17px; }
    #cta-form { gap: 19px; padding-inline: 17px; }
    #cta-form > div:first-of-type { gap: 19px; }
    .cta-note { margin-top: 0; }
  }
</style>

<script>
  type Audience = 'investor' | 'owner';
  const root = document.querySelector<HTMLElement>('[data-cta]');

  if (root) {
    const copy = JSON.parse(root.dataset.copy ?? '{}') as Record<Audience, Record<string, any>>;
    const form = root.querySelector<HTMLFormElement>('#cta-form')!;
    const hidden = form.elements.namedItem('audience') as HTMLInputElement;

    // --- Переключатель «инвестор / собственник»: меняем только тексты ---
    function setAudience(a: Audience) {
      const c = copy[a];
      hidden.value = a;
      root!.querySelectorAll<HTMLElement>('[data-t]').forEach((el) => (el.textContent = c[el.dataset.t!]));
      root!.querySelectorAll<HTMLElement>('[data-step]').forEach((el) => (el.textContent = c.steps[Number(el.dataset.step)]));
      root!.querySelector<HTMLInputElement>('[data-t-placeholder]')!.placeholder = c.placeholder;
      root!.querySelectorAll<HTMLElement>('[data-audience]').forEach((b) =>
        b.setAttribute('aria-pressed', String(b.dataset.audience === a)),
      );
    }
    root.querySelectorAll<HTMLElement>('[data-audience]').forEach((b) =>
      b.addEventListener('click', () => setAudience(b.dataset.audience as Audience)),
    );

    // Кнопки-призывы в других блоках (Hero, баннер и т.д.) помечены data-cta-audience="investor|owner":
    // по клику сразу переключаем форму на нужную аудиторию (с нужными текстами), а сам переход
    // к форме делает обычная якорная ссылка href="#cta".
    document.querySelectorAll<HTMLElement>('[data-cta-audience]').forEach((link) =>
      link.addEventListener('click', () => setAudience(link.dataset.ctaAudience as Audience)),
    );

    // --- Отправка формы ---
    const status = root.querySelector<HTMLElement>('#cta-status')!;
    function show(text: string, ok: boolean) {
      status.textContent = text;
      status.classList.remove('hidden', 'text-accent', 'text-red-300');
      status.classList.add(ok ? 'text-accent' : 'text-red-300');
    }

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      if (!String(data.get('name')).trim() || !String(data.get('phone')).trim()) {
        return show('Укажите имя и телефон.', false);
      }
      if (!(form.elements.namedItem('consent') as HTMLInputElement).checked) {
        return show('Нужно согласие на обработку персональных данных.', false);
      }

      // TODO(CTA): отправка заявки письмом — пока доступов нет, это заглушка.
      //   Что сделать, когда будут доступы:
      //   1) fetch POST на GitHub API → workflow_dispatch воркфлоу cta-email.yml
      //      (адрес и inputs описаны в шапке .github/workflows/cta-email.yml;
      //      токен НЕ хранить в клиентском коде — нужен прокси/serverless-эндпоинт);
      //   2) передать поля: name, phone, client_email, message (+ audience);
      //   3) целевая почта зависит от audience (investor / owner): завести словарь
      //      «аудитория → адрес» на стороне отправки (secrets), а не в браузере;
      //   4) показать успех/ошибку по ответу, очистить форму при успехе.
      show('Форма собрана. Отправка письма будет подключена позже.', true);
    });
  }
</script>

<style is:global>
  /* Кнопки-переключатели .aud-btn — общие, лежат в styles/global.css
     (используются и в CtaForm, и в FAQ). */
  /* Поле ввода по спеке Figma: фон #143a30, рамка #1c4a3d, radius 9, высота 52 */
  .contact-form-section {
    background: #071f18;
  }
  .cta-input {
    height: 52px;
    width: 100%;
    border-radius: 9px;
    border: 1px solid #4f5747;
    background: #0c231c;
    padding: 0 17px;
    font-family: var(--font-body);
    font-size: 16px;
    color: var(--color-fg);
    outline: none;
    transition: border-color 0.15s;
  }
  textarea.cta-input {
    height: auto;
    min-height: 76px;
    padding-block: 12px;
    resize: vertical;
  }
  @media (max-width: 767px) {
    .cta-input {
      height: 48px;
      padding: 0 13px;
      border-color: #576652;
      background: #061e16;
    }
    textarea.cta-input { min-height: 65px; }
  }
  .cta-input::placeholder {
    color: rgba(244, 241, 234, 0.5);
  }
  .cta-input:focus {
    border-color: var(--color-accent);
  }
</style>
