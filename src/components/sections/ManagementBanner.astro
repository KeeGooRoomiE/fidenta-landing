---
/*
  УРОВЕНЬ 3 — БАННЕР ОБ УПРАВЛЕНИИ ОБЪЕКТОМ
  Источник: Figma, узел 974:64958 («block 10 Banner»)

  Широкая плашка в рамке Plat: слева eyebrow + H2 + текст + кнопка,
  справа фото склада в тонкой рамке. На мобильных фото уходит под текст.

  Фото (public/images/banner-warehouse.webp) — из Figma. В макете оно в маске
  с мягкими краями и тёмным градиентом слева — повторяем градиентом-оверлеем
  и inset-тенью, отдельный mask-файл не нужен.

  Кнопка ведёт на форму (#cta), как кнопки Hero.
*/
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
const base = import.meta.env.BASE_URL;
---

<Section pad="tight">
    <div
      class="management-banner plat-outline grid items-center gap-8 rounded-[9px] p-5 max-md:-mx-3 sm:p-6 lg:grid-cols-[1fr_416px] lg:gap-10 lg:py-[27px] lg:pl-[23px] lg:pr-[26px]"
    >
      {/* Текст */}
      <div class="flex flex-col gap-2.5">
        <div class="flex items-center gap-2.5">
          <span class="h-px w-5 shrink-0 bg-gold-line"></span>
          <span class="text-eyebrow text-gold-plate">Как работаем</span>
        </div>
        <h2 class="text-h2 text-fg [--h2-fs:1.65rem]">
          Управляем объектом<br /><span class="text-gold-plate">по согласованному плану</span>
        </h2>
        <p class="max-w-[713px] text-lead text-copy">
          Если помещение пустует, разберёмся, что мешает его сдать. Если арендаторы уже работают, посмотрим, где теряются время и деньги.
          Определим, с чего начать, и возьмём на себя все работы по объекту в рамках договора
        </p>
        <div class="mt-2 max-md:-mx-4 md:mt-3">
          <Button variant="plat" block href="#cta" data-cta-audience="owner" class="mobile-cta plat-outline text-[15px]">Передать объект под управление</Button>
        </div>
      </div>

      {/* Фото в тонкой рамке */}
      <div
        class="relative aspect-[416/259] overflow-hidden rounded-[9px] border-[0.7px] border-cream/60"
        style="box-shadow: inset -1px -1px 2px #05140f, inset 1px 1px 1px #05140f;"
      >
        <img
          src={`${base}images/banner-warehouse.webp`}
          alt="Складской комплекс"
          width="960"
          height="640"
          loading="eager"
          class="size-full object-cover"
        />
        {/* Затемнение слева, как в Figma */}
        <div
          class="pointer-events-none absolute inset-y-0 left-0 w-1/3"
          style="background-image: linear-gradient(90deg, rgba(10,32,25,0.62), rgba(25,43,41,0.25) 70%, rgba(25,43,41,0));"
        >
        </div>
      </div>
    </div>
</Section>

<style>
  .management-banner {
    background-image: repeating-linear-gradient(118deg, transparent 0 23px, rgb(213 202 177 / 2.4%) 23px 24px);
  }
  .management-banner :global(.btn-hero) {
    border: 0;
    height: 48px;
  }
</style>
