---
import SectionHeading from '../ui/SectionHeading.astro';
import Section from '../ui/Section.astro';
import { cooperation } from '../../data/cooperation';

const base = import.meta.env.BASE_URL;
const roles = [
  { key: 'investor', label: 'Я инвестор', ...cooperation.investor },
  { key: 'owner', label: 'Я собственник', ...cooperation.owner },
];
---

<Section id="cooperation" class="cooperation" data-cooperation>
  <div class="cooperation-layout">
    <div class="bridge-visual" aria-hidden="true">
      <img src={`${base}images/cooperation-bridge.webp`} width="1100" height="620" alt="" loading="lazy" decoding="async" />
    </div>

    <div class="cooperation-intro relative">
      {roles.map(({ key, title, accent, lead }, index) => (
        <div data-cooperation-intro={key} hidden={index > 0}>
          <SectionHeading eyebrow="Этапы сотрудничества">
            {title}<br /><span class="text-gold-plate">{accent}</span>
            <Fragment slot="lead">{lead}</Fragment>
          </SectionHeading>
        </div>
      ))}
      <div class="role-switch mt-6 grid grid-cols-2 gap-1 rounded-[9px] bg-[#303a28]/70 p-1 font-accent" role="group" aria-label="Роль в сотрудничестве">
        {roles.map(({ key, label }, index) => (
          <button type="button" class="role-step rounded-md px-2 py-2 text-lg" data-cooperation-role={key} aria-controls={`cooperation-${key}`} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>
        ))}
      </div>
    </div>

    {roles.map(({ key, stages }, roleIndex) => (
      <div class="cooperation-panel relative" id={`cooperation-${key}`} data-cooperation-panel={key} hidden={roleIndex > 0}>
        <div class="bridge-progress" data-cooperation-progress style={`--stage-progress: ${100 / stages.length}`} aria-hidden="true">
          <span></span>
          <svg viewBox="0 0 280 30" width="280" height="30" aria-hidden="true">
            <ellipse cx="140" cy="15" rx="138" ry="13" pathLength="100" />
            <ellipse class="bridge-oval-fill" cx="140" cy="15" rx="138" ry="13" pathLength="100" transform="rotate(180 140 15)" />
          </svg>
        </div>
        <div id={`cooperation-track-${key}`} class="stage-track mt-6" data-cooperation-track role="region" aria-label="Карусель этапов сотрудничества" tabindex="0">
          {stages.map(([, title, description], index) => (
            <article class="stage-detail plat-outline grid gap-3 rounded-xl bg-[#303a28]/45 p-5 font-accent md:items-center md:gap-6 md:p-6" data-cooperation-detail>
              <div>
                <p class="text-xs uppercase tracking-wider text-sand">Этап {String(index + 1).padStart(2, '0')} из {String(stages.length).padStart(2, '0')}</p>
                <h3 class="mt-1.5 text-2xl text-fg md:text-3xl">{title}</h3>
              </div>
              <p class="text-lg leading-snug text-copy">{description}</p>
            </article>
          ))}
        </div>
        <div class="stage-nav plat-outline mx-auto mt-4 grid w-fit grid-cols-[44px_auto_44px] items-center rounded-full bg-[#172c21] font-accent" role="group" aria-label="Переключение этапов">
          <button type="button" data-cooperation-back aria-label="Предыдущий этап" aria-controls={`cooperation-track-${key}`} disabled><span class="text-gold-plate" aria-hidden="true">←</span></button>
          <span data-cooperation-count class="text-gold-plate min-w-14 select-none text-center text-sm tabular-nums" aria-live="polite">01 / {String(stages.length).padStart(2, '0')}</span>
          <button type="button" data-cooperation-next aria-label="Следующий этап" aria-controls={`cooperation-track-${key}`}><span class="text-gold-plate" aria-hidden="true">→</span></button>
        </div>
      </div>
    ))}
    <p class="relative mt-7 font-accent text-sm text-legal">Состав работ, полномочия команды и порядок отчётности фиксируем в договоре по конкретному объекту.</p>
  </div>
</Section>

<script>
  const root = document.querySelector<HTMLElement>('[data-cooperation]');
  if (root) {
    const roles = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-cooperation-role]'));
    const intros = Array.from(root.querySelectorAll<HTMLElement>('[data-cooperation-intro]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-cooperation-panel]'));
    roles.forEach((button, index) => {
      button.addEventListener('click', () => {
        roles.forEach((role, i) => role.setAttribute('aria-pressed', String(i === index)));
        intros.forEach((intro, i) => { intro.hidden = i !== index; });
        panels.forEach((panel, i) => { panel.hidden = i !== index; });
      });
    });

    panels.forEach((panel) => {
      const track = panel.querySelector<HTMLElement>('[data-cooperation-track]')!;
      const details = Array.from(panel.querySelectorAll<HTMLElement>('[data-cooperation-detail]'));
      const progress = panel.querySelector<HTMLElement>('[data-cooperation-progress]')!;
      const back = panel.querySelector<HTMLButtonElement>('[data-cooperation-back]')!;
      const next = panel.querySelector<HTMLButtonElement>('[data-cooperation-next]')!;
      const count = panel.querySelector<HTMLElement>('[data-cooperation-count]')!;
      const reduced = matchMedia('(prefers-reduced-motion: reduce)');
      const wide = matchMedia('(min-width: 1024px)');
      let current = 0;

      const position = (index: number) => details[index].offsetLeft - details[0].offsetLeft;
      function update() {
        if (panel.hidden) return;
        if (wide.matches && !reduced.matches) {
          details.forEach((detail, index) => {
            const distance = Math.min(1, Math.abs(position(index) - track.scrollLeft) / track.clientWidth);
            const lift = 32 * Math.sqrt(1 - (2 * distance - 1) ** 2);
            detail.style.setProperty('--stage-arc', `${-lift}px`);
          });
        }
        const closest = details.reduce((best, _, index) =>
          Math.abs(position(index) - track.scrollLeft) < Math.abs(position(best) - track.scrollLeft) ? index : best, 0);
        if (closest === current) return;
        current = closest;
        count.textContent = `${String(current + 1).padStart(2, '0')} / ${String(details.length).padStart(2, '0')}`;
        back.disabled = current === 0;
        next.disabled = current === details.length - 1;
        progress.style.setProperty('--stage-progress', String((current + 1) / details.length * 100));
      }

      function move(index: number) {
        if (index < 0 || index >= details.length) return;
        track.scrollTo({ left: position(index), behavior: reduced.matches ? 'instant' : 'smooth' });
      }

      back.addEventListener('click', () => move(current - 1));
      next.addEventListener('click', () => move(current + 1));
      track.addEventListener('scroll', update, { passive: true });
      new ResizeObserver(update).observe(track);
      track.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        move(current + (event.key === 'ArrowLeft' ? -1 : 1));
      });
    });
  }
</script>

<style>
  .cooperation { background: radial-gradient(ellipse at 75% 25%, #102d26, transparent 65%), #061e16; }
  .cooperation-layout { position: relative; isolation: isolate; overflow: hidden; }
  .bridge-visual {
    position: relative;
    background: radial-gradient(ellipse at 60% 42%, #1c3b33, transparent 68%);
    mask-image: radial-gradient(ellipse at 50% 46%, black 35%, transparent 74%);
  }
  .bridge-visual img { width: 100%; height: auto; mask-image: radial-gradient(ellipse at 56% 48%, black 42%, transparent 75%); }
  @media (width < 768px) { .bridge-visual { margin-bottom: 24px; } }
  .cooperation-intro { max-width: 550px; }
  .role-switch { width: min(100%, 346px); }
  .role-step { color: #e8d4ae; }
  .role-step[aria-pressed='true'] { color: #0a2019; background: var(--gradient-gold); }
  .cooperation-panel { margin-top: 42px; }
  .bridge-progress { height: 1px; background: rgb(209 184 135 / 25%); }
  .bridge-progress span { position: relative; display: block; top: -1px; width: calc(var(--stage-progress) * 1%); height: 3px; border-radius: 4px; background: #d1b887; }
  .bridge-progress svg { display: none; }
  .stage-track {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 100%;
    gap: 12px;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .stage-track::-webkit-scrollbar { display: none; }
  .stage-detail { scroll-snap-align: start; }
  .stage-nav button { min-height: 44px; border-radius: 50%; cursor: pointer; font-size: 20px; }
  .stage-nav button:disabled { opacity: 0.35; cursor: default; }
  .stage-nav button:hover:not(:disabled) { background: rgb(255 241 217 / 7%); }
  .stage-detail { min-height: 133px; }
  @media (min-width: 768px) {
    .stage-detail { grid-template-columns: minmax(0, 2fr) minmax(0, 3.5fr); }
  }
  @media (min-width: 1024px) {
    .bridge-visual { position: absolute; z-index: -1; top: -12px; right: -12px; width: 70%; height: 420px; mask-image: linear-gradient(#000 73%, transparent), linear-gradient(to right, transparent, #000 27%, #000 84%, transparent); mask-composite: intersect; }
    .bridge-visual img { height: 100%; object-fit: contain; object-position: right center; }
    .cooperation-intro { min-height: 315px; }
    .bridge-progress { height: auto; background: none; }
    .bridge-progress span { display: none; }
    .bridge-progress svg { display: block; margin-inline: auto; fill: none; stroke: rgb(209 184 135 / 25%); }
    .bridge-oval-fill { stroke: #d1b887; stroke-width: 1.5; stroke-dasharray: var(--stage-progress) 100; }
    .stage-track { margin-top: 0; padding-top: 34px; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .bridge-progress span { transition: width 250ms ease; }
    .bridge-oval-fill { transition: stroke-dasharray 300ms ease; }
  }
  @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
    .stage-detail { translate: 0 var(--stage-arc, 0px); }
  }
</style>
