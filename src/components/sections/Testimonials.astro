---
/*
  УРОВЕНЬ 3 — БЛОК Testimonials («Говорят собственники»)

  Заголовок + три карточки отзывов. Данные в массиве reviews,
  карточки строятся циклом через переиспользуемый ReviewCard.
*/
import SectionHeading from '../ui/SectionHeading.astro';
import ReviewCard from '../ui/ReviewCard.astro';

const reviews = [
  {
    quote: 'Передал бизнес-центр на Васильевском в управление в 2018 году. За пять лет не было ни одного месяца с просрочкой. Отчёты приходят строго в срок, менеджер всегда на связи.',
    author: 'Андрей Васильев',
    role: 'Собственник БЦ «Нева Плаза»',
  },
  {
    quote: 'Фидента взяла нашу торговую точку с 40% вакансией. За полгода заполнили до 96%. Подход к работе с арендаторами — уважительный и профессиональный.',
    author: 'Наталья Ковалёва',
    role: 'Инвестор, Санкт-Петербург',
  },
  {
    quote: 'Инвестировал в апартаменты, не хотел заниматься арендой. Фидента взяла на себя всё. Живу в другом городе — и не чувствую никаких хлопот.',
    author: 'Игорь Смирнов',
    role: 'Владелец апарт-портфеля, Москва',
  },
];
---

<section class="py-20 md:py-28">
  <div class="container-page">
    <SectionHeading eyebrow="Клиенты" title="Говорят" accent="собственники" />

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {reviews.map((review) => (
        <ReviewCard quote={review.quote} author={review.author} role={review.role} />
      ))}
    </div>
  </div>
</section>
