---
/*
  УРОВЕНЬ 3 — БЛОК «Фидента - команда» (фото + заголовок)
  Источник: Figma, узел 974:65889

  Простой блок: eyebrow (линия+текст) → H2 (ОДНОЦВЕТНЫЙ, не плат-градиент —
  в отличие от соседних блоков, здесь обычный #f4f1ea) → подзаголовок →
  фото в толстой золотой рамке (16px, radius 9).

  Заголовок H2: по правке дизайнера исправлены опечатки макета («Фидента - команда,
  стань часть…» → «Фидента — команда, стань частью…»).

  ДОБАВЛЕНО ПО ПРАВКЕ ДИЗАЙНЕРА (в Figma этого нет): подпись под фото и
  три коротких тезиса о том, как работает команда. Тексты — ЧЕРНОВИК
  (придуманы по смыслу сайта), согласовать с клиентом. Оформление
  минималистичное: тонкая золотая линия сверху у каждого тезиса, без плиток и фонов.

  Фото (public/images/team-silhouettes.webp) — стоковое изображение-плейсхолдер
  из Figma (силуэты у окна + наложенные цифры биржевого тикера), явно НЕ
  настоящая команда Фиденты. Скачано скриншотом узла и обрезано от золотой
  рамки Figma (рамку рисуем сами через CSS border, чтобы не задваивать).
*/
const base = import.meta.env.BASE_URL;

// Тезисы под фото. ЧЕРНОВИК текстов — см. шапку файла.
const values = [
  { title: 'Ответственность', text: 'Отвечаем за объект и результат — от эксплуатации до отчётности.' },
  { title: 'Прозрачность', text: 'Инвестор видит те же цифры, что и мы, в один и тот же день.' },
  { title: 'Долгосрочность', text: 'Строим работу на горизонте лет, а не одной сделки.' },
];
---

<section class="py-20 md:py-28">
  <div class="container-page">
    {/* Заголовок блока */}
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-2.5">
        <span class="h-px w-5 shrink-0" style="background-image: var(--gradient-gold);"></span>
        <span class="font-accent text-xl uppercase tracking-[0.1em] text-gold-plate">Команда</span>
      </div>
      <h2 class="font-accent text-4xl leading-[1.2] tracking-[-0.02em] text-fg sm:text-5xl md:text-[50px]">
        Фидента — команда, стань частью сильной команды
      </h2>
      <p class="max-w-[860px] font-accent text-xl leading-[1.2] text-fg">
        Фидента объединяет людей, которые думают о своем будущем
      </p>
    </div>

    {/* Фото в золотой рамке */}
    <div class="mt-12 overflow-hidden rounded-[9px] border-[16px] border-[#fff1d9] md:mt-16">
      <img
        src={`${base}images/team-silhouettes.webp`}
        alt="Команда Фидента"
        width="1154"
        height="648"
        loading="lazy"
        decoding="async"
        class="aspect-[1154/648] w-full object-cover"
      />
    </div>

    {/* Подпись под фото */}
    <p class="mt-4 font-accent text-sm leading-snug text-muted md:text-base">
      Команда Фиденты — люди, которые ведут ваш объект каждый день.
    </p>

    {/* Тезисы: тонкая золотая линия сверху, без плиток */}
    <div class="mt-10 grid gap-8 md:mt-14 md:grid-cols-3 md:gap-10">
      {values.map((v) => (
        <div class="flex flex-col gap-2">
          <span class="h-px w-full" style="background-image: var(--gradient-gold);"></span>
          <h3 class="font-accent text-xl font-normal text-gold-plate md:text-2xl">{v.title}</h3>
          <p class="font-accent text-base leading-snug text-fg md:text-lg">{v.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>
