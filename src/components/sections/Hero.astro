---
/*
  УРОВЕНЬ 3 — БЛОК Hero (главный экран)

  Второй заход на композицию (первый — полноэкранное object-cover фото на всю
  секцию — ломался на мобильном: секция там в 2+ раза выше вьюпорта из-за
  карточек в столбик, а cover в таких пропорциях растягивал фото до
  нераспознаваемого вертикального огрызка). Исправление — фото живёт в
  СВОЁМ блоке с фиксированным через aspect-ratio соотношением сторон
  (разным по брейкпоинтам), а не растягивается на высоту всей секции:
  сколько бы контента ни было ниже (хоть 3 карточки в столбик, хоть 10),
  высота самого фото от этого не зависит и никогда не "съезжает".

  Структура сверху вниз:
   1. Фото-баннер (aspect-ratio) — вечерний деловой район, лёгкая синяя
      тонировка, градиент-фейд в сплошной canvas у своего нижнего края.
   2. Контент НИЖЕ баннера, уже на сплошном фоне — заголовок, сабтайтл,
      кнопки, 3 карточки. Никакой текст не лежит поверх фото — поэтому не
      нужно подбирать контраст под то, что именно на фото в этом месте
      (источник фрагильности предыдущей версии).
   Лёгкий отрицательный margin у контента — чтобы заголовок начинался чуть
   внахлёст с фейдом баннера, без явного шва между блоками.

  Cookie-баннер больше не здесь — переехал в index.astro как отдельный
  independent fixed-bottom-bar компонент, не завязанный на разметку Hero.
*/
const base = import.meta.env.BASE_URL;

const cards = [
  {
    icon: 'tile-club.png',
    lead: 'Fidenta Invest Club',
    rest: ' — закрытое сообщество',
  },
  {
    icon: 'tile-cycle.png',
    lead: 'Полный цикл сопровождения:',
    rest: ' аудит объекта — расчёт доходности',
  },
  {
    icon: 'tile-ownership.png',
    lead: 'Реальное владение:',
    rest: ' доля в объекте закреплена договором',
  },
];
---

<section class="relative overflow-hidden bg-canvas">
  <!-- Фото-баннер: высота ВСЕГДА определяется aspect-ratio, а не контентом
       секции ниже — поэтому не может "растянуться" независимо от того,
       сколько карточек и как они складываются на узких экранах. -->
  <div class="relative aspect-[4/3] w-full overflow-hidden sm:aspect-[16/9] md:aspect-[21/9]">
    <img
      src={`${base}images/hero-bg-skyline.webp`}
      alt=""
      class="h-full w-full object-cover object-center"
    />
    <!-- Лёгкая синяя тонировка сверху (фирменная гамма) + фейд в сплошной
         canvas у нижнего края баннера, чтобы переход в контент ниже был
         бесшовным. Само фото при этом хорошо видно почти на всю высоту. -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, rgba(11,24,48,.22) 0%, rgba(11,24,48,.06) 30%, rgba(10,32,25,0) 55%, #0A2019 97%);"
    ></div>
  </div>

  <!-- Контент — уже на сплошном фоне секции, текст нигде не лежит поверх
       фото, поэтому читаемость не зависит от того, что именно на кадре. -->
  <div class="hero-content container-page relative -mt-10 flex flex-col gap-16 pb-20 pt-0 md:gap-20 md:pb-10">
    <div class="flex max-w-2xl flex-col gap-7">
      <h1 class="hero-title font-accent font-normal">
        <span class="block text-fg">Коммерческая недвижимость,</span>
        <span class="hero-title-gold block">открытая для частного инвестора</span>
      </h1>

      <p class="max-w-[30rem] font-accent text-lg leading-[1.4] tracking-[0.01em] text-text-soft md:text-xl">
        Объединяем капитал частных инвесторов и профессионально управляем коммерческими объектами
        Санкт-Петербурга — от подбора актива до дохода с квадратного метра.
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <a href="#cta" class="hero-btn hero-btn--primary">Доступ к сделкам</a>
        <a href="#cta" class="hero-btn hero-btn--secondary">Передать объект в управление</a>
      </div>
    </div>

    <div class="relative grid gap-5 md:grid-cols-3">
      <!-- Мягкое золотое свечение за карточками — CSS, не завязано на фото. -->
      <div
        class="pointer-events-none absolute inset-x-0 -bottom-16 -top-10 -z-10 mix-blend-screen"
        style="background: radial-gradient(60% 100% at 50% 60%, rgba(199,162,75,.14), transparent 70%);"
      ></div>
      {cards.map((card) => (
        <div class="hero-card">
          <img src={`${base}icons/${card.icon}`} width="56" height="56" alt="" class="h-14 w-14 shrink-0 md:h-10 md:w-10" />
          <p class="font-accent text-[17px] leading-[1.4] tracking-[0.01em]">
            <span class="hero-card-gold">{card.lead}</span><span class="text-fg">{card.rest}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Фото-баннер — aspect-ratio, его высота = 100vw * 9/21 на md+ (21:9).
     Фиксированный margin-top: -320px (как просили) ломается при "резиновом"
     ресайзе: при ширине < ~1493px высота баннера < 640px, и -320 утягивает
     текст ВЫШЕ своей середины — на небо, а не на тёмные здания, как нужно.
     max() держит верх текста не выше 320px от начала Hero ВСЕГДА: на узких
     md-экранах подъём автоматически меньше 320px, на широких — ровно -320px
     (как и было одобрено на 1440px). */
  @media (min-width: 768px) {
    .hero-content {
      margin-top: max(-320px, calc(320px - 42.857vw));
    }
  }

  .hero-title {
    font-size: 2.75rem;
    line-height: 0.96;
    letter-spacing: -0.02em;
  }
  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }
  @media (min-width: 768px) {
    .hero-title {
      font-size: 4.5rem;
    }
  }

  .hero-title-gold,
  .hero-card-gold {
    background-image: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-accent);
    font-size: 1rem;
    letter-spacing: -0.01em;
    padding: 1rem 2rem;
    border-radius: 999px;
    transition: transform 0.2s ease, filter 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .hero-btn--primary {
    background-image: var(--gradient-gold);
    color: var(--color-on-gold);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 14px 32px -14px rgba(199, 162, 75, 0.65);
  }
  .hero-btn--primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .hero-btn--secondary {
    border: 1px solid rgba(199, 162, 75, 0.5);
    color: var(--color-accent-soft);
    background: rgba(244, 241, 234, 0.04);
  }
  .hero-btn--secondary:hover {
    border-color: var(--color-accent-soft);
    background: rgba(244, 241, 234, 0.08);
    transform: translateY(-1px);
  }

  .hero-card {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 1rem;
    padding: 1.25rem;
    border-radius: 16px;
    /* Сплошная заливка — не размытое стекло: за карточками фото больше нет
       (оно осталось только в баннере выше), прозрачность/блюр тут ничего не
       показывали бы, кроме сплошного фона секции. */
    background: var(--color-surface);
    border: 1px solid rgba(199, 162, 75, 0.25);
  }
</style>
