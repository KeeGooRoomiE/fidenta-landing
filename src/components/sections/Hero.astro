---
/*
  УРОВЕНЬ 3 — БЛОК Hero (главный экран)

  Слева — заголовок, подзаголовок и две кнопки.
  Справа — «плавающие» карточки-виджеты (объекты по районам + аналитика).
  Снизу — полоса из трёх бейджей (FeatureBadge).

  Фон — плейсхолдер под ночное фото Санкт-Петербурга (заменить на изображение из Figma).
*/
import Button from '../ui/Button.astro';
import FeatureBadge from '../ui/FeatureBadge.astro';

// Строки мини-виджета «объекты по районам»
const widgetRows = [
  { label: 'Приморский кластер', value: '14%' },
  { label: 'Риск профиль', value: 'A+' },
  { label: 'Спрос арендаторов', value: 'высокий' },
];
---

<section class="relative overflow-hidden">
  <!-- Фоновый плейсхолдер: градиент вместо фотографии.
       TODO: заменить на <img>/фон из Figma (ночная Нева). -->
  <div class="absolute inset-0 -z-10">
    <div class="h-full w-full bg-gradient-to-b from-[#123a48] via-[#0d2b2c] to-canvas"></div>
    <div class="absolute inset-0 bg-canvas/30"></div>
  </div>

  <div class="container-page grid gap-14 py-16 md:py-24 lg:grid-cols-2 lg:items-center">
    <!-- ЛЕВАЯ КОЛОНКА: текст + кнопки -->
    <div>
      <h1 class="text-4xl leading-[1.06] sm:text-5xl md:text-6xl">
        Инвестиции<br />в коммерческую<br /><span class="text-accent">недвижимость</span>
      </h1>
      <p class="mt-6 max-w-md text-lg leading-relaxed text-fg/80">
        Создаём и управляем активами, формируем ценность на годы.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button variant="primary" href="#cta">Консультация</Button>
        <Button variant="secondary" href="#portfolio">Наши объекты →</Button>
      </div>
    </div>

    <!-- ПРАВАЯ КОЛОНКА: виджеты -->
    <div class="relative">
      <!-- Виджет объектов по районам -->
      <div class="rounded-2xl border border-border bg-surface/80 p-6 backdrop-blur-md">
        <div class="flex items-center justify-between">
          <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-border text-accent">▦</div>
          <span class="text-xs uppercase tracking-wider text-muted">live</span>
        </div>
        <h3 class="mt-4 text-xl leading-snug">Виджет объектов<br />по районам города</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">
          Мини-виджет отслеживает локации с растущим деловым трафиком, арендной ставкой и ликвидностью объекта.
        </p>
        <dl class="mt-5 space-y-2">
          {widgetRows.map((row) => (
            <div class="flex items-center justify-between rounded-lg border border-border bg-canvas/40 px-4 py-2.5">
              <dt class="text-sm text-fg/80">{row.label}</dt>
              <dd class="text-sm font-semibold text-accent">{row.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <!-- Карточка аналитики (на десктопе «выплывает» из-под основного виджета) -->
      <div class="mt-5 rounded-2xl border border-border bg-surface/90 p-5 backdrop-blur-md lg:absolute lg:-bottom-14 lg:-left-12 lg:mt-0 lg:w-72">
        <p class="text-sm leading-snug text-fg/80">Постоянный доступ<br />к аналитике по фондам</p>
        <!-- Мини-график (area chart) — декоративный плейсхолдер -->
        <svg viewBox="0 0 260 70" class="mt-3 w-full" preserveAspectRatio="none" aria-hidden="true">
          <defs>
            <linearGradient id="hero-spark" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#c6a15b" stop-opacity="0.35" />
              <stop offset="100%" stop-color="#c6a15b" stop-opacity="0" />
            </linearGradient>
          </defs>
          <path d="M0 58 L43 50 L87 53 L130 38 L173 30 L217 18 L260 8 L260 70 L0 70 Z" fill="url(#hero-spark)" />
          <path d="M0 58 L43 50 L87 53 L130 38 L173 30 L217 18 L260 8" fill="none" stroke="#c6a15b" stroke-width="2" />
        </svg>
      </div>
    </div>
  </div>

  <!-- НИЖНЯЯ ПОЛОСА: три бейджа -->
  <div class="border-t border-border/60 bg-canvas/50 backdrop-blur-sm">
    <div class="container-page grid gap-4 py-5 sm:grid-cols-3">
      <FeatureBadge title="Fidenta Invest Club" subtitle="закрытое сообщество">
        <span slot="icon">✈</span>
      </FeatureBadge>
      <FeatureBadge title="12 лет на рынке инвестиций" subtitle="более 100 объектов в фондах">
        <span slot="icon">▤</span>
      </FeatureBadge>
      <FeatureBadge value="11,8%" title="Целевая годовая" subtitle="доходность" />
    </div>
  </div>
</section>
