---
/*
  УРОВЕНЬ 3 — БЛОК Hero (главный экран) — по финальному дизайну

  Полноэкранный блок: ночное фото Невы на фоне, слева сверху — заголовок,
  подзаголовок и две кнопки, внизу — ряд из трёх плиток-преимуществ.

  Фон: сейчас градиент-плейсхолдер под ночную Неву. Когда появится файл фото —
  положи его в public/images/hero-bg.webp и раскомментируй <img> ниже (одна строка).

  Плитки (по спеке Figma): скругление 9px, паддинг 30/40, border 1px, blur +
  полупрозрачный фон; текст — шрифт Forum 18px, плотный leading, трекинг 1%.
  Иконки плиток — пока inline-SVG (золото), заменим на экспорт из Figma.
*/
import Button from '../ui/Button.astro';

const base = import.meta.env.BASE_URL;

// Три плитки-преимущества. icon — имя inline-SVG (рисуем ниже по id через <use> нельзя,
// поэтому держим иконки как мелкие компоненты-разметку в массиве через ключ).
const tiles = [
  {
    key: 'club',
    line1: 'Fidenta Invest Club -',
    line2: 'закрытое сообщество',
  },
  {
    key: 'cycle',
    line1: 'Полный цикл сопровождения:',
    line2: 'аудит объекта - расчёт доходности',
  },
  {
    key: 'ownership',
    line1: 'Реальное владение: доля в',
    line2: 'объекте закреплена договором',
  },
];
---

<section class="relative flex min-h-screen flex-col overflow-hidden">
  <!-- ФОН -->
  <div class="absolute inset-0 -z-10">
    <!-- РЕАЛЬНОЕ ФОТО: положи public/images/hero-bg.webp и раскомментируй строку ниже -->
    <!-- <img src={`${base}images/hero-bg.webp`} alt="" class="h-full w-full object-cover" /> -->

    <!-- Плейсхолдер: градиент под ночную Неву (тёмно-синее небо → тёплая набережная → бренд-зелёный) -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(180deg, #0a1c34 0%, #0a1830 50%, #14233a 72%, #2a2414 87%, #0A2019 100%);"
    >
    </div>
    <!-- Тёплое свечение у набережной (нижняя треть) -->
    <div
      class="absolute inset-0"
      style="background: radial-gradient(60% 28% at 50% 86%, rgba(217, 160, 70, 0.18) 0%, rgba(217, 160, 70, 0) 70%);"
    >
    </div>
    <!-- Лёгкое затемнение слева для читаемости заголовка -->
    <div
      class="absolute inset-0"
      style="background: linear-gradient(90deg, rgba(10, 32, 25, 0.55) 0%, rgba(10, 32, 25, 0.1) 55%, rgba(10, 32, 25, 0) 100%);"
    >
    </div>
  </div>

  <!-- КОНТЕНТ (вверху слева). flex-1 растягивает область, прижимая плитки к низу. -->
  <div class="container-page flex flex-1 flex-col justify-start pt-28 md:pt-32">
    <div class="max-w-2xl">
      <!-- H1: Playfair, вес 500, плотный трекинг. Переопределяем вес/leading базового h1. -->
      <h1 class="font-medium leading-[1.08] tracking-[-0.01em] text-[2.5rem] sm:text-5xl md:text-[3.5rem]">
        Коммерческая недвижимость, открытая для частного инвестора
      </h1>
      <!-- Lead: Inter 20/1.45, вторичный светлый текст -->
      <p class="mt-6 max-w-xl text-lg leading-[1.5] text-text-soft">
        Объединяем капитал частных инвесторов и профессионально управляем коммерческими объектами
        Санкт-Петербурга — от подбора актива до дохода с квадратного метра.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <Button variant="primary" href="#cta">Доступ к сделкам</Button>
        <Button variant="secondary" href="#cta">Передать объект в управление</Button>
      </div>
    </div>
  </div>

  <!-- ПЛИТКИ (прижаты к низу). Сетка: 1 колонка на мобиле, 3 на десктопе, gap 10px. -->
  <div class="container-page pb-10 pt-16">
    <div class="grid gap-2.5 md:grid-cols-3">
      {tiles.map((tile) => (
        <div class="flex items-center gap-4 rounded-[9px] border border-white/10 bg-canvas/40 px-10 py-[30px] backdrop-blur-md">
          <!-- Иконка-бокс (плейсхолдер, заменить на экспорт из Figma) -->
          <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-[9px] border border-accent/30 text-accent">
            {tile.key === 'club' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 2 11 13" />
                <path d="M22 2 15 22 11 13 2 9 22 2Z" />
              </svg>
            )}
            {tile.key === 'cycle' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                <path d="M14 3v5h5" />
                <path d="m9 15 2 2 4-4" />
              </svg>
            )}
            {tile.key === 'ownership' && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" />
                <path d="M3 10h18M8 2v4M16 2v4" />
              </svg>
            )}
          </div>
          <!-- Текст плитки: шрифт Forum 18px, трекинг 1% (спека дизайнера) -->
          <p class="font-accent text-[18px] leading-[1.15] tracking-[0.01em] text-fg">
            {tile.line1}<br />{tile.line2}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
