---
const assets = `${import.meta.env.BASE_URL}images/hero/`;
const cards = [
  {
    title: 'Реальные объекты',
    description: 'Коммерческая недвижимость: действующие объекты, реконструкция, управление и развитие',
  },
  {
    title: 'Что делает Фидента',
    description: 'Подбираем объект, оцениваем затраты, организуем работы и ведём расчёты с арендаторами',
  },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-art" aria-hidden="true">
    <img
      id="hero-bg-image"
      src={`${assets}panorama.webp`}
      srcset={`${assets}panorama-small.webp 960w, ${assets}panorama.webp 2560w`}
      sizes="(max-width: 639px) 567px, 100vw"
      width="2560"
      height="1920"
      alt=""
      fetchpriority="high"
    />
  </div>

  <div class="hero-content">
    <div class="hero-copy">
      <h1 class="hero-title" id="hero-title">
        <span class="hero-subject">Коммерческая <span>недвижимость</span></span>
        <span class="hero-city"><span class="text-gold-plate">Санкт-Петербурга:</span></span>
        <span class="hero-title-line">инвестиции и управление</span>
      </h1>

      <p class="hero-intro">
        <span><span>Помогаем инвесторам</span> <span>выбрать объект</span> <span>и оценить расходы до сделки</span></span>
        <span><span>Собственникам — найти арендаторов</span> <span>и организовать обслуживание здания</span></span>
      </p>
    </div>

    <div class="hero-actions">
      <a href="#cta" data-cta-audience="investor" aria-describedby="hero-project-note" class="hero-btn hero-btn--primary">Обсудить инвестиции</a>
      <a href="#cta" data-cta-audience="owner" class="hero-btn hero-btn--secondary plat-outline"><span class="text-fg">Я собственник</span></a>
    </div>

    <p class="hero-project-note" id="hero-project-note">Если есть подходящий объект, пришлём карточку с адресом, арендатором и условиями участия</p>

    <ul class="hero-cards">
      {cards.map(({ title, description }) => (
        <li class="plat-outline hero-card">
          <h2 class="plat-card-heading">{title}</h2>
          <p>{description}</p>
        </li>
      ))}
      <li class="plat-outline hero-card hero-news">
        <a href="https://t.me/fidenta" aria-label="Открыть канал «Архитектура капитала» компании Фидента">
          <h2 class="plat-card-heading">Смотрите за проектами Фидента</h2>
          <p>Новые объекты и новости<span class="channel-detail"> компании</span><br />в <span class="channel-detail">нашем </span>канале «Архитектура капитала»</p>
          <img class="channel-plane" src={`${assets}channel-mobile.svg`} width="27" height="27" alt="" />
          <img class="channel-desktop" src={`${assets}news-telegram.svg`} width="52" height="48" alt="" />
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    --hero-base: #071d17;
    position: relative;
    isolation: isolate;
    background: linear-gradient(var(--hero-base) 70%, var(--color-canvas));
    font-family: var(--font-accent);
    color: var(--color-fg);
    /* Согласуем масштаб первого экрана с шапкой на контрольной ширине 1440px. */
    zoom: calc(1 / var(--desktop-reference-zoom, 1));
  }

  .hero-art {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 575px;
    max-height: 100%;
    mask-image: linear-gradient(to bottom, #000 calc(100% - clamp(72px, 11vw, 168px)), transparent);
    pointer-events: none;
  }

  .hero-art img {
    position: absolute;
    inset: 83px 0 auto;
    width: 100%;
    height: 425px;
    object-fit: cover;
  }

  .hero::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto 0 0;
    height: clamp(44px, 8vw, 128px);
    background: linear-gradient(transparent, var(--color-canvas));
    pointer-events: none;
  }

  .hero-art::before,
  .hero-art::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .hero-art::before {
    z-index: 1;
    opacity: 0.64;
    background:
      linear-gradient(180deg, var(--hero-base) 26%, rgba(7, 29, 23, 0.1) 48%, rgba(7, 29, 23, 0.2) 72%, var(--hero-base)),
      linear-gradient(90deg, rgba(7, 29, 23, 0.83), rgba(7, 29, 23, 0.756) 34.527%, rgba(7, 29, 23, 0.35) 52%, transparent);
    background-size: 100% 480px;
    background-position: 0 83px;
    background-repeat: no-repeat;
  }

  .hero-art::after {
    z-index: 2;
    background:
      linear-gradient(180deg, var(--hero-base) 22%, rgba(7, 29, 23, 0.84) 48%, rgba(7, 29, 23, 0.38) 73%, transparent) left top 58px / 100% 190px no-repeat,
      linear-gradient(180deg, rgba(7, 21, 52, 0.28), rgba(5, 15, 33, 0.08) 62%, rgba(1, 3, 5, 0.01)) left top 83px / 100% 492px no-repeat,
      linear-gradient(180deg, transparent, rgba(7, 29, 23, 0.08) 18%, rgba(7, 29, 23, 0.38) 40%, rgba(7, 29, 23, 0.79) 64%, rgba(7, 29, 23, 0.96) 82%, var(--hero-base) 100%) left top 330px / 100% 245px no-repeat;
  }

  .hero-content {
    width: calc(100% - 40px);
    max-width: 1280px;
    margin-inline: auto;
    padding-block: 334px 80px;
  }

  .hero-copy {
    padding-inline: 4px;
  }

  .hero-title {
    font-size: clamp(26px, 7.7vw, 30px);
    line-height: 1.07;
  }

  .hero-subject,
  .hero-subject > span,
  .hero-city,
  .hero-title-line,
  .hero-intro > span {
    display: block;
  }

  .hero-title .text-gold-plate {
    --plat-text-fill: linear-gradient(166deg, var(--plat-text-mid-dark), var(--plat-text-midpoint) 33%, var(--plat-text-shadow) 100%);
  }


  .hero-intro {
    max-width: 44em;
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.22;
    color: #dedede;
  }

  .hero-intro > span > span { display: inline-block; max-width: 100%; }

  .hero-project-note {
    max-width: 58ch;
    margin-top: 10px;
    color: var(--color-copy);
    font-size: 16px;
    line-height: 1.3;
  }

  .hero-actions {
    display: grid;
    gap: 13px;
    margin-top: 26px;
  }

  .hero-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 8px 12px;
    border-radius: 9px;
    font-size: 20px;
    line-height: 1.22;
    text-align: center;
    box-shadow: inset 0 0 0 1px transparent;
  }

  @media (hover: hover) {
    .hero-btn:hover {
      background-image: linear-gradient(110deg, rgb(249 239 216 / 9%), rgb(249 239 216 / 18%) 45%, rgb(215 196 159 / 8%)), var(--hero-btn-fill);
      box-shadow: inset 0 0 0 1px rgb(252 238 208 / 88%);
    }
  }

  .hero-btn:focus-visible {
    outline: 2px solid #f0dfbc;
    outline-offset: 3px;
  }

  .hero-btn--primary {
    color: #10241e;
    --hero-btn-fill: var(--gradient-plat-contact-button);
    background: var(--hero-btn-fill);
  }

  .hero-btn--secondary {
    color: var(--color-fg);
    --hero-btn-fill: linear-gradient(var(--color-cta-dark), var(--color-cta-dark));
    background: var(--color-cta-dark);
  }

  .hero-cards {
    display: grid;
    gap: 12px;
    margin-top: 62px;
    list-style: none;
  }

  .hero-card {
    min-height: 106px;
    padding: 11px 17px;
    border-radius: 9px;
    background: var(--color-tile);
  }

  .hero-card h2 {
    --plat-text-fill: linear-gradient(160deg, #d9cbb1, #c5b394 64%, #ae9b79);
    font-size: 17px;
    line-height: 1.22;
  }

  .hero-card p {
    margin-top: 3px;
    font-size: 16px;
    line-height: 1.22;
  }

  .hero-news {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    padding-right: 22px;
  }

  .hero-news > a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    width: 100%;
    align-items: center;
    column-gap: 8px;
  }
  .hero-card.hero-news {
    position: relative;
    background-image: linear-gradient(110deg, rgb(205 196 172 / 14%), rgb(197 190 169 / 8%) 60%, rgb(189 182 163 / 13%));
  }
  .hero-news a::after { box-shadow: inset 0 0 0 1px transparent; }
  @media (hover: hover) {
    .hero-news:hover a::after { box-shadow: inset 0 0 0 1px rgb(224 210 182 / 53%); }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .hero-news a::after, .hero-news :is(.channel-desktop, .channel-plane) { transition: box-shadow 180ms ease, transform 180ms ease; }
    .hero-news:hover :is(.channel-desktop, .channel-plane) { transform: translate(1px, -1px); }
  }
  .hero-news a::after { content: ''; position: absolute; inset: 0; border-radius: inherit; }
  .hero-news:has(a:focus-visible) { outline: 1px solid #c9b38e; }
  .hero-news a { border-radius: inherit; }
  .hero-news h2 { grid-column: 1 / -1; }
  .channel-desktop { display: none; }
  .channel-plane { position: absolute; top: 44px; right: 20px; width: 29px; height: 29px; }
  @media (width < 1024px) {
    .hero-card.hero-news { padding: 12px 51px 12px 18px; }
    .hero-news > a { display: block; }
    .hero-news p { margin-top: 5px; }
  }
  @media (max-width: 420px) { .hero-news .channel-detail { display: none; } }
  @media (max-width: 350px) { .hero-news p { font-size: 15px; } }

  @media (width < 640px) {
    .hero-title { font-size: 34px; }
    .hero-title-line { font-size: 30px; }
  }

  @media (min-width: 640px) {
    .hero-art {
      height: 675px;
    }

    .hero-art img {
      inset-block: 104px 0;
      height: calc(100% - 104px);
    }

    .hero-art::before {
      content: none;
    }

    .hero-art::after {
      background:
        linear-gradient(180deg, rgba(7, 21, 52, 0.62), rgba(5, 15, 33, 0.22) 62%, rgba(1, 3, 5, 0.01)),
        linear-gradient(180deg, var(--hero-base) 26%, rgba(7, 29, 23, 0.1) 48%, rgba(7, 29, 23, 0.2) 72%, var(--hero-base)),
        linear-gradient(90deg, rgba(7, 29, 23, 0.83), rgba(7, 29, 23, 0.756) 34.527%, rgba(7, 29, 23, 0.35) 52%, transparent);
    }

    .hero-content {
      width: calc(100% - 2 * clamp(32px, 5.556%, 80px));
      padding-top: 260px;
    }

    .hero-copy {
      padding-inline: 0;
    }

    .hero-title {
      font-size: clamp(36px, 5.2vw, 48px);
    }

    .hero-subject > span {
      display: inline;
    }

    .hero-intro {
      font-size: 18px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .hero-btn--primary {
      min-width: 250px;
    }

    .hero-btn--secondary {
      min-width: 185px;
    }

    .hero-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-top: 64px;
      @media (width < 768px) {
        margin-top: 90px;
      }
    }

    .hero-news {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .hero-art {
      height: 942px;
    }

    .hero-art img {
      inset-block-start: 173px;
      height: calc(100% - 173px);
    }

    .hero-content {
      padding-block: 232px 94px;
    }

    .hero-title {
      font-size: clamp(44px, 3.889vw, 56px);
    }

    .hero-intro {
      margin-top: 28px;
      font-size: 20px;
    }

    .hero-btn {
      padding-inline: 30px;
    }

    .hero-btn--primary {
      min-width: 300px;
    }

    .hero-btn--secondary {
      min-width: 213px;
    }

    .hero-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      margin-top: clamp(96px, 9.93vw, 143px);
    }

    .hero-card {
      min-height: 120px;
      padding: 19px;
      background: var(--hero-card-surface);
    }

    .hero-card h2 {
      font-size: 20px;
    }

    .hero-card p {
      margin-top: 10px;
      color: #dedede;
    }

    .channel-plane { display: none; }
    .channel-desktop { display: block; grid-column: 2; grid-row: 1 / 3; align-self: end; }
    .hero-news h2 { grid-column: 1; }
    .hero-news {
      grid-column: auto;
      padding-right: clamp(19px, 2.5vw, 36px);
    }
  }

  @media (1024px <= width < 1200px) {
    .hero-art {
      height: 780px;
    }

    .hero-art img {
      inset-block-start: 125px;
      height: calc(100% - 125px);
    }

    .hero-content {
      padding-block: 196px 64px;
    }

    .hero-cards {
      gap: 16px;
      margin-top: 64px;
    }

    .hero-card {
      padding: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-btn {
      transition: none;
    }
  }
</style>
