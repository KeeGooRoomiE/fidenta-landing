---
/*
  УРОВЕНЬ 3 — БЛОК Hero (главный экран) — финальный дизайн

  Раскладка:
   - Фон: тёмно-синий градиент + ночное фото Невы, прижатое к НИЗУ (сдвинуто вниз),
     тёмный верх для читаемости заголовка, плавный переход в фон страницы снизу.
   - Слева сверху: H1 (Forum 64, двухцветный) + подзаголовок + две кнопки.
   - Внизу: три плитки-преимущества (фростед-стекло) с иконками.

  Типографика H1 по спеке: Forum 400, 64px, line-height 89%, letter-spacing -2%.
   «Коммерческая недвижимость,» — кремовый (#F4F1EA),
   «открытая для частного инвестора» — плат-градиент (text-gold-plate).
*/
const base = import.meta.env.BASE_URL;

// Плитки: иконка (реальный ассет из Figma) + две строки текста (шрифт Forum).
const tiles = [
  { icon: 'tile-club.png', line1: 'Fidenta Invest Club -', line2: 'закрытое сообщество' },
  { icon: 'tile-cycle.png', line1: 'Полный цикл сопровождения:', line2: 'аудит объекта - расчёт доходности' },
  { icon: 'tile-ownership.png', line1: 'Реальное владение: доля в', line2: 'объекте закреплена договором' },
];
---

<section class="relative flex min-h-screen flex-col overflow-hidden">
  <!-- ФОН -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <!-- База под фото — сплошной #091832 (фото прижато к низу, верх закрыт этим же цветом) -->
    <div class="absolute inset-0" style="background: linear-gradient(180deg, #091832 0%, #091832 72%, #0A2019 100%);"></div>
    <!-- Фото Невы прижато к низу, натуральный размер (не растягиваем) -->
    <img src={`${base}images/hero-bg.webp`} alt="" aria-hidden="true" class="absolute inset-x-0 bottom-0 w-full" />
    <!-- Верхний слой #091832 закрывает фото сверху и «открывает» его к строке подзаголовка (~44%) -->
    <div class="absolute inset-0" style="background: linear-gradient(180deg, #091832 0%, #091832 44%, rgba(9, 24, 50, 0) 54%);"></div>
    <!-- Плавный переход низа в фон страницы -->
    <div class="absolute inset-x-0 bottom-0 h-40" style="background: linear-gradient(180deg, rgba(10, 32, 25, 0) 0%, #0A2019 100%);"></div>
  </div>

  <!-- КОНТЕНТ (сверху слева). flex-1 прижимает плитки к низу. pt-* очищает фикс-хедер. -->
  <div class="container-page flex flex-1 flex-col justify-start pt-28 md:pt-36">
    <div class="max-w-2xl">
      <!-- H1: Forum 64/0.89, трекинг -2%. Двухцветный. -->
      <h1 class="font-accent font-normal leading-[0.89] tracking-[-0.02em] text-[2.5rem] sm:text-5xl md:text-[64px]">
        <span class="block text-fg">Коммерческая недвижимость,</span>
        <span class="block text-gold-plate">открытая для частного инвестора</span>
      </h1>
      <!-- Подзаголовок: кремовый (#F4F1EA) -->
      <p class="mt-6 max-w-xl text-base leading-relaxed text-fg">
        Объединяем капитал частных инвесторов и профессионально управляем коммерческими объектами
        Санкт-Петербурга — от подбора актива до дохода с квадратного метра.
      </p>
      <!-- Кнопки: плат-заливка / плат-обводка (спека Figma) -->
      <div class="mt-8 flex flex-wrap gap-4">
        <a href="#cta" class="btn-hero btn-plat hover:brightness-110">Доступ к сделкам</a>
        <a href="#cta" class="btn-hero btn-plat-outline">
          <span class="text-gold-plate">Передать объект в управление</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ПЛИТКИ (прижаты к низу). Сетка: 1 колонка на мобиле, 3 на десктопе, gap 10px. -->
  <div class="container-page pb-10 pt-16">
    <div class="grid gap-[43px] md:grid-cols-3">
      {tiles.map((tile) => (
        <div class="plat-card flex items-center gap-4 px-6 py-4">
          <img src={`${base}icons/${tile.icon}`} width="63" height="58" alt="" class="h-14 w-auto shrink-0" />
          <p class="font-accent text-[18px] leading-[1.15] tracking-[0.01em] text-fg">
            {tile.line1}<br />{tile.line2}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
