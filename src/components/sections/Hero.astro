---
/*
  УРОВЕНЬ 3 — БЛОК Hero (главный экран)
  Источник: Figma, файл Cz2upesn8p2Cd7cZTdg2WQ, узел 974:65347 (Header+Hero+Плитки+Cookie)

  Раскладка:
   - Фон: #091832 + ночное фото Невы, прижатое к низу, открывается к строке подзаголовка
   - Слева сверху: H1 (Forum 64/0.89, двуцветный) + лид (Forum 20) + две кнопки
   - Внизу: три плитки-преимущества (фростед-стекло, solid кремовая рамка)

  Точные значения из Figma:
   - H1: font-size 64, line-height 0.89 (89%), letter-spacing -1.28px (-2%)
   - Лид: font-size 20, line-height 101.465%, letter-spacing 0.2px, gap до H1 — 12px
   - Плитки: padding 30/40, gap icon↔text 30px, text line-height 17px (фикс, не %)
   - Текст плитки двуцветный: первая фраза — плат-градиент, остаток — сплошной #f4f1ea
*/
const base = import.meta.env.BASE_URL;

// Плитки: иконка + текст, разбитый на gold-фразу (span1) и обычный остаток (span2).
const tiles = [
  { icon: 'tile-club.png', gold: 'Fidenta Invest Club - ', rest: 'закрытое сообщество' },
  { icon: 'tile-cycle.png', gold: 'Полный цикл сопровождения:', rest: 'аудит объекта - расчёт доходности', br: true },
  { icon: 'tile-ownership.png', gold: 'Реальное владение: ', rest: 'доля в объекте закреплена договором' },
];
---

<section class="relative flex min-h-screen flex-col overflow-hidden">
  <!-- ФОН -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <!-- База под фото — сплошной #091832 (фото прижато к низу, верх закрыт этим же цветом) -->
    <div class="absolute inset-0" style="background: linear-gradient(180deg, #091832 0%, #091832 72%, #0A2019 100%);"></div>
    <!-- Фото Невы прижато к низу, натуральный размер (не растягиваем) -->
    <img src={`${base}images/hero-bg.webp`} alt="" aria-hidden="true" class="absolute inset-x-0 bottom-0 w-full" />
    <!-- Верхний слой #091832 закрывает фото сверху и «открывает» его к строке подзаголовка (~44%) -->
    <div class="absolute inset-0" style="background: linear-gradient(180deg, #091832 0%, #091832 44%, rgba(9, 24, 50, 0) 54%);"></div>
    <!-- Плавный переход низа в фон страницы -->
    <div class="absolute inset-x-0 bottom-0 h-40" style="background: linear-gradient(180deg, rgba(10, 32, 25, 0) 0%, #0A2019 100%);"></div>
  </div>

  <!-- КОНТЕНТ (сверху слева). flex-1 прижимает плитки к низу. -->
  <div class="container-page flex flex-1 flex-col justify-start pt-24 md:pt-32">
    <div class="flex max-w-2xl flex-col gap-3">
      <!-- H1: Forum 64/0.89, трекинг -2%. Двухцветный (первая строка cream, вторая — plat). -->
      <h1 class="font-accent font-normal leading-[0.89] tracking-[-0.02em] text-[2.5rem] sm:text-5xl md:text-[64px]">
        <span class="block text-fg">Коммерческая недвижимость, </span>
        <span class="block text-gold-plate">открытая для частного инвестора</span>
      </h1>
      <!-- Лид: Forum 20/101.465%, tracking 0.2px, кремовый. max-w по спеке (~451px). -->
      <p class="max-w-[451px] font-accent text-xl leading-[1.015] tracking-[0.01em] text-fg">
        Объединяем капитал частных инвесторов и профессионально управляем коммерческими объектами
        Санкт-Петербурга — от подбора актива до дохода с квадратного метра.
      </p>
      <!-- Кнопки: primary (плат-заливка + inset-тень) / outline (сплошная кремовая рамка) -->
      <div class="mt-3 flex flex-wrap gap-1.5">
        <a href="#cta" class="btn-hero btn-plat hover:brightness-110">Доступ к сделкам</a>
        <a href="#cta" class="btn-hero btn-outline">
          <span class="text-gold-plate">Передать объект в управление</span>
        </a>
      </div>
    </div>
  </div>

  <!-- ПЛИТКИ (прижаты к низу). Сетка: 1 колонка на мобиле, 3 на десктопе, gap 43px. -->
  <div class="container-page pb-10 pt-16">
    <div class="grid gap-[43px] md:grid-cols-3">
      {tiles.map((tile) => (
        <div class="plat-card flex items-center gap-[30px] px-10 py-[30px]">
          <img src={`${base}icons/${tile.icon}`} width="63" height="58" alt="" class="h-14 w-auto shrink-0" />
          <!-- line-height 17px — фиксированный px из Figma (не проценты) -->
          <p class="font-accent text-[18px] tracking-[0.01em]" style="line-height: 17px;">
            <span class="text-gold-plate">{tile.gold}</span>{tile.br && <br />}<span class="text-fg">{tile.rest}</span>
          </p>
        </div>
      ))}
    </div>
  </div>
</section>
