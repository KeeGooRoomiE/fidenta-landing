---
/*
  УРОВЕНЬ 3 — БЛОК Hero (главный экран)

  Собран с нуля (без привязки к прежней реализации), по прямому брифу:
  тайтл (2 строки, вторая — золотом) + сабтайтл + 2 кнопки + 3 карточки
  с иконками поверх фонового фото вечерней набережной.

  Идея композиции:
   - Фон — одно фото (public/images/hero-bg-skyline.webp, вечерний деловой
     район), растянутое на всю секцию через object-cover. При пропорциях
     этого фото (3:2) секция всегда "height-bound" по cover — кропается только
     по ширине, высота фото видна целиком на любом брейкпоинте, поэтому
     проценты в градиентах ниже совпадают с реальными зонами кадра (небо →
     силуэты небоскрёбов → тёмный передний план) стабильно везде.
   - Поверх фото — тонировка СИНИМ (не зелёным — так попросил пользователь,
     раз фото само по себе сине-сумеречное, зелёный тон с ним спорил):
     (1) ровный синий тон на всё фото; (2) градиент сверху — у заголовка почти
     сплошной (монотонный), ниже быстро открывается — фото должно быть хорошо
     видно, не только у карточек; (3) градиент снизу — выход в сплошной
     --color-canvas (зелёный, фирменный) для бесшовного перехода в следующий
     блок — тут тон НЕ меняем, это уже про стык с остальным сайтом, а не про
     тонировку самого фото.
   - Карточки стоят в зоне, где верхний градиент уже сошёл на нет — там сквозь
     тонировку видно фото (силуэты небоскрёбов, тёплое окно на переднем плане),
     плюс мягкое золотое свечение (screen-blend) у них за спиной.
   - Шрифт — Forum везде (font-accent), включая подзаголовок и карточки.

  Cookie-баннер (функциональность, не часть брифа) вынесен в обычное fixed
  положение внизу справа — стандартный паттерн, не завязан на раскладку Hero.
*/
import CookieBanner from '../CookieBanner.astro';

const base = import.meta.env.BASE_URL;

const cards = [
  {
    icon: 'tile-club.png',
    lead: 'Fidenta Invest Club',
    rest: ' — закрытое сообщество',
  },
  {
    icon: 'tile-cycle.png',
    lead: 'Полный цикл сопровождения:',
    rest: ' аудит объекта — расчёт доходности',
  },
  {
    icon: 'tile-ownership.png',
    lead: 'Реальное владение:',
    rest: ' доля в объекте закреплена договором',
  },
];
---

<section class="relative isolate overflow-hidden bg-canvas">
  <!--
    ВАЖНО: `isolate` на секции обязателен. Без него `position: relative` САМО ПО
    СЕБЕ не создаёт stacking context (его создаёт только явный z-index/isolation),
    и слои с отрицательным z-index «проваливаются» в ближайший РЕАЛЬНЫЙ stacking
    context — то есть в контекст всей страницы, где рисуются ПОСЛЕ фона body, но
    ПЕРЕД всем обычным контентом страницы (а не только контентом этой секции).
    Итог без isolate: фото оказывается полностью перекрыто всем, что ниже по
    DOM — секция выглядит плоским сплошным цветом, фото не видно вообще.
    (Проверено эмпирически через devtools-инспекцию стекинга при сборке блока.)
  -->

  <!-- Фон: фото вечернего делового района -->
  <div class="absolute inset-0 -z-20">
    <img
      src={`${base}images/hero-bg-skyline.webp`}
      alt=""
      aria-hidden="true"
      class="h-full w-full object-cover object-center"
    />
  </div>

  <!-- Ровный синий тон поверх фото — лёгкий, фото должно просвечивать везде -->
  <div class="absolute inset-0 -z-10" style="background: rgba(8, 16, 30, 0.2);"></div>

  <!--
    Верхний градиент — ФИКСИРОВАННАЯ высота (не % от секции): держит зону
    заголовка/сабтайтла/кнопок монотонной независимо от того, насколько высокой
    окажется секция целиком (на мобиле карточки в столбик сильно растягивают
    общую высоту — % от неё "отъехал" бы слишком низко и часть текста осталась
    бы без подложки). Открывается быстрее, чем раньше, — фото должно быть
    хорошо видно, а не только угадываться за карточками.
  -->
  <div
    class="absolute inset-x-0 top-0 -z-10 h-[560px] md:h-[720px]"
    style="background: linear-gradient(180deg, #0B1830 0%, #0B1830 62%, rgba(11,24,48,.65) 85%, rgba(11,24,48,0) 100%);"
  ></div>

  <!-- Золотое свечение за карточками (screen-blend — только добавляет тепла, ничего не гасит) -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-64 mix-blend-screen md:h-80"
    style="background: radial-gradient(55% 90% at 50% 100%, rgba(199,162,75,.16), transparent 72%);"
  ></div>

  <!-- Нижний градиент: плавный выход в сплошной фон страницы (тоже фикс. высота) -->
  <div
    class="absolute inset-x-0 bottom-0 -z-10 h-32 md:h-40"
    style="background: linear-gradient(180deg, rgba(10,32,25,0) 0%, #0A2019 85%);"
  ></div>

  <!-- Контент -->
  <div class="container-page relative flex flex-col gap-16 pb-20 pt-36 md:gap-20 md:pb-28 md:pt-44">
    <div class="flex max-w-2xl flex-col gap-7">
      <h1 class="hero-title font-accent font-normal">
        <span class="block text-fg">Коммерческая недвижимость,</span>
        <span class="hero-title-gold block">открытая для частного инвестора</span>
      </h1>

      <p class="max-w-[30rem] font-accent text-lg leading-[1.4] tracking-[0.01em] text-text-soft md:text-xl">
        Объединяем капитал частных инвесторов и профессионально управляем коммерческими объектами
        Санкт-Петербурга — от подбора актива до дохода с квадратного метра.
      </p>

      <div class="flex flex-wrap gap-4 pt-2">
        <a href="#cta" class="hero-btn hero-btn--primary">Доступ к сделкам</a>
        <a href="#cta" class="hero-btn hero-btn--secondary">Передать объект в управление</a>
      </div>
    </div>

    <div class="grid gap-5 md:grid-cols-3">
      {cards.map((card) => (
        <div class="hero-card">
          <img src={`${base}icons/${card.icon}`} width="56" height="56" alt="" class="h-14 w-14 shrink-0" />
          <p class="font-accent text-[17px] leading-[1.4] tracking-[0.01em]">
            <span class="hero-card-gold">{card.lead}</span><span class="text-fg">{card.rest}</span>
          </p>
        </div>
      ))}
    </div>

    <!--
      Cookie-баннер: на мобильном — обычный блок в потоке после карточек (fixed
      поверх контента на узком экране перекрывал собой вторичную кнопку — её
      было физически не нажать, пока баннер не закрыт). От sm и шире места
      достаточно — там он всплывает fixed-плашкой снизу справа, как обычно
      делают cookie-баннеры.
    -->
    <div class="mx-auto w-fit sm:mx-0 sm:fixed sm:inset-x-auto sm:right-6 sm:bottom-6 sm:z-40 sm:w-auto">
      <CookieBanner />
    </div>
  </div>
</section>

<style>
  .hero-title {
    font-size: 2.75rem;
    line-height: 0.96;
    letter-spacing: -0.02em;
  }
  @media (min-width: 640px) {
    .hero-title {
      font-size: 3.75rem;
    }
  }
  @media (min-width: 768px) {
    .hero-title {
      font-size: 4.5rem;
    }
  }

  .hero-title-gold,
  .hero-card-gold {
    background-image: var(--gradient-gold);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-accent);
    font-size: 1rem;
    letter-spacing: -0.01em;
    padding: 1rem 2rem;
    border-radius: 999px;
    transition: transform 0.2s ease, filter 0.2s ease, background-color 0.2s ease, border-color 0.2s ease;
  }

  .hero-btn--primary {
    background-image: var(--gradient-gold);
    color: var(--color-on-gold);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.4), 0 14px 32px -14px rgba(199, 162, 75, 0.65);
  }
  .hero-btn--primary:hover {
    filter: brightness(1.08);
    transform: translateY(-1px);
  }

  .hero-btn--secondary {
    border: 1px solid rgba(199, 162, 75, 0.5);
    color: var(--color-accent-soft);
    /* Полупрозрачная тёмная подложка + блюр — кнопка лежит поверх фото, текст
       должен читаться независимо от того, что именно под ней на кадре. */
    background: rgba(8, 16, 30, 0.55);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }
  .hero-btn--secondary:hover {
    border-color: var(--color-accent-soft);
    background: rgba(8, 16, 30, 0.7);
    transform: translateY(-1px);
  }

  .hero-card {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: 1.75rem;
    border-radius: 16px;
    background: rgba(12, 42, 34, 0.55);
    border: 1px solid rgba(199, 162, 75, 0.25);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }
</style>
