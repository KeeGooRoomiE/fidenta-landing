---
/*
  УРОВЕНЬ 3 — БЛОК Hero (главный экран)
  Источник: Figma, файл Cz2upesn8p2Cd7cZTdg2WQ, узел 974:65347 (ручная правка пользователя)

  Раскладка (сверху вниз, высота = по контенту, БЕЗ принудительного min-h-screen —
  так и в Figma: секция ровно такая высокая, сколько нужно контенту):
   1. H1 + лид + кнопки (слева)
   2. Cookie-баннер — обычный блок в потоке, прижат вправо (НЕ fixed/overlay)
   3. Три плитки-преимущества
   4. Фото-полоса-переход внизу (продолжение воды, затем fade в фон страницы)

  Фон: одно фото Невы на весь блок (header+title+cookie+tiles), crop по спеке
  Figma (узел 974:64601): width 154.51% / height 163.84%, left -34.55% / top -1.34%
  относительно контейнера. Дополнительный слой «imgMain» в источнике — задвоенная
  подложка, полностью перекрытая этим фото сверху, поэтому не переносим (не видна).
*/
import CookieBanner from '../CookieBanner.astro';

const base = import.meta.env.BASE_URL;

// Плитки: иконка + текст, разбитый на gold-фразу (span1) и обычный остаток (span2).
const tiles = [
  { icon: 'tile-club.png', gold: 'Fidenta Invest Club - ', rest: 'закрытое сообщество' },
  { icon: 'tile-cycle.png', gold: 'Полный цикл сопровождения:', rest: 'аудит объекта - расчёт доходности', br: true },
  { icon: 'tile-ownership.png', gold: 'Реальное владение: ', rest: 'доля в объекте закреплена договором' },
];
---

<section class="relative overflow-hidden">
  <!-- ФОН: одно фото Невы на весь блок -->
  <div class="absolute inset-0 -z-10 overflow-hidden">
    <div class="absolute inset-0" style="background: #091832;"></div>
    <!-- Точный crop из Figma (узел 974:64601 «image 25») -->
    <img
      src={`${base}images/hero-bg.webp`}
      alt=""
      aria-hidden="true"
      class="absolute max-w-none"
      style="width: 154.51%; height: 163.84%; left: -34.55%; top: -1.34%;"
    />
    <!-- Затемнение верха — чтобы заголовок читался поверх фото -->
    <div class="absolute inset-0" style="background: linear-gradient(180deg, #091832 0%, #091832 28%, rgba(9, 24, 50, 0) 46%);"></div>
  </div>

  <!-- КОНТЕНТ: title → cookie → tiles, естественный поток сверху вниз -->
  <div class="container-page flex flex-col pb-10 pt-24 md:pt-32">
    <!-- Заголовок + лид + кнопки -->
    <div class="flex max-w-2xl flex-col gap-3">
      <!-- H1: Forum 64/0.89, трекинг -2%. Двухцветный. -->
      <h1 class="font-accent font-normal leading-[0.89] tracking-[-0.02em] text-[2.5rem] sm:text-5xl md:text-[64px]">
        <span class="block text-fg">Коммерческая недвижимость, </span>
        <span class="block text-gold-plate">открытая для частного инвестора</span>
      </h1>
      <!-- Лид: Forum 20/101.465%, tracking 0.2px, кремовый. -->
      <p class="max-w-[451px] font-accent text-xl leading-[1.015] tracking-[0.01em] text-fg">
        Объединяем капитал частных инвесторов и профессионально управляем коммерческими объектами
        Санкт-Петербурга — от подбора актива до дохода с квадратного метра.
      </p>
      <!-- Кнопки: primary (плат-заливка + inset-тень) / outline (сплошная кремовая рамка) -->
      <div class="mt-3 flex flex-wrap gap-1.5">
        <a href="#cta" class="btn-hero btn-plat hover:brightness-110">Доступ к сделкам</a>
        <a href="#cta" class="btn-hero btn-outline">
          <span class="text-gold-plate">Передать объект в управление</span>
        </a>
      </div>
    </div>

    <!-- Cookie-баннер: обычный блок в потоке, прижат вправо (по правке пользователя) -->
    <div class="mt-16 flex justify-end md:mt-24">
      <CookieBanner />
    </div>

    <!-- ПЛИТКИ: 1 колонка на мобиле, 3 на десктопе, gap 43px -->
    <div class="mt-8 grid gap-[43px] md:grid-cols-3">
      {tiles.map((tile) => (
        <div class="plat-card flex items-center gap-[30px] px-10 py-[30px]">
          <img src={`${base}icons/${tile.icon}`} width="63" height="58" alt="" class="h-14 w-auto shrink-0" />
          <!-- line-height 17px — фиксированный px из Figma (не проценты) -->
          <p class="font-accent text-[18px] tracking-[0.01em]" style="line-height: 17px;">
            <span class="text-gold-plate">{tile.gold}</span>{tile.br && <br />}<span class="text-fg">{tile.rest}</span>
          </p>
        </div>
      ))}
    </div>
  </div>

  <!-- ФОТО-ПОЛОСА-ПЕРЕХОД: продолжение воды (узел 2007:16618), с fade в фон страницы -->
  <div class="relative h-24 md:h-32">
    <img src={`${base}images/hero-bottom-strip.webp`} alt="" aria-hidden="true" class="h-full w-full object-cover" />
    <div class="absolute inset-0" style="background: linear-gradient(180deg, rgba(10, 32, 25, 0) 0%, #0A2019 100%);"></div>
  </div>
</section>
