---
const assets = `${import.meta.env.BASE_URL}images/hero/`;
const cards = [
  {
    title: 'Реальные объекты',
    description: 'Коммерческая недвижимость: действующие объекты, реконструкция, управление и развитие',
  },
  {
    title: 'Роль Фиденты',
    description: 'Аудит, подбор, организация, развитие и управление объектом, аналитика, платежи, расчёты и документы',
  },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-art" aria-hidden="true">
    <img
      id="hero-bg-image"
      src={`${assets}panorama.webp`}
      srcset={`${assets}panorama-small.webp 960w, ${assets}panorama.webp 2560w`}
      sizes="(max-width: 639px) 567px, 100vw"
      width="2560"
      height="1920"
      alt=""
      fetchpriority="high"
    />
  </div>

  <div class="hero-content">
    <div class="hero-copy">
      <h1 class="hero-title" id="hero-title">
        <span class="hero-subject">Коммерческая <span>недвижимость</span></span>
        <span class="hero-city"><span class="text-gold-plate">Санкт-Петербурга:</span></span>
        <span class="hero-title-line">инвестиции и управление</span>
      </h1>

      <p class="hero-intro">
        <span>Находим, развиваем и управляем коммерческими объектами</span>
        <span>Объединяем капитал, экспертизу и реальные активы в понятные проекты</span>
      </p>
    </div>

    <div class="hero-actions">
      <a href="#cta" data-cta-audience="investor" class="hero-btn hero-btn--primary">Обсудить инвестиции</a>
      <a href="#cta" data-cta-audience="owner" class="hero-btn hero-btn--secondary plat-outline">Я собственник</a>
    </div>

    <ul class="hero-cards">
      {cards.map(({ title, description }) => (
        <li class="plat-outline hero-card">
          <h2 class="text-gold-plate">{title}</h2>
          <p>{description}</p>
        </li>
      ))}
      <li class="plat-outline hero-card hero-news">
        <div>
          <h2 class="text-gold-plate">Смотрите за проектами Фидента</h2>
          <p>Новые объекты | Новости Фидента<br />В нашем канале «Архитектура Капитала»</p>
        </div>
        <a href="https://t.me/fidenta" aria-label="Открыть канал Фидента в Telegram">
          <picture>
            <source media="(min-width: 1024px)" srcset={`${assets}news-telegram.svg`} width="52" height="48" />
            <img src={`${assets}news-arrow.svg`} width="22" height="22" alt="" />
          </picture>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .hero {
    --hero-base: #071d17;
    position: relative;
    isolation: isolate;
    background: linear-gradient(var(--hero-base) 70%, var(--color-canvas));
    font-family: var(--font-accent);
    color: var(--color-fg);
    /* Согласуем масштаб первого экрана с шапкой на контрольной ширине 1440px. */
    zoom: calc(1 / var(--desktop-reference-zoom, 1));
  }

  .hero-art {
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 575px;
    pointer-events: none;
  }

  .hero-art img {
    position: absolute;
    inset: 83px 0 auto;
    width: 100%;
    height: 425px;
    object-fit: cover;
  }

  .hero-art::before,
  .hero-art::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .hero-art::before {
    z-index: 1;
    opacity: 0.64;
    background:
      linear-gradient(180deg, var(--hero-base) 26%, rgba(7, 29, 23, 0.1) 48%, rgba(7, 29, 23, 0.2) 72%, var(--hero-base)),
      linear-gradient(90deg, rgba(7, 29, 23, 0.83), rgba(7, 29, 23, 0.756) 34.527%, rgba(7, 29, 23, 0.35) 52%, transparent);
    background-size: 100% 480px;
    background-position: 0 83px;
    background-repeat: no-repeat;
  }

  .hero-art::after {
    z-index: 2;
    background:
      linear-gradient(180deg, var(--hero-base) 22%, rgba(7, 29, 23, 0.84) 48%, rgba(7, 29, 23, 0.38) 73%, transparent) left top 58px / 100% 190px no-repeat,
      linear-gradient(180deg, rgba(7, 21, 52, 0.28), rgba(5, 15, 33, 0.08) 62%, rgba(1, 3, 5, 0.01)) left top 83px / 100% 492px no-repeat,
      linear-gradient(180deg, transparent, rgba(7, 29, 23, 0.08) 18%, rgba(7, 29, 23, 0.38) 40%, rgba(7, 29, 23, 0.79) 64%, rgba(7, 29, 23, 0.96) 82%, var(--hero-base) 100%) left top 330px / 100% 245px no-repeat;
  }

  .hero-content {
    width: calc(100% - 40px);
    max-width: 1280px;
    margin-inline: auto;
    padding-block: 334px 80px;
  }

  .hero-copy {
    padding-inline: 4px;
  }

  .hero-title {
    font-size: clamp(26px, 7.7vw, 30px);
    line-height: 1.07;
  }

  .hero-subject,
  .hero-subject > span,
  .hero-city,
  .hero-title-line,
  .hero-intro > span {
    display: block;
  }

  .hero-title .text-gold-plate {
    --gradient-gold: linear-gradient(169deg, rgba(255, 241, 217, 0.87) 25.714%, rgba(168, 133, 72, 0.87) 120.56%);
  }

  .hero-intro {
    max-width: 260px;
    margin-top: 24px;
    font-size: 16px;
    line-height: 1.22;
    color: #dedede;
  }

  .hero-actions {
    display: grid;
    gap: 13px;
    margin-top: 26px;
  }

  .hero-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    padding: 8px 12px;
    border-radius: 9px;
    font-size: 20px;
    line-height: 1.22;
    text-align: center;
    transition: filter 0.2s ease;
  }

  .hero-btn:hover {
    filter: brightness(1.14);
  }

  .hero-btn--primary {
    color: #000;
    background: linear-gradient(172deg, rgba(255, 241, 217, 0.87) 25.714%, rgba(168, 133, 72, 0.87) 120.56%);
  }

  .hero-btn--secondary {
    color: var(--color-fg);
    background: var(--color-cta-dark);
  }

  .hero-cards {
    display: grid;
    gap: 12px;
    margin-top: 62px;
    list-style: none;
  }

  .hero-card {
    min-height: 106px;
    padding: 11px 17px;
    border-radius: 9px;
    background: var(--color-tile);
  }

  .hero-card h2 {
    --gradient-gold: linear-gradient(177deg, rgba(255, 241, 217, 0.87) 25.714%, rgba(168, 133, 72, 0.87) 120.56%);
    font-size: 17px;
    line-height: 1.22;
  }

  .hero-card p {
    margin-top: 3px;
    font-size: 16px;
    line-height: 1.22;
  }

  .hero-news {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 8px;
    padding-right: 22px;
  }

  .hero-news > a {
    display: grid;
    min-height: 44px;
    place-items: center end;
    min-width: 32px;
    flex: none;
    align-self: center;
  }

  @media (min-width: 640px) {
    .hero-art {
      height: 675px;
    }

    .hero-art img {
      inset-block: 104px 0;
      height: calc(100% - 104px);
    }

    .hero-art::before {
      content: none;
    }

    .hero-art::after {
      background:
        linear-gradient(180deg, rgba(7, 21, 52, 0.62), rgba(5, 15, 33, 0.22) 62%, rgba(1, 3, 5, 0.01)),
        linear-gradient(180deg, var(--hero-base) 26%, rgba(7, 29, 23, 0.1) 48%, rgba(7, 29, 23, 0.2) 72%, var(--hero-base)),
        linear-gradient(90deg, rgba(7, 29, 23, 0.83), rgba(7, 29, 23, 0.756) 34.527%, rgba(7, 29, 23, 0.35) 52%, transparent);
    }

    .hero-content {
      width: calc(100% - 2 * clamp(32px, 5.556%, 80px));
      padding-top: 260px;
    }

    .hero-copy {
      padding-inline: 0;
    }

    .hero-title {
      font-size: clamp(36px, 5.2vw, 48px);
    }

    .hero-subject > span {
      display: inline;
    }

    .hero-intro {
      max-width: 620px;
      font-size: 18px;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 20px;
    }

    .hero-btn--primary {
      min-width: 250px;
    }

    .hero-btn--secondary {
      min-width: 185px;
    }

    .hero-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin-top: 64px;
      @media (width < 768px) {
        margin-top: 90px;
      }
    }

    .hero-news {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .hero-art {
      height: 942px;
    }

    .hero-art img {
      inset-block-start: 173px;
      height: calc(100% - 173px);
    }

    .hero-content {
      padding-block: 232px 94px;
    }

    .hero-title {
      font-size: clamp(44px, 3.889vw, 56px);
    }

    .hero-intro {
      max-width: 642px;
      margin-top: 28px;
      font-size: 20px;
    }

    .hero-btn {
      padding-inline: 30px;
    }

    .hero-btn--primary {
      min-width: 300px;
    }

    .hero-btn--secondary {
      min-width: 213px;
    }

    .hero-cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      margin-top: clamp(96px, 9.93vw, 143px);
    }

    .hero-card {
      min-height: 120px;
      padding: 19px;
      background: var(--hero-card-surface);
    }

    .hero-card h2 {
      font-size: 20px;
    }

    .hero-card p {
      margin-top: 10px;
      color: #dedede;
    }

    .hero-news {
      grid-column: auto;
      padding-right: clamp(19px, 2.5vw, 36px);
    }
  }

  @media (1024px <= width < 1200px) {
    .hero-art {
      height: 780px;
    }

    .hero-art img {
      inset-block-start: 125px;
      height: calc(100% - 125px);
    }

    .hero-content {
      padding-block: 196px 64px;
    }

    .hero-cards {
      gap: 16px;
      margin-top: 64px;
    }

    .hero-card {
      padding: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-btn {
      transition: none;
    }
  }
</style>
