---
/*
  УРОВЕНЬ 3 — БЛОК Footer (подвал)
  Источник: Figma, узел 974:64669 («block 14 Futer») — сверено с макетом.

  Структура сверху вниз:
   1. Верхний ряд (3 колонки): навигация · логотип + телефон · «Наверх» и офис
   2. Дисклеймер-оферта + ссылка «Проектная документация»
   3. Ряд соц-иконок: слева видео-платформы, справа мессенджеры
   4. Копирайт + правовые ссылки (одна строка)
   5. Полный дисклеймер в блоке со своей прокруткой (в макете — полоса скролла справа)

  Мягкий переход от тёмно-зелёного фона страницы к фону футера (#101612) сделан
  градиентом в верхних ~80px самого футера (в Figma он заходит на предыдущий
  блок на 138px — у нас так нельзя, перекрыл бы его контент).

  Логотип — 3 SVG-экспорта из Figma (мост, надпись «ФИДЕНТА», «архитектура
  капитала»), собираем в колонку, как в макете (ширина 340px).

  Кнопка «Построить маршрут» берёт координаты первой точки из data/locations.ts
  и открывает маршрут в Яндекс Картах от местоположения пользователя
  (то же, что и в блоке «Контакты»).

  Ссылки на юр. документы — заглушки (#), страницы появятся позже.
  Соц-ссылки — заглушки (#): реальные адреса дадим, когда пришлёт клиент.
*/
import { locations } from '../../data/locations';
import { nav, office as officeInfo, phones } from '../../data/site';

const base = import.meta.env.BASE_URL;

// Правовые ссылки (нижний бар). TODO: заменить href на реальные страницы документов.
const legalLinks = [
  'Политика конфиденциальности',
  'Согласие на обработку персональных данных',
  'Пользовательское соглашение',
];

// Соц-иконки (PNG уже содержат рамку и золотой глиф — выводим как есть)
const socialLeft = [
  { icon: 'youtube.png', label: 'YouTube', href: '#' },
  { icon: 'rutube.png', label: 'Rutube', href: '#' },
  { icon: 'instagram.png', label: 'Instagram', href: '#' },
];
const socialRight = [
  { icon: 'max.png', label: 'MAX', href: '#' },
  { icon: 'whatsapp.png', label: 'WhatsApp', href: '#' },
  { icon: 'telegram.png', label: 'Telegram', href: '#' },
];

// Маршрут до офиса (первая точка из data/locations.ts); «откуда» не задаём —
// Яндекс берёт местоположение пользователя
const office = locations[0];
const routeHref = `https://yandex.ru/maps/?rtext=~${office.lat},${office.lng}&rtt=auto`;

const year = new Date().getFullYear();
---

<footer class="relative bg-footer font-accent text-sand">
  {/* Плавный переход от фона страницы к фону футера */}
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-[81px]"
    style="background-image: linear-gradient(180deg, var(--color-canvas) 0%, #0d1b16 47%, var(--color-footer) 100%);"
    aria-hidden="true"
  >
  </div>

  <div class="container-page relative pb-6 pt-[107px]">
    {/* 1. ВЕРХНИЙ РЯД */}
    <div class="grid gap-12 lg:grid-cols-[1fr_340px_1fr] lg:items-start">
      {/* Навигация */}
      <nav class="flex flex-col gap-3.5 text-xl">
        {nav.map((link) => (
          <a href={link.href} class="w-fit transition-colors hover:text-gold-hi">{link.label}</a>
        ))}
      </nav>

      {/* Логотип + телефон */}
      <div class="mx-auto flex w-[340px] max-w-full flex-col items-center gap-3.5">
        <div class="flex w-full flex-col gap-[33px]">
          <img src={`${base}images/footer-bridge.svg`} loading="lazy" decoding="async" alt="" width="340" height="158" class="w-full" />
          <img src={`${base}images/footer-wordmark.svg`} loading="lazy" decoding="async" alt="Фидента" width="340" height="56" class="w-full" />
        </div>
        <div class="flex items-start gap-[11px]">
          <img src={`${base}images/footer-tagline-1.svg`} loading="lazy" decoding="async" alt="" width="147" height="21" class="h-[20.5px] w-[147px]" />
          <img src={`${base}images/footer-tagline-2.svg`} loading="lazy" decoding="async" alt="" width="105" height="14" class="h-[13.8px] w-[105px]" />
        </div>
        <a href={phones.footer.href} class="mt-6 whitespace-nowrap text-[40px] leading-none transition-colors hover:text-gold-hi">
          {phones.footer.text}
        </a>
      </div>

      {/* «Наверх» + офис */}
      <div class="flex flex-col gap-[71px] text-xl lg:items-end lg:text-right">
        <a href="#top" class="w-fit uppercase transition-colors hover:text-gold-hi">Наверх</a>
        <div class="flex flex-col gap-3.5 lg:items-end">
          <div>
            <p>офис продаж</p>
            <p class="mt-5 lg:whitespace-nowrap">{officeInfo.full}</p>
          </div>
          <a
            href={routeHref}
            target="_blank"
            rel="noopener noreferrer"
            class="w-[233px] rounded-[9px] border border-slate px-3.5 py-2.5 text-center transition-colors hover:border-cream"
            style="text-shadow: 0 4px 4px rgba(0,0,0,0.11);"
          >
            Построить маршрут
          </a>
        </div>
      </div>
    </div>

    {/* 2. ДИСКЛЕЙМЕР-ОФЕРТА + ПРОЕКТНАЯ ДОКУМЕНТАЦИЯ */}
    <p class="mx-auto mt-16 max-w-[963px] text-center text-xl leading-normal lg:mt-24">
      Любая информация, представленная на данном сайте, носит исключительно информационный характер и ни при каких
      условиях не является публичной офертой, определяемой положениями статьи 437 ГК РФ
    </p>
    <div class="mt-9 text-center">
      <a
        href="#"
        class="text-xl underline decoration-double decoration-[0.5px] decoration-sand/50 underline-offset-[5px] transition-colors hover:text-gold-hi"
      >
        Проектная документация
      </a>
    </div>

    {/* 3. СОЦ-ИКОНКИ: два кластера */}
    <div class="mt-9 flex items-center justify-between">
      <div class="flex gap-3">
        {socialLeft.map((s) => (
          <a href={s.href} aria-label={s.label} class="transition-opacity hover:opacity-80">
            <img src={`${base}icons/${s.icon}`} loading="lazy" decoding="async" width="50" height="50" alt={s.label} class="size-[50px]" />
          </a>
        ))}
      </div>
      <div class="flex gap-3">
        {socialRight.map((s) => (
          <a href={s.href} aria-label={s.label} class="transition-opacity hover:opacity-80">
            <img src={`${base}icons/${s.icon}`} loading="lazy" decoding="async" width="50" height="50" alt={s.label} class="size-[50px]" />
          </a>
        ))}
      </div>
    </div>

    {/* 4. КОПИРАЙТ + ПРАВОВЫЕ ССЫЛКИ */}
    <div class="mt-5 flex flex-col gap-3 border-t border-canvas pt-3 lg:flex-row lg:items-center lg:justify-between">
      <p class="text-xs leading-[19px]">© 2013–{year} ООО «УК Фидента». Все права защищены.</p>
      <div class="flex flex-wrap gap-x-10 gap-y-2 text-sm leading-[19px] lg:gap-x-[60px]">
        {legalLinks.map((link) => (
          <a href="#" class="transition-colors hover:text-gold-hi">{link}</a>
        ))}
      </div>
    </div>

    {/* 5. ПОЛНЫЙ ДИСКЛЕЙМЕР: свой скролл (в макете справа — полоса прокрутки) */}
    <div class="footer-disclaimer mt-4 max-h-[97px] overflow-y-auto pb-7 pr-[9px] pt-3 text-[15px] leading-[1.1] tracking-[-0.02em] text-fg" tabindex="0">
      <p>Дисклеймер</p>
      <p>
        Вся информация, представленная на сайте, включая характеристики объектов, цены, сроки окупаемости и
        ориентировочные показатели доходности, носит исключительно справочный характер и не является публичной офертой
        в соответствии со ст. 437 ГК РФ. Приведённые расчёты окупаемости являются прогнозными, основаны на допущениях и
        рыночной конъюнктуре на момент публикации, не гарантируются и могут изменяться. Инвестиции в коммерческую
        недвижимость связаны с рисками, в том числе риском снижения стоимости актива, простоя помещений, изменения
        арендных ставок и законодательства. Решение об инвестировании принимается самостоятельно, инвестор несёт все
        связанные с ним риски. Точные условия сделки и параметры объектов уточняйте у наших специалистов.
      </p>
    </div>
  </div>
</footer>

<style is:global>
  /* Полоса прокрутки дисклеймера: «таблетка» 12px с серым градиентом, как в Figma */
  .footer-disclaimer {
    scrollbar-width: thin;
    scrollbar-color: #5a5b55 transparent;
  }
  .footer-disclaimer::-webkit-scrollbar {
    width: 12px;
  }
  .footer-disclaimer::-webkit-scrollbar-track {
    background: transparent;
  }
  .footer-disclaimer::-webkit-scrollbar-thumb {
    border-radius: 9px;
    background-image: linear-gradient(90deg, var(--color-slate), #4a4b45 47%, #63645c);
  }
</style>
