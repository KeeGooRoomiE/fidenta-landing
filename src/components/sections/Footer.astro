---
import { nav, office, phones } from '../../data/site';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const [officeCity, officeStreet] = office.full.split(', ');
const footerNav = [...nav];
footerNav.splice(3, 0, { label: 'Услуги', href: '#comparison' });
const disclaimer = 'Вся информация, представленная на сайте, включая характеристики объектов, цены, сроки окупаемости и ориентировочные показатели доходности, носит исключительно справочный характер и не является публичной офертой в соответствии со ст. 437 ГК РФ. Приведённые расчёты окупаемости являются прогнозными, основаны на допущениях и рыночной конъюнктуре на момент публикации, не гарантируются и могут изменяться. Инвестиции в коммерческую недвижимость связаны с рисками, в том числе риском снижения стоимости актива, простоя помещений, изменения арендных ставок и законодательства. Решение об инвестировании принимается самостоятельно, инвестор несёт все связанные с ним риски. Точные условия сделки и параметры объектов уточняйте у наших специалистов.';
const media = [
  { label: 'YouTube', file: 'footer-component19.svg', size: 50 },
  { label: 'Rutube', file: 'footer-group2.svg', size: 45 },
];
const messengers = [
  { label: 'MAX', file: 'footer-maxcolorbackground.svg', size: 30 },
  { label: 'Telegram', file: 'footer-frame456.svg', size: 50 },
];
const legal = [
  'Политика обработки персональных данных',
  'Согласие на обработку персональных данных',
  'Правовая информация',
];
---

<footer class="footer-preview font-accent text-sand">
  <div class="container-page footer-inner pb-8 pt-16 lg:pt-[107px]">
    <div class="footer-top grid gap-8 lg:items-start lg:gap-10">
      <a href="#top" class="footer-top-link plat-outline rounded-[9px] px-6 py-2.5 uppercase hover:bg-white/5"><span class="text-gold-plate">Наверх <span class="hidden lg:inline" aria-hidden="true">↑</span></span></a>
      <nav class="footer-navigation grid grid-cols-2 gap-3.5 text-xl lg:flex lg:flex-col" aria-label="Навигация в подвале">
        {footerNav.map(({href, label}) => <a href={href} class="text-gold-plate w-fit hover:underline">{label}</a>)}
      </nav>

      <div class="footer-brand mx-auto flex min-w-0 max-w-full flex-col items-center gap-3">
        <img src={`${base}icons/footer-frame4541.svg`} loading="lazy" decoding="async" alt="Фидента — архитектура капитала" width="341" height="282" class="h-auto max-w-full" />
        <a href={phones.header.href} class="text-gold-plate whitespace-nowrap text-[clamp(28px,7vw,40px)] leading-none">{phones.header.text}</a>
        <p class="footer-mobile-address text-gold-plate text-center text-lg leading-tight lg:hidden">{officeCity},<br />{officeStreet}</p>
      </div>

      <div class="footer-office hidden flex-col items-end text-right text-xl lg:flex">
        <div>
          <p class="text-gold-plate"><span class="lg:hidden">офис продаж</span><span class="hidden lg:inline">Офис компании Фидента</span></p>
          <p class="mt-3 text-gold-plate">{officeCity},<br class="lg:hidden" /> {officeStreet}</p>
        </div>
      </div>
    </div>

    <p class="footer-description mx-auto mt-12 max-w-[900px] text-center text-lg leading-snug text-copy lg:mt-20 lg:text-xl">Фидента работает с коммерческой недвижимостью Санкт-Петербурга и Ленинградской области: инвестиционные проекты, аренда<span class="lg:hidden"> и управление.</span><span class="hidden lg:inline">, управление и развитие объектов.</span></p>

    <div class="footer-documents mt-9 flex flex-col items-center text-xl">
      <span>Проектная документация</span>
      <span class="mt-0.5 h-px w-[213px] bg-gold-line" aria-hidden="true"></span>
    </div>

    <div class="footer-socials mt-4 flex flex-wrap justify-between gap-3">
      <div class="flex gap-2 md:gap-3">
        {media.map(({ label, file, size }) => (
          <span class="footer-icon plat-outline grid size-10 place-items-center rounded-[9px] bg-canvas sm:size-[50px]">
            <span class:list={[label === 'Rutube' && 'rutube-clip']} style={label === 'Rutube' ? `--rutube-mask: url(${base}icons/footer-group1.svg)` : undefined}>
              <img src={`${base}icons/${file}`} alt={label} width={size} height={size} loading="lazy" />
            </span>
          </span>
        ))}
      </div>
      <div class="flex gap-2 md:gap-3">
        {messengers.map(({ label, file, size }) => {
          const Tag = label === 'Telegram' ? 'a' : 'span';
          return (
            <Tag href={label === 'Telegram' ? 'https://t.me/fidenta' : undefined} class="footer-icon plat-outline grid size-10 place-items-center rounded-[9px] bg-canvas sm:size-[50px]">
              <img src={`${base}icons/${file}`} alt={label} width={size} height={size} loading="lazy" />
            </Tag>
          );
        })}
      </div>
    </div>

    <div class="footer-legal mt-3 flex flex-col gap-3 border-t border-canvas pt-4 text-sm text-legal lg:flex-row lg:items-center lg:justify-between">
      <p>© 2013–{year} ООО «УК Фидента». Все права защищены.</p>
      <div class="footer-legal-links flex flex-wrap gap-x-7 gap-y-2">
        {legal.map(label => <span>{label}</span>)}
      </div>
    </div>

    <div class="mt-4 hidden text-[15px] leading-snug text-legal lg:block">
      <p>Дисклеймер</p>
      <p>{disclaimer}</p>
    </div>
    <div class="footer-disclaimer text-sm leading-snug text-legal lg:hidden">
      <p>Инвестиции в коммерческую недвижимость связаны с рисками. Прогнозы и расчёты не гарантируют результат. Информация не является публичной офертой.</p>
      <details>
        <summary class="plat-outline mt-5 cursor-pointer rounded-[9px] bg-[#0b1b16] px-3 py-3 text-center text-lg">
          <span class="text-gold-plate when-closed">Читать полный дисклеймер ↓</span>
          <span class="text-gold-plate when-open">Свернуть дисклеймер ↑</span>
        </summary>
        <p class="mt-4">{disclaimer}</p>
      </details>
    </div>
  </div>
</footer>

<style>
  .footer-preview { background: linear-gradient(#061e17, #101612 86px); }
  .footer-top { grid-template-areas: 'top' 'navigation' 'brand' 'office'; }
  .footer-top-link { grid-area: top; justify-self: center; }
  .footer-brand { grid-area: brand; }
  .footer-navigation { grid-area: navigation; }
  .footer-office { grid-area: office; }
  .footer-icon { overflow: hidden; }
  .rutube-clip { position: relative; display: block; width: 30px; height: 30px; mask-image: var(--rutube-mask); }
  .rutube-clip img { position: absolute; max-width: none; top: -15px; }
  .footer-disclaimer summary { list-style: none; }
  .footer-disclaimer summary::-webkit-details-marker { display: none; }
  .footer-disclaimer .when-open, .footer-disclaimer details[open] .when-closed { display: none; }
  .footer-disclaimer details[open] .when-open { display: inline; }
  @media (width < 1024px) {
    .footer-preview { background: #101612; }
    .footer-inner { padding-bottom: 58px; }
    .footer-top { grid-template-areas: 'top' 'navigation' 'brand'; gap: 24px; padding-top: 22px; border-top: 1px solid rgb(87 92 79 / 80%); }
    .footer-top-link { padding: 7px 18px; font-size: 16px; }
    .footer-navigation { grid-template-rows: repeat(3, auto); grid-auto-flow: column; gap: 8px 18px; grid-template-columns: 1fr auto; }
    .footer-brand { width: 100%; gap: 21px; }
    .footer-brand a { font-size: 28px; }
    .footer-mobile-address { margin-top: -7px; }
    .footer-description { max-width: 31ch; margin-top: 24px; font-size: 15px; }
    .footer-documents { margin-top: 9px; }
    .footer-socials { justify-content: center; margin-top: 46px; gap: 8px; }
    .footer-legal { margin-top: 22px; border-color: rgb(87 92 79 / 80%); }
    .footer-legal-links { display: grid; padding-top: 14px; border-top: 1px solid rgb(87 92 79 / 80%); }
    .footer-disclaimer { margin-top: 28px; padding-top: 20px; border-top: 1px solid rgb(87 92 79 / 80%); }
  }
  @media (min-width: 1024px) {
    .footer-top { grid-template-areas: 'navigation brand office'; grid-template-columns: minmax(0, 1fr) 341px minmax(0, 1fr); }
    .footer-top-link { grid-area: office; justify-self: end; align-self: start; }
    .footer-office { padding-top: 128px; }
  }
</style>
