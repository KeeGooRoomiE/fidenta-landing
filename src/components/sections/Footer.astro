---
import { nav, office, phones } from '../../data/site';

const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const media = [
  { label: 'YouTube', file: 'footer-component19.svg', size: 50 },
  { label: 'Rutube', file: 'footer-group2.svg', size: 45 },
];
const messengers = [
  { label: 'MAX', file: 'footer-maxcolorbackground.svg', size: 30 },
  { label: 'Telegram', file: 'footer-frame456.svg', size: 50 },
];
const legal = [
  'Политика обработки персональных данных',
  'Согласие на обработку персональных данных',
  'Правовая информация',
];
---

<footer class="footer-preview font-accent text-sand">
  <div class="container-page pb-8 pt-16 lg:pt-[107px]">
    <div class="footer-top grid gap-8 lg:items-start lg:gap-10">
      <nav class="footer-navigation grid grid-cols-2 gap-3.5 text-xl lg:flex lg:flex-col" aria-label="Навигация в подвале">
        {nav.map(({href, label}) => <a href={href} class="text-gold-plate w-fit hover:underline">{label}</a>)}
      </nav>

      <div class="footer-brand mx-auto flex min-w-0 max-w-full flex-col items-center gap-3">
        <img src={`${base}icons/footer-frame4541.svg`} loading="lazy" decoding="async" alt="Фидента — архитектура капитала" width="341" height="282" class="h-auto max-w-full" />
        <a href={phones.header.href} class="text-gold-plate whitespace-nowrap text-[clamp(28px,7vw,40px)] leading-none">{phones.header.text}</a>
      </div>

      <div class="footer-office flex flex-col items-start gap-5 text-xl lg:items-end lg:gap-18 lg:text-right">
        <a href="#top" class="plat-outline rounded-[9px] px-6 py-2.5 uppercase hover:bg-white/5">Наверх ↑</a>
        <div>
          <p class="text-gold-plate">Офис компании Фидента</p>
          <p class="mt-3 text-gold-plate">{office.full}</p>
        </div>
      </div>
    </div>

    <p class="mx-auto mt-12 max-w-[900px] text-center text-lg leading-snug text-gold-plate lg:mt-20 lg:text-xl">Фидента работает с коммерческой недвижимостью Санкт-Петербурга и Ленинградской области: инвестиционные проекты, аренда, управление и развитие объектов.</p>

    <div class="mt-9 flex flex-col items-center text-xl">
      <span>Проектная документация</span>
      <span class="mt-0.5 h-px w-[213px] bg-gold-line" aria-hidden="true"></span>
    </div>

    <div class="mt-4 flex flex-wrap justify-between gap-3">
      <div class="flex gap-2 md:gap-3">
        {media.map(({ label, file, size }) => (
          <span class="footer-icon plat-outline grid size-10 place-items-center rounded-[9px] bg-canvas sm:size-[50px]">
            <span class:list={[label === 'Rutube' && 'rutube-clip']} style={label === 'Rutube' ? `--rutube-mask: url(${base}icons/footer-group1.svg)` : undefined}>
              <img src={`${base}icons/${file}`} alt={label} width={size} height={size} loading="lazy" />
            </span>
          </span>
        ))}
      </div>
      <div class="flex gap-2 md:gap-3">
        {messengers.map(({ label, file, size }) => {
          const Tag = label === 'Telegram' ? 'a' : 'span';
          return (
            <Tag href={label === 'Telegram' ? 'https://t.me/fidenta' : undefined} class="footer-icon plat-outline grid size-10 place-items-center rounded-[9px] bg-canvas sm:size-[50px]">
              <img src={`${base}icons/${file}`} alt={label} width={size} height={size} loading="lazy" />
            </Tag>
          );
        })}
      </div>
    </div>

    <div class="mt-3 flex flex-col gap-3 border-t border-canvas pt-4 text-sm lg:flex-row lg:items-center lg:justify-between">
      <p>© 2013–{year} ООО «УК Фидента». Все права защищены.</p>
      <div class="flex flex-wrap gap-x-7 gap-y-2">
        {legal.map(label => <span>{label}</span>)}
      </div>
    </div>

    <div class="mt-4 text-xs leading-snug text-fg md:text-[15px]">
      <p>Дисклеймер</p>
      <p>Вся информация, представленная на сайте, включая характеристики объектов, цены, сроки окупаемости и ориентировочные показатели доходности, носит исключительно справочный характер и не является публичной офертой в соответствии со ст. 437 ГК РФ. Приведённые расчёты окупаемости являются прогнозными, основаны на допущениях и рыночной конъюнктуре на момент публикации, не гарантируются и могут изменяться. Инвестиции в коммерческую недвижимость связаны с рисками, в том числе риском снижения стоимости актива, простоя помещений, изменения арендных ставок и законодательства. Решение об инвестировании принимается самостоятельно, инвестор несёт все связанные с ним риски. Точные условия сделки и параметры объектов уточняйте у наших специалистов.</p>
    </div>
  </div>
</footer>

<style>
  .footer-preview { background: linear-gradient(#061e17, #101612 86px); }
  .footer-top { grid-template-areas: 'brand' 'navigation' 'office'; }
  .footer-brand { grid-area: brand; }
  .footer-navigation { grid-area: navigation; }
  .footer-office { grid-area: office; }
  .footer-icon { overflow: hidden; }
  .rutube-clip { position: relative; display: block; width: 30px; height: 30px; mask-image: var(--rutube-mask); }
  .rutube-clip img { position: absolute; max-width: none; top: -15px; }
  @media (min-width: 1024px) {
    .footer-top { grid-template-areas: 'navigation brand office'; grid-template-columns: minmax(0, 1fr) 341px minmax(0, 1fr); }
  }
</style>
