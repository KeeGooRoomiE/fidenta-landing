---
/*
  УРОВЕНЬ 3 — БЛОК Footer (подвал)

  Собран по финальному визуалу из Figma. Структура сверху вниз:
   1. Верхний ряд (3 колонки): нав-ссылки · лого+телефон · контакты офиса
   2. Короткий дисклеймер-оферта + ссылка «Проектная документация»
   3. Ряд соц-иконок (два кластера)
   4. Копирайт + правовые ссылки
   5. Полный дисклеймер (мелкий)

  Ассеты (public/): логотип-локап и 6 соц-иконок — реальные экспорты из Figma.
*/
import Button from '../ui/Button.astro';

const base = import.meta.env.BASE_URL;

// Навигация подвала (левая колонка). href — на якоря секций, где уместно.
const navLinks = [
  { label: 'О компании', href: '#why' },
  { label: 'Инвестиции', href: '#portfolio' },
  { label: 'Услуги', href: '#why' },
  { label: 'Объекты', href: '#portfolio' },
  { label: 'Вопросы', href: '#faq' },
  { label: 'Контакты', href: '#cta' },
];

// Правовые ссылки (нижний бар). TODO: заменить href на реальные страницы документов.
const legalLinks = [
  'Политика конфиденциальности',
  'Согласие на обработку персональных данных',
  'Пользовательское соглашение',
];

// Соц-иконки. Файлы уже содержат рамку и золотой глиф — выводим как есть.
// Два кластера, как в макете: слева видео/соцсети, справа мессенджеры.
const socialLeft = [
  { icon: 'youtube.png', label: 'YouTube', href: '#' },
  { icon: 'rutube.png', label: 'Rutube', href: '#' },
  { icon: 'instagram.png', label: 'Instagram', href: '#' },
];
const socialRight = [
  { icon: 'max.png', label: 'MAX', href: '#' },
  { icon: 'whatsapp.png', label: 'WhatsApp', href: '#' },
  { icon: 'telegram.png', label: 'Telegram', href: '#' },
];

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-canvas">
  <div class="container-page py-16">
    <!-- ВЕРХНИЙ РЯД: нав · лого+телефон · контакты -->
    <div class="grid gap-12 lg:grid-cols-3 lg:items-start">
      <!-- Колонка 1: навигация -->
      <nav class="flex flex-col gap-3">
        {navLinks.map((link) => (
          <a href={link.href} class="text-base text-fg/90 transition-colors hover:text-accent">{link.label}</a>
        ))}
      </nav>

      <!-- Колонка 2: логотип + телефон (по центру) -->
      <div class="flex flex-col items-center text-center">
        <img
          src={`${base}images/logo-footer.png`}
          width="170"
          height="140"
          alt="Фидента — архитектура капитала"
          class="w-40 h-auto"
        />
        <a href="tel:+79002242400" class="mt-4 font-display text-2xl tracking-wide text-fg hover:text-accent">
          +7-900-224-24-00
        </a>
      </div>

      <!-- Колонка 3: контакты офиса (справа) -->
      <div class="flex flex-col gap-2 lg:items-end lg:text-right">
        <a href="#" class="self-start text-xs uppercase tracking-[0.2em] text-muted hover:text-accent lg:self-end">Наверх ↑</a>
        <p class="mt-4 text-xs uppercase tracking-[0.2em] text-muted">офис продаж</p>
        <p class="text-text-soft">Санкт-Петербург,<br />Богатырский 18 к 4 ст2</p>
        <Button variant="secondary" href="#" class="mt-2">Построить маршрут</Button>
      </div>
    </div>

    <!-- КОРОТКИЙ ДИСКЛЕЙМЕР-ОФЕРТА -->
    <p class="mx-auto mt-16 max-w-3xl text-center text-sm leading-relaxed text-muted">
      Любая информация, представленная на данном сайте, носит исключительно информационный характер
      и ни при каких условиях не является публичной офертой, определяемой положениями статьи 437 ГК РФ.
    </p>
    <div class="mt-4 text-center">
      <a href="#" class="text-sm text-accent underline underline-offset-4 hover:text-accent-soft">Проектная документация</a>
    </div>

    <!-- СОЦ-ИКОНКИ: два кластера -->
    <div class="mt-12 flex flex-wrap items-center justify-between gap-6 border-t border-border pt-10">
      <div class="flex gap-3">
        {socialLeft.map((s) => (
          <a href={s.href} aria-label={s.label} class="transition-opacity hover:opacity-80">
            <img src={`${base}icons/${s.icon}`} width="44" height="44" alt={s.label} class="h-11 w-11" />
          </a>
        ))}
      </div>
      <div class="flex gap-3">
        {socialRight.map((s) => (
          <a href={s.href} aria-label={s.label} class="transition-opacity hover:opacity-80">
            <img src={`${base}icons/${s.icon}`} width="44" height="44" alt={s.label} class="h-11 w-11" />
          </a>
        ))}
      </div>
    </div>

    <!-- КОПИРАЙТ + ПРАВОВЫЕ ССЫЛКИ -->
    <div class="mt-8 flex flex-col gap-4 text-sm text-muted lg:flex-row lg:items-center lg:justify-between">
      <p>© 2013–{year} ООО «УК Фидента». Все права защищены.</p>
      <div class="flex flex-wrap gap-x-6 gap-y-2">
        {legalLinks.map((link) => (
          <a href="#" class="transition-colors hover:text-accent">{link}</a>
        ))}
      </div>
    </div>

    <!-- ПОЛНЫЙ ДИСКЛЕЙМЕР -->
    <div class="mt-10 border-t border-border pt-6">
      <p class="text-xs font-semibold uppercase tracking-wider text-muted">Дисклеймер</p>
      <p class="mt-2 text-xs leading-relaxed text-muted/80">
        Вся информация, представленная на сайте, включая характеристики объектов, цены, сроки окупаемости
        и ориентировочные показатели доходности, носит исключительно справочный характер и не является
        публичной офертой в соответствии со ст. 437 ГК РФ. Приведённые расчёты окупаемости являются
        прогнозными, основаны на допущениях и рыночной конъюнктуре на момент публикации, не гарантируются
        и могут изменяться. Инвестиции в коммерческую недвижимость связаны с рисками, в том числе риском
        снижения стоимости актива, простоя помещений, изменения арендных ставок и законодательства.
        Решение об инвестировании принимается самостоятельно, инвестор несёт все связанные с ним риски.
        Точные условия сделки и параметры объектов уточняйте у наших специалистов.
      </p>
    </div>
  </div>
</footer>
