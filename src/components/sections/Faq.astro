---
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';
import Section from '../ui/Section.astro';

const base = import.meta.env.BASE_URL;
const questions = [
  [
    "Есть единый порог участия?",
    "Нет единой суммы для всех проектов: размер участия зависит от масштаба объекта и условий конкретной сделки."
  ],
  [
    "Как устроено участие в проекте?",
    "Формат участия, порядок расчётов и возникающие права определяются документами конкретной сделки. Универсальной схемы для всех проектов нет."
  ],
  [
    "Какие риски необходимо учитывать?",
    "Возможны простой помещений, изменение арендных ставок и стоимости объекта, непредвиденные расходы. Доходность и сохранность капитала не гарантируются."
  ],
  [
    "Можно передать объект в управление?",
    "Да. Фидента рассматривает управление объектами на основании договора: арендаторы, подрядчики, эксплуатация и возможное развитие."
  ],
  [
    "Какие объекты рассматривает Фидента?",
    "Склады, автосервисы, производственные и торговые площади, земельные участки и объекты реконструкции — если проект соответствует задачам участников."
  ],
  [
    "Что происходит после заявки?",
    "Мы уточняем задачу, связываемся с вами, обсуждаем объект или проект, возможный формат сотрудничества и дальнейшие документы."
  ]
];
---

<Section id="faq" class="faq-section">
  <div class="faq-layout grid gap-7 border-t border-cream/25 pt-8 lg:gap-x-10 lg:pt-10">
    <div class="faq-intro">
      <SectionHeading eyebrow="Вопросы и ответы">
        Разбираем самые<br /><span class="text-gold-plate">частые вопросы</span>
        <Fragment slot="lead">Коротко о проектах, управлении и первом обращении.</Fragment>
      </SectionHeading>
    </div>

    <div class="faq-questions flex flex-col gap-3">
      {questions.map(([question, answer]) => (
        <details name="fidenta-faq" class="faq-question plat-outline rounded-[9px]">
          <summary class="flex min-h-[60px] cursor-pointer items-center justify-between gap-4 px-5 py-4 font-accent text-lg leading-snug md:min-h-[69px] md:text-xl">
            <span>{question}</span>
            <span class="faq-plus text-gold-plate" aria-hidden="true">+</span>
          </summary>
          <p class="mx-5 border-t border-cream/20 pb-5 pt-3 font-accent text-base leading-snug text-copy md:text-lg">{answer}</p>
        </details>
      ))}
    </div>

    <div class="faq-contact flex flex-col items-start">
      <div class="faq-visual w-full max-w-[360px] border-l border-sand/45" aria-hidden="true">
        <img src={`${base}images/faq-illustration.jpg`} width="720" height="480" alt="" loading="lazy" decoding="async" />
      </div>
      <p class="mb-4 mt-3 font-accent text-lg text-copy">Не нашли свой вопрос? Обсудим вашу задачу.</p>
      <div class="w-full max-md:-mx-3 max-md:w-auto max-md:self-stretch">
        <Button variant="plat-form" href="#cta"><span class="text-gold-plate">Задать вопрос специалисту →</span></Button>
      </div>
    </div>
  </div>
</Section>

<style>
  .faq-section { background: #071f18; }
  .faq-layout { grid-template-areas: 'intro' 'questions' 'contact'; }
  .faq-intro { grid-area: intro; }
  .faq-questions { grid-area: questions; }
  .faq-contact { grid-area: contact; }
  .faq-question { background: #0a211a; }
  .faq-question[open] { background: #122e25; }
  .faq-question summary { list-style: none; }
  .faq-question summary::-webkit-details-marker { display: none; }
  .faq-plus { font-size: 24px; }
  .faq-question[open] .faq-plus { rotate: 45deg; }
  .faq-visual img { display: block; width: 100%; height: auto; mask-image: radial-gradient(ellipse at center, black 45%, transparent 77%); }
  @media (width < 768px) {
    .faq-questions { gap: 0; border-block: 1px solid rgb(255 241 217 / 25%); }
    .faq-question, .faq-question[open] { background: transparent; border-radius: 0; }
    .faq-question + .faq-question { border-top: 1px solid rgb(255 241 217 / 25%); }
    .faq-question::after { display: none; }
    .faq-question summary { padding-inline: 0; }
    .faq-question > p { margin-inline: 0; border-top: 0; padding-top: 0; }
  }
  @media (min-width: 1024px) {
    .faq-layout { grid-template-areas: 'intro questions' 'contact questions'; grid-template-columns: minmax(350px, 2fr) minmax(0, 3.6fr); grid-template-rows: auto 1fr; align-items: start; }
    .faq-contact { align-self: end; }
  }
</style>
