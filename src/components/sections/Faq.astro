---
import SectionHeading from '../ui/SectionHeading.astro';
import Section from '../ui/Section.astro';
import ContactMenu from '../ui/ContactMenu.astro';

const base = import.meta.env.BASE_URL;
const questions = [
  [
    "Есть единый порог участия?",
    "Нет единой суммы для всех проектов: размер участия зависит от масштаба объекта и условий конкретной сделки"
  ],
  [
    "Как устроено участие в проекте?",
    "Формат участия, порядок расчётов и возникающие права определяются документами конкретной сделки. Универсальной схемы для всех проектов нет"
  ],
  [
    "Какие риски необходимо учитывать?",
    "Помещения могут простаивать, арендные ставки и стоимость объекта — меняться, а расходы на ремонт — оказаться выше расчёта. Доходность и сохранность вложений не гарантируются"
  ],
  [
    "Можно передать объект в управление?",
    "Да. Расскажите, как объект работает сейчас и что нужно сделать. После знакомства с объектом предложим условия управления и закрепим в договоре объём работ и отчётность"
  ],
  [
    "Какие объекты рассматривает Фидента?",
    "Рассматриваем склады, автосервисы, производственные и торговые помещения, земельные участки и здания под реконструкцию. Смотрим на расположение, состояние и возможности использования объекта"
  ],
  [
    "Что происходит после заявки?",
    "Свяжемся с вами по указанному номеру, чтобы уточнить задачу. Если у вас есть объект, договоримся, какие сведения нужны для оценки. Если вы ищете проект, уточним, какой формат участия вам подходит"
  ]
];
const extraQuestions = [
  ['Что подготовить к первому разговору?', 'Если предлагаете объект, достаточно адреса, площади и краткого описания задачи'],
  ['Можно сначала обсудить объект по телефону?', 'Да, выберите звонок или чат и расскажите, что хотите обсудить'],
  ['Где можно встретиться с командой?', 'В офисе в Санкт-Петербурге. Время встречи согласуем заранее'],
];
---

<Section id="faq" class="faq-section">
  <div class="faq-layout grid gap-7 border-t border-cream/25 pt-8 lg:gap-x-10 lg:pt-10">
    <div class="faq-sidebar">
      <div class="faq-intro">
        <SectionHeading eyebrow="Вопросы и ответы">
          Разбираем самые<br /><span class="text-gold-plate">частые вопросы</span>
          <Fragment slot="lead">Коротко о проектах, управлении и первом обращении</Fragment>
        </SectionHeading>
      </div>
      <div class="faq-contact flex flex-col items-start">
        <div class="faq-visual w-full" aria-hidden="true">
          <img src={`${base}images/faq-illustration-plat.png`} width="720" height="480" alt="" loading="lazy" decoding="async" />
        </div>
        <p class="mb-4 mt-3 font-accent text-lg text-copy">Не нашли свой вопрос?<br class="lg:hidden" />{' '}Обсудим вашу задачу</p>
        <div class="faq-contact-action w-full text-plat-dense">
          <ContactMenu label="Задать вопрос специалисту" />
        </div>
      </div>
    </div>

    <div class="faq-list">
      <div class="faq-questions flex flex-col gap-3">
        {[...questions, ...extraQuestions].map(([question, answer], index) => (
          <details hidden={index >= questions.length} data-faq-extra={index >= questions.length ? "" : undefined} name="fidenta-faq" class="faq-question plat-outline rounded-[9px]">
            <summary class="flex min-h-[60px] cursor-pointer items-center justify-between gap-4 px-5 py-4 font-accent text-lg leading-snug md:min-h-[69px] md:text-xl">
              <span>{question}</span>
              <span class="faq-plus text-gold-plate text-plat-dense" aria-hidden="true">+</span>
            </summary>
            <p class="mx-5 border-t border-cream/20 pb-5 pt-3 font-accent text-base leading-snug text-copy md:text-lg">{answer.replace(/\.$/, "")}</p>
          </details>
        ))}
      </div>

      <button type="button" class="faq-more text-gold-plate text-plat-dense w-fit" data-faq-more aria-expanded="false">Показать ещё вопросы</button>
    </div>


  </div>
</Section>

<style>
  .faq-section { background: #071f18; }
  .faq-layout { grid-template-areas: 'intro' 'list' 'contact'; }
  .faq-more { display: grid; place-items: center; min-height: 48px; font: clamp(16px, 1.45vw, 21px) var(--font-accent); justify-self: center; align-self: end; cursor: pointer; }
  .faq-sidebar { display: contents; }
  .faq-list { grid-area: list; display: grid; gap: 16px; }
  .faq-layout { reading-flow: grid-rows; }
  .faq-intro { grid-area: intro; }
  .faq-contact { grid-area: contact; }
  .faq-question { background: var(--surface-40); }
  .faq-question summary { list-style: none; }
  .faq-question summary::-webkit-details-marker { display: none; }
  .faq-plus { font-size: 24px; }
  .faq-question[open] .faq-plus { rotate: 45deg; }
  .faq-visual img { display: block; width: 100%; height: auto; mask-image: radial-gradient(ellipse at center, black 45%, transparent 77%); }
  @media (width < 768px) {
    .faq-questions { gap: 0; border-block: 1px solid rgb(255 241 217 / 25%); }
    .faq-question { border-radius: 0; background: transparent; }
    .faq-question + .faq-question { border-top: 1px solid rgb(255 241 217 / 25%); }
    .faq-question::after { display: none; }
    .faq-question summary { padding-inline: 0; }
    .faq-question > p { margin-inline: 0; border-top: 0; padding-top: 0; }
  }
  @media (min-width: 1024px) {
    .faq-layout { grid-template-areas: 'sidebar list' 'sidebar more'; grid-template-rows: auto min-content; grid-template-columns: minmax(0, 2fr) minmax(0, 3.6fr); align-items: start; }
    .faq-list { display: contents; }
    .faq-questions { grid-area: list; }
    .faq-more { grid-area: more; }
    .faq-sidebar { grid-area: sidebar; align-self: stretch; display: flex; flex-direction: column; gap: 16px; }
    .faq-contact { flex: 1; }
    .faq-layout:has(.faq-question[open]) { grid-template-areas: 'sidebar list' '. more'; }
    .faq-contact-action { margin-top: auto; }
    .faq-questions { align-self: stretch; }
    .faq-question[open]:is(:last-of-type, :has(+ [hidden])) { flex: 1; }
    .faq-question[hidden] { display: none; }
  }
</style>

<script>
  const faq = document.querySelector<HTMLElement>('#faq');
  if (faq) {
    const more = faq.querySelector<HTMLButtonElement>('[data-faq-more]')!;
    const extras = faq.querySelectorAll<HTMLDetailsElement>('[data-faq-extra]');
    more.addEventListener('click', () => {
      const expanded = more.getAttribute('aria-expanded') === 'true';
      extras.forEach(item => { item.hidden = expanded; if (expanded) item.open = false; });
      more.setAttribute('aria-expanded', String(!expanded));
      more.textContent = expanded ? 'Показать ещё вопросы' : 'Скрыть дополнительные вопросы';
    });
  }
</script>
