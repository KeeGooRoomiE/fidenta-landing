---
import { nav, office, phones } from '../../data/site';

const assets = `${import.meta.env.BASE_URL}images/header/`;
---

<header class="site-header fixed inset-x-0 top-0 z-50" id="site-header" data-scrolled="false">
  <div id="nav-backdrop" class="fixed inset-0 hidden bg-black/40" aria-hidden="true"></div>

  <div class="header-shell header-bar relative">
    <a href="#" class="header-brand" aria-label="Фидента — архитектура капитала">
      <picture class="header-bridge">
        <source media="(min-width: 1024px)" srcset={`${assets}logo-desktop.svg`} width="120" height="54" />
        <img src={`${assets}logo-mobile.svg`} width="80" height="33" alt="" />
      </picture>
      <span class="header-wordmark" aria-hidden="true">
        <span class="header-name">ФИДЕНТА</span>
        <span class="header-tagline">АРХИТЕКТУРА КАПИТАЛА</span>
      </span>
    </a>

    <div class="header-contact">
      <p>{office.short}</p>
      <a href={phones.header.href}>{phones.header.text}</a>
    </div>

    <div class="contact-choice">
      <button type="button" class="header-cta" aria-label="Связаться" aria-expanded="false" aria-controls="contact-options">
        <img src={`${assets}phone.svg`} width="44" height="44" alt="" />
        <span>Связаться</span>
      </button>
      <div id="contact-options" hidden>
        <a href="https://t.me/fidenta"><span class="text-gold-plate">Написать в Telegram</span></a>
        <a href={phones.header.href}><span class="text-gold-plate">Позвонить</span></a>
      </div>
    </div>

    <div class="header-account" role="img" aria-label="Личный кабинет — скоро">
      <img src={`${assets}owner.svg`} width="54" height="50" alt="" />

    </div>

    <button id="menu-toggle" type="button" class="header-menu" aria-label="Меню"
      aria-controls="nav-panel" aria-expanded="false">
      <picture>
        <source media="(min-width: 1024px)" srcset={`${assets}menu-desktop.svg`} width="54" height="50" />
        <img src={`${assets}menu-mobile.svg`} width="44" height="44" alt="" />
      </picture>
    </button>
  </div>

  <nav id="nav-panel" class="header-shell nav-panel-card relative hidden" aria-label="Основная навигация">
    <div class="grid gap-1 p-4 sm:grid-cols-2">
      {nav.map((link) => (
        <a href={link.href} class="rounded-lg px-4 py-3.5 text-lg transition-colors hover:bg-white/5">
          <span class="text-gold-plate">{link.label}</span>
        </a>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 border-t border-white/10 px-6 py-4 text-base text-fg/75">
      <a href={phones.header.href} class="font-semibold text-fg hover:text-accent">{phones.header.text}</a>
      <span>{office.short}</span>
    </div>
  </nav>
</header>

<style>
  .site-header {
    --header-inset: 12px;
    --header-gold: linear-gradient(169deg, rgba(255, 241, 217, 0.87) 25.714%, rgba(168, 133, 72, 0.87) 120.56%);
    padding-top: 16px;
    pointer-events: none;
    /* Шапка задана в масштабе 1:1 при ширине макета 1440px. */
    zoom: calc(1 / var(--desktop-reference-zoom, 1));
  }

  .header-shell {
    width: calc(100% - 2 * var(--header-inset));
    max-width: 1440px;
    margin-inline: auto;
    pointer-events: auto;
  }

  #nav-backdrop {
    pointer-events: auto;
  }

  .header-bar {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    grid-template-areas: 'menu brand cta';
    align-items: center;
    min-height: 62px;
    padding-inline: 9px 7px;
    border: 0.68px solid rgba(255, 241, 217, 0.58);
    border-radius: 9px;
    background: rgba(11, 24, 19, 0.8);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    font-family: var(--font-accent);
  }

  .header-brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    justify-self: center;
    gap: 2px;
    translate: -3px -2px;
    white-space: nowrap;
  }

  .header-bridge {
    flex: 0 0 auto;
    width: 80px;
  }

  .header-bridge img {
    display: block;
    width: 100%;
    height: auto;
  }

  .header-wordmark {
    display: grid;
    min-width: 108px;
    color: transparent;
    background: var(--header-gold);
    background-clip: text;
    text-align: center;
  }

  .header-name {
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: 1.2px;
  }

  .header-tagline {
    font-size: 10px;
    line-height: 1.22;
  }

  .header-menu {
    grid-area: menu;
    display: block;
    padding: 0;
    border-radius: 9px;
    cursor: pointer;
  }

  .contact-choice {
    grid-area: cta;
    position: relative;
  }

  #contact-options {
    position: absolute;
    top: calc(100% + 20px);
    right: 0;
    width: max-content;
    padding: 6px;
    border: 1px solid #766e5c;
    border-radius: 9px;
    background: var(--color-tile);
    color: #fff1d9;
  }

  #contact-options a {
    display: block;
    padding: 10px 14px;
  }

  #contact-options a:is(:hover, :focus-visible) {
    background: #243a32;
  }

  .header-cta {
    width: 100%;
    cursor: pointer;
    display: grid;
    place-items: center;
    border-radius: 9px;
  }

  .header-menu img,
  .header-cta img {
    display: block;
  }

  .header-menu:hover,
  .header-cta:hover {
    filter: brightness(1.15);
  }

  .header-contact,
  .header-account,
  .header-cta span {
    display: none;
  }

  .nav-panel-card {
    margin-top: 8px;
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    border: 1px solid rgba(255, 241, 217, 0.22);
    border-radius: 14px;
    background: rgba(11, 24, 19, 0.94);
    box-shadow: 0 20px 45px -18px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  @media (max-width: 350px) {
    .header-bridge {
      width: 67px;
    }

    .header-wordmark {
      min-width: 94px;
    }

    .header-name {
      font-size: 21px;
    }

    .header-tagline {
      font-size: 9px;
    }
  }

  @media (min-width: 1024px) {
    .site-header {
      --header-inset: clamp(24px, 3.333%, 48px);
      padding-top: 22px;
    }

    .header-bar {
      grid-template-columns: minmax(0, 1fr) auto 156px 54px 54px;
      grid-template-areas: 'brand contact cta account menu';
      gap: 16px;
      min-height: 86px;
      /* Проценты от ширины шапки страницы, как у контейнера hero. */
      --panel-width: min(calc(100% - 2 * var(--header-inset)), 1440px);
      --content-width: min(calc(100% - 2 * clamp(32px, 5.556%, 80px)), 1280px);
      padding: 0 0 4px;
      padding-inline: calc((var(--panel-width) - var(--content-width)) / 2 - 1px);
      border-width: 1px;
      /* Подложка сохраняет контраст и поверх светлого фото первого экрана. */
      background: rgba(11, 24, 19, 0.9);
    }

    .site-header[data-scrolled="true"] .header-bar {
      background: rgba(11, 24, 19, 0.94);
    }

    .header-brand {
      justify-self: start;
      gap: 8px;
      translate: 0 2px;
    }

    .header-bridge {
      width: 120px;
    }

    .header-wordmark {
      min-width: 154px;
    }

    .header-name {
      font-size: 32px;
      letter-spacing: 3.2px;
    }

    .header-tagline {
      font-size: 14px;
    }

    .header-contact {
      grid-area: contact;
      display: block;
      font-size: 20px;
      line-height: 1.15;
      color: var(--color-cream);
      text-align: right;
      white-space: nowrap;
    }

    #contact-options {
      top: calc(100% + 10px);
      width: 100%;
      padding: 4px;
      background: linear-gradient(var(--hero-card-surface), var(--hero-card-surface)), var(--color-canvas);
    }

    #contact-options a {
      padding: 10px 6px;
      text-align: center;
    }

    .header-contact a:hover {
      text-decoration: underline;
    }

    .header-cta {
      min-height: 50px;
      font-size: 20px;
      color: #082419;
      background: linear-gradient(165deg, rgba(255, 241, 217, 0.87) 25.714%, rgba(168, 133, 72, 0.87) 120.56%);
    }

    .header-cta img {
      display: none;
    }

    .header-cta span {
      display: block;
    }

    .header-account {
      grid-area: account;
      display: grid;
      justify-items: center;
      align-content: center;
      min-height: 50px;

      border-radius: 9px;
      color: #cacaca;
      font-size: 10px;
      line-height: 1.22;
    }
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('nav-panel');
  const backdrop = document.getElementById('nav-backdrop');

  const contactButton = document.querySelector<HTMLButtonElement>('.header-cta');
  const options = document.getElementById('contact-options');

  function setContactOpen(open: boolean) {
    if (options) options.hidden = !open;
    contactButton?.setAttribute('aria-expanded', String(open));
  }

  contactButton?.addEventListener('click', () => {
    setMenuOpen(false);
    setContactOpen(options?.hidden ?? false);
  });
  function closeOutside(event: Event) {
    if (event.target instanceof Element && !event.target.closest('.contact-choice')) setContactOpen(false);
  }
  document.addEventListener('click', closeOutside);
  document.addEventListener('focusin', closeOutside);
  options?.addEventListener('click', () => setContactOpen(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && options && !options.hidden) {
      setContactOpen(false);
      contactButton?.focus();
    }
  });

  function setMenuOpen(open: boolean) {
    panel?.classList.toggle('hidden', !open);
    backdrop?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
  }

  toggle?.addEventListener('click', () => setMenuOpen(panel?.classList.contains('hidden') ?? false));

  panel?.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  backdrop?.addEventListener('click', () => setMenuOpen(false));
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setMenuOpen(false);
      toggle.focus();
    }
  });

  const header = document.getElementById('site-header');
  function syncScrolledState() {
    header?.setAttribute('data-scrolled', String(window.scrollY > 24));
  }

  syncScrolledState();
  window.addEventListener('scroll', syncScrolledState, { passive: true });
</script>
