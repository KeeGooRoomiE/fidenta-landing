---
import { nav, office, phones } from '../../data/site';

const assets = `${import.meta.env.BASE_URL}images/header/`;
---

<header class="site-header fixed inset-x-0 top-0 z-50" id="site-header" data-scrolled="false">
  <div id="nav-backdrop" class="fixed inset-0 hidden bg-black/40" aria-hidden="true"></div>

  <div class="header-shell header-bar relative">
    <a href="#" class="header-brand" aria-label="Фидента — архитектура капитала">
      <picture class="header-bridge">
        <source media="(min-width: 1024px)" srcset={`${assets}logo-desktop.svg`} width="120" height="54" />
        <img src={`${assets}logo-mobile-header.svg`} width="80" height="33" alt="" />
      </picture>
      <span class="header-wordmark" aria-hidden="true">
        <span class="header-name text-gold-plate">ФИДЕНТА</span>
        <span class="header-tagline text-gold-plate">АРХИТЕКТУРА КАПИТАЛА</span>
      </span>
    </a>

    <div class="header-contact">
      <p>{office.short}</p>
      <a href={phones.header.href}>{phones.header.text}</a>
    </div>

    <div class="contact-choice">
      <button type="button" class="header-cta" aria-label="Связаться" aria-expanded="false" aria-controls="contact-options">
        <svg preserveAspectRatio="none" overflow="visible" aria-hidden="true" width="44" height="44" viewBox="0 0 44 44" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g aria-hidden="true">
          <path d="M9 0.339844H35C39.7828 0.339844 43.6602 4.21721 43.6602 9V35C43.6602 39.7828 39.7828 43.6602 35 43.6602H9C4.21721 43.6602 0.339844 39.7828 0.339844 35V9C0.339844 4.21721 4.21721 0.339844 9 0.339844Z" stroke="url(#paint0_linear_0_8)" stroke-opacity="0.86" stroke-width="0.68"/>
          <path class="handset" d="M15.5 14.26H19.5L21.5 19.26L19 20.76C20.071 22.9315 21.8285 24.689 24 25.76L25.5 23.26L30.5 25.26V29.26C30.5 29.7904 30.2893 30.2991 29.9142 30.6742C29.5391 31.0493 29.0304 31.26 28.5 31.26C24.5993 31.023 20.9202 29.3665 18.1568 26.6032C15.3935 23.8398 13.737 20.1607 13.5 16.26C13.5 15.7296 13.7107 15.2209 14.0858 14.8458C14.4609 14.4707 14.9696 14.26 15.5 14.26Z" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" stroke="url(#paint1_linear_0_8)" stroke-opacity="0.76"/>
          </g>
          <defs>
          <linearGradient id="paint0_linear_0_8" x1="-11.3143" y1="-11.3143" x2="46.5143" y2="58.4571" gradientUnits="userSpaceOnUse">
          <stop stop-color="#FFF1D9" stop-opacity="0.99"/>
          <stop offset="1" stop-color="#A88548"/>
          </linearGradient>
          <linearGradient id="paint1_linear_0_8" x1="11" y1="13" x2="33" y2="34" gradientUnits="userSpaceOnUse">
          <stop stop-color="#E2CEAA"/>
          <stop offset="0.37" stop-color="#F4E5C9"/>
          <stop offset="1" stop-color="#A88548"/>
          </linearGradient>
          </defs>
        </svg>
        <span>Связаться</span>
      </button>
      <div id="contact-options" hidden>
        <a href="https://t.me/turvast"><span class="text-gold-plate">Написать в чат</span></a>
        <a href={phones.header.href}><span class="text-gold-plate">Позвонить</span></a>
      </div>
    </div>

    <div class="header-account" role="img" aria-label="Личный кабинет — скоро" title="Личный кабинет скоро откроется">
      <img src={`${assets}owner.svg`} width="54" height="50" alt="" />

    </div>

    <button id="menu-toggle" type="button" class="header-menu" aria-label="Меню"
      aria-controls="nav-panel" aria-expanded="false">
      <picture>
        <source media="(min-width: 1024px)" srcset={`${assets}menu-desktop.svg`} width="54" height="50" />
        <img src={`${assets}menu-mobile.svg`} width="44" height="44" alt="" />
      </picture>
    </button>
  </div>

  <nav id="nav-panel" class="header-shell nav-panel-card relative hidden" aria-label="Основная навигация">
    <div class="grid gap-1 p-4 sm:grid-cols-2">
      {nav.map((link) => (
        <a href={link.href} class="rounded-lg px-4 py-3.5 text-lg transition-colors hover:bg-white/5">
          <span class="text-gold-plate">{link.label}</span>
        </a>
      ))}
    </div>
    <div class="flex flex-wrap items-center gap-x-8 gap-y-2 border-t border-white/10 px-6 py-4 text-base text-fg/75">
      <a href={phones.header.href} class="font-semibold text-fg hover:text-accent">{phones.header.text}</a>
      <span class="text-copy">{office.short}</span>
    </div>
  </nav>
</header>

<style>
  .site-header {
    --header-inset: 12px;
    padding-top: 16px;
    pointer-events: none;
    /* Шапка задана в масштабе 1:1 при ширине макета 1440px. */
    zoom: calc(1 / var(--desktop-reference-zoom, 1));
  }

  .header-shell {
    width: calc(100% - 2 * var(--header-inset));
    max-width: 1440px;
    margin-inline: auto;
    pointer-events: auto;
  }

  #nav-backdrop {
    pointer-events: auto;
  }

  .header-bar {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) 44px;
    grid-template-areas: 'menu brand cta';
    align-items: center;
    min-height: 62px;
    padding-inline: 9px 7px;
    border: 0.68px solid rgba(255, 241, 217, 0.58);
    border-radius: 9px;
    background: var(--surface-90);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    font-family: var(--font-accent);
  }

  .header-brand {
    grid-area: brand;
    display: flex;
    align-items: center;
    justify-self: center;
    gap: 2px;
    translate: -3px -2px;
    white-space: nowrap;
  }

  .header-bridge {
    flex: 0 0 auto;
    width: 80px;
  }

  .header-bridge img {
    display: block;
    width: 100%;
    height: auto;
  }

  .header-wordmark {
    display: grid;
    min-width: 108px;
    text-align: center;
  }

  .header-name {
    --plat-text-fill: var(--gradient-plat-wordmark);
    font-size: 24px;
    line-height: 1.1;
    letter-spacing: 1.2px;
  }

  .header-tagline {
    --plat-text-fill: linear-gradient(167deg, var(--plat-text-base) 18%, var(--plat-text-shadow) 111%);
    font-size: 10px;
    line-height: 1.22;
  }

  .header-menu {
    grid-area: menu;
    display: block;
    padding: 0;
    border-radius: 9px;
    cursor: pointer;
  }

  .contact-choice {
    grid-area: cta;
    position: relative;
  }

  #contact-options {
    position: absolute;
    top: calc(100% + 20px);
    right: 0;
    width: max-content;
    padding: 6px;
    border: 1px solid #766e5c;
    border-radius: 9px;
    background: var(--surface-60);
    backdrop-filter: blur(12px);
    color: #fff1d9;
  }

  #contact-options a {
    display: block;
    padding: 10px 14px;
  }

  #contact-options a:is(:hover, :focus-visible) {
    background: var(--surface-90);
  }

  .header-cta {
    width: 100%;
    cursor: pointer;
    display: grid;
    place-items: center;
    border-radius: 9px;
  }

  .header-menu img,
  .header-cta svg {
    display: block;
  }

  .header-menu:hover,
  .header-cta:hover {
    filter: brightness(1.15);
  }

  .header-contact,
  .header-account,
  .header-cta span {
    display: none;
  }

  .nav-panel-card {
    --plat-text-fill: var(--gradient-plat-navigation);
    margin-top: 8px;
    max-height: calc(100dvh - 120px);
    overflow-y: auto;
    border: 1px solid rgba(255, 241, 217, 0.22);
    border-radius: 14px;
    background: var(--surface-90);
    box-shadow: 0 20px 45px -18px rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  @media (width < 1024px) {
    .header-brand { scale: .97 1; translate: -1px -2px; }
  }

  @media (max-width: 350px) {
    .header-bridge {
      width: 67px;
    }

    .header-wordmark {
      min-width: 94px;
    }

    .header-name {
      font-size: 21px;
    }

    .header-tagline {
      font-size: 9px;
    }
  }

  @media (min-width: 1024px) {
    .site-header {
      --header-inset: clamp(24px, 3.333%, 48px);
      padding-top: 22px;
    }

    .header-bar {
      grid-template-columns: minmax(0, 1fr) auto 156px 54px 54px;
      grid-template-areas: 'brand contact cta account menu';
      gap: 16px;
      min-height: 86px;
      /* Проценты от ширины шапки страницы, как у контейнера hero. */
      --panel-width: min(calc(100% - 2 * var(--header-inset)), 1440px);
      --content-width: min(calc(100% - 2 * clamp(32px, 5.556%, 80px)), 1280px);
      padding: 0 0 4px;
      padding-inline: calc((var(--panel-width) - var(--content-width)) / 2 - 1px);
      border-width: 1px;
      /* Подложка сохраняет контраст и поверх светлого фото первого экрана. */
      background: var(--surface-90);
    }

    .site-header[data-scrolled="true"] .header-bar {
      background: var(--surface-90);
    }

    .header-brand {
      justify-self: start;
      gap: 8px;
      translate: 0 2px;
    }

    .header-bridge {
      width: 120px;
    }

    .header-wordmark {
      min-width: 154px;
    }

    .header-name {
      font-size: 32px;
      letter-spacing: 3.2px;
    }

    .header-tagline {
      font-size: 14px;
    }

    .header-contact {
      grid-area: contact;
      display: block;
      font-size: 20px;
      line-height: 1.15;
      color: var(--color-cream);
      text-align: right;
      white-space: nowrap;
    }

    #contact-options {
      top: calc(100% + 10px);
      width: 100%;
      padding: 4px;
      background: var(--surface-60);
    }

    #contact-options a {
      padding: 10px 6px;
      text-align: center;
    }

    .header-contact a:hover {
      text-decoration: underline;
    }

    .header-cta {
      min-height: 50px;
      font-size: 20px;
      color: #082419;
      background: var(--gradient-plat-cta);
    }

    .header-cta svg {
      display: none;
    }

    .header-cta span {
      display: block;
    }

    .header-account {
      grid-area: account;
      display: grid;
      justify-items: center;
      align-content: center;
      min-height: 50px;

      border-radius: 9px;
      color: #cacaca;
      font-size: 10px;
      line-height: 1.22;
    }
  }
</style>

<script is:inline>
  // Bind the controls as soon as the header is parsed on a slow connection.
  (() => {
    const toggle = document.getElementById('menu-toggle');
    const panel = document.getElementById('nav-panel');
    const backdrop = document.getElementById('nav-backdrop');

    const contactButton = document.querySelector('.header-cta');
    const options = document.getElementById('contact-options');

    function setContactOpen(open) {
      if (options) options.hidden = !open;
      contactButton?.setAttribute('aria-expanded', String(open));
    }

    contactButton?.addEventListener('click', () => {
      setMenuOpen(false);
      setContactOpen(options?.hidden ?? false);
    });
    function closeOutside(event) {
      if (event.target instanceof Element && !event.target.closest('.contact-choice')) setContactOpen(false);
    }
    document.addEventListener('click', closeOutside);
    document.addEventListener('focusin', closeOutside);
    options?.addEventListener('click', () => setContactOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && options && !options.hidden) {
        setContactOpen(false);
        contactButton?.focus();
      }
    });

    function setMenuOpen(open) {
      panel?.classList.toggle('hidden', !open);
      backdrop?.classList.toggle('hidden', !open);
      toggle?.setAttribute('aria-expanded', String(open));
    }

    toggle?.addEventListener('click', () => setMenuOpen(panel?.classList.contains('hidden') ?? false));

    panel?.querySelectorAll('a[href^="#"]').forEach((link) => {
      link.addEventListener('click', () => setMenuOpen(false));
    });

    backdrop?.addEventListener('click', () => setMenuOpen(false));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
        setMenuOpen(false);
        toggle.focus();
      }
    });

    const header = document.getElementById('site-header');
    function syncScrolledState() {
      header?.setAttribute('data-scrolled', String(window.scrollY > 24));
    }

    syncScrolledState();
    window.addEventListener('scroll', syncScrolledState, { passive: true });
  })();
</script>
