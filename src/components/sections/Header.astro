---
/*
  УРОВЕНЬ 3 — БЛОК Header (шапка) — по финальному дизайну

  Минималистичная прозрачная шапка поверх Hero (фото Невы просвечивает):
    [☰ бургер] ....... [логотип по центру] ....... [Консультация]
  Навигация спрятана за бургер (раскрывается выпадающей панелью на всех экранах).

  Раскладка — grid из 3 колонок 1fr/auto/1fr, чтобы логотип был строго по центру
  независимо от ширины левого/правого блоков.

  Хедер fixed — лежит поверх контента, поэтому Hero имеет верхний отступ (pt-28).
*/
const base = import.meta.env.BASE_URL;

const navLinks = [
  { label: 'О компании', href: '#about' },
  { label: 'Инвестиции', href: '#portfolio' },
  { label: 'Услуги', href: '#why' },
  { label: 'Объекты', href: '#portfolio' },
  { label: 'Вопросы', href: '#faq' },
  { label: 'Контакты', href: '#cta' },
];
---

<header class="fixed inset-x-0 top-0 z-50">
  <div class="container-page grid h-20 grid-cols-[1fr_auto_1fr] items-center md:h-24">
    <!-- ЛЕВО: бургер в рамке-боксе -->
    <div class="justify-self-start">
      <button
        id="menu-toggle"
        class="flex h-11 w-11 items-center justify-center rounded-[9px] border border-white/15 text-fg transition-colors hover:border-accent/50 hover:text-accent"
        aria-label="Открыть меню"
        aria-expanded="false"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <line x1="4" y1="7" x2="20" y2="7" />
          <line x1="4" y1="12" x2="20" y2="12" />
          <line x1="4" y1="17" x2="20" y2="17" />
        </svg>
      </button>
    </div>

    <!-- ЦЕНТР: логотип (знак-мост + wordmark золотым металликом) -->
    <a href="#" class="flex items-center gap-3 justify-self-center">
      <img src={`${base}images/logo-mark.png`} width="72" height="32" alt="Фидента" class="h-8 w-auto" />
      <span class="leading-none">
        <span class="block font-display text-xl tracking-[0.18em] text-gold-plate">ФИДЕНТА</span>
        <span class="mt-1 block text-right text-[0.55rem] uppercase tracking-[0.2em] text-accent/80">архитектура капитала</span>
      </span>
    </a>

    <!-- ПРАВО: кнопка «Консультация» (стиль аутлайн-кнопки Hero, шрифт Forum) -->
    <div class="justify-self-end">
      <a href="#cta" class="btn-hero btn-plat-outline">
        <span class="text-gold-plate">Консультация</span>
      </a>
    </div>
  </div>

  <!-- ВЫПАДАЮЩАЯ ПАНЕЛЬ НАВИГАЦИИ (скрыта по умолчанию) -->
  <nav id="nav-panel" class="hidden border-t border-white/10 bg-canvas/95 backdrop-blur-md">
    <div class="container-page grid gap-1 py-6 sm:grid-cols-2">
      {navLinks.map((link) => (
        <a href={link.href} class="rounded-lg px-4 py-3 text-base text-fg/90 transition-colors hover:bg-surface hover:text-accent">
          {link.label}
        </a>
      ))}
    </div>
    <div class="container-page flex flex-wrap items-center gap-x-8 gap-y-2 border-t border-white/10 py-4 text-sm text-muted">
      <a href="tel:+78120000000" class="font-semibold text-fg hover:text-accent">+7 (812) 000-00-00</a>
      <span>СПб, Богатырский 18 к 4 ст2</span>
    </div>
  </nav>
</header>

<script>
  // Бургер раскрывает/прячет панель навигации на всех экранах.
  const toggle = document.getElementById('menu-toggle');
  const panel = document.getElementById('nav-panel');

  toggle?.addEventListener('click', () => {
    const isHidden = panel?.classList.toggle('hidden');
    toggle.setAttribute('aria-expanded', String(!isHidden));
  });

  // Закрываем панель после клика по ссылке (переход к секции).
  panel?.querySelectorAll('a[href^="#"]').forEach((link) => {
    link.addEventListener('click', () => {
      panel.classList.add('hidden');
      toggle?.setAttribute('aria-expanded', 'false');
    });
  });
</script>
