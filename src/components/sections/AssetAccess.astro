---
import { craneCables, craneMetal, pieces, sceneHeight, sceneWidth, sky, totalMln } from '../../data/investment-puzzle';

const base = import.meta.env.BASE_URL;
const foregroundPieces = pieces.slice(0, 3);
const occlusion = (index: number) => index === 2
  ? 'url(#investment-crane-occlusion)'
  : index >= 3 ? 'url(#investment-background-occlusion)' : undefined;
---

<section id="asset" class="asset-puzzle" data-investment-puzzle aria-labelledby="investment-title">
  <div class="investment-container">
    <div data-puzzle-marker="desktop" aria-hidden="true"></div>
    <div class="investment-stage" data-puzzle-pin="desktop">
      <div class="investment-heading">
        <p class="investment-eyebrow"><span aria-hidden="true"></span>Инвестиции в недвижимость</p>
        <h2 id="investment-title">
          <span class="investment-desktop-title">Приобрести недостаточно. <span class="text-gold-plate">Важно развивать</span></span>
          <span class="investment-mobile-title">Актив собран.<br /><span class="text-gold-plate">Далее – работа.</span></span>
        </h2>
      </div>

      <div class="investment-grid">
        <div class="investment-copy">
          <p>Фидента объединяет участников вокруг проектов коммерческой недвижимости.</p>
          <button type="button" class="investment-more" data-puzzle-expand aria-expanded="false" aria-controls="investment-details">
            <span data-puzzle-expand-label>Читать далее</span>
            <span class="investment-chevron" aria-hidden="true"></span>
          </button>
          <div id="investment-details" class="investment-details" data-puzzle-details>
            <p>Каждая доля становится частью общего капитала, необходимого для реализации проекта.</p>
            <p>Участвуя в проектах «Фиденты», вы направляете капитал в реальные объекты с потенциалом получения арендного дохода и увеличения рыночной стоимости.</p>
            <p>Это могут быть торговые помещения, складские комплексы, сервисные и другие коммерческие объекты.</p>
            <p>Мы рассматриваем недвижимость как долгосрочный актив, ценность которого формируется благодаря грамотному использованию, профессиональному управлению и развитию.</p>
            <p>Форма участия, имущественные права и условия получения дохода определяются индивидуально для каждого проекта.</p>
            <button type="button" class="investment-more" data-puzzle-collapse>Свернуть текст</button>
          </div>
        </div>

        <div data-puzzle-marker="mobile" aria-hidden="true"></div>
        <div class="investment-visual" data-puzzle-pin="mobile">
          <div class="investment-capital">
            <p class="text-gold-plate investment-capital-label">Объединение капитала</p>
            <div class="investment-amount">
              <span><span data-puzzle-amount>{totalMln}</span> млн ₽</span>
              <span>из {totalMln} млн ₽</span>
            </div>
            <div class="investment-count">
              <span><span data-puzzle-count>{pieces.length}</span> из {pieces.length} долей</span>
              <span class="text-gold-plate" data-puzzle-percent>100%</span>
            </div>
            <div class="investment-progress" role="progressbar" aria-label="Объединение капитала" aria-valuemin="0" aria-valuemax="100" aria-valuenow="100" data-puzzle-progress>
              <span data-puzzle-bar></span>
            </div>
            <p class="investment-phase" data-puzzle-phase>Объект собран</p>
          </div>

          <figure class="investment-board">
            <figcaption>Логистический комплекс</figcaption>
            <div class="investment-scene">
              <svg viewBox={`0 0 ${sceneWidth} ${sceneHeight}`} role="img" aria-label="Логистический комплекс: кран, контейнеры, грузовики и склад">
                <defs>
                  <image id="investment-image" href={`${base}images/investment-puzzle.webp`} width={sceneWidth} height={sceneHeight} />
                  <filter id="investment-monochrome" color-interpolation-filters="sRGB">
                    <feColorMatrix type="saturate" values="0" />
                  </filter>
                  <mask id="investment-sky" maskUnits="userSpaceOnUse" x="0" y="0" width={sceneWidth} height={sceneHeight}>
                    <path d={sky} fill="white" />
                    {craneMetal.map((path) => <path d={path} fill="black" />)}
                    <path d={craneCables} fill="none" stroke="black" stroke-width="2" />
                  </mask>
                  <mask id="investment-background-occlusion" maskUnits="userSpaceOnUse" x="0" y="0" width={sceneWidth} height={sceneHeight}>
                    <rect width={sceneWidth} height={sceneHeight} fill="white" />
                    {foregroundPieces.map(({ path }) => <path d={path} fill="black" />)}
                  </mask>
                  <mask id="investment-crane-occlusion" maskUnits="userSpaceOnUse" x="0" y="0" width={sceneWidth} height={sceneHeight}>
                    <rect width={sceneWidth} height={sceneHeight} fill="white" />
                    <path d={pieces[1].path} fill="black" />
                  </mask>
                  {pieces.map(({ id, path }) => (
                    <clipPath id={`investment-piece-${id}`}><path d={path} /></clipPath>
                  ))}
                </defs>

                <g class="investment-animated-art">
                  <use href="#investment-image" filter="url(#investment-monochrome)" />
                  <use href="#investment-image" mask="url(#investment-sky)" />
                  {pieces.map(({ id }, index) => (
                    <g data-puzzle-reveal opacity="0" mask={occlusion(index)}>
                      <use href="#investment-image" clip-path={`url(#investment-piece-${id})`} />
                    </g>
                  ))}
                  {pieces.map(({ id, path, amount, center }, index) => (
                    <g data-puzzle-flight display="none">
                      <g mask={occlusion(index)}>
                        <use href="#investment-image" clip-path={`url(#investment-piece-${id})`} />
                        <path d={path} fill="none" stroke="#e1bf80" stroke-width="3" stroke-linejoin="round" />
                      </g>
                      <text x={center[0]} y={center[1]} text-anchor="middle" dominant-baseline="central" class="investment-flight-label">+{amount} млн ₽</text>
                    </g>
                  ))}
                </g>
                <use data-puzzle-final href="#investment-image" />
              </svg>
            </div>
          </figure>

          <div class="investment-directions">
            <span>Арендаторы</span>
            <span>Согласования</span>
            <span>Подрядчики</span>
            <span>Инфраструктура</span>
            <picture>
              <source media="(min-width: 1024px)" srcset={`${base}images/investment-puzzle/bridge-desktop.svg`} width="58" height="25" />
              <img src={`${base}images/investment-puzzle/bridge-mobile.svg`} width="48" height="22" alt="" />
            </picture>
          </div>

          <p class="investment-disclaimer">
            <span class="investment-desktop-title">Представлена условная модель объединения капитала и формирования долей объекта. Демонстрация не является сбором средств или предложением участия в конкретном проекте. Все суммы, параметры и изображение объекта приведены исключительно для иллюстрации.</span>
            <span class="investment-mobile-title">Демонстрация принципа, не сбор средств и не предложение конкретного проекта. Суммы условные. Изображение — концепция.</span>
          </p>
        </div>
      </div>
    </div>
    <div class="investment-scroll-space" aria-hidden="true"></div>
  </div>
</section>

<script>
  import { initInvestmentPuzzle } from '../../scripts/puzzle-scene';

  document.querySelectorAll<HTMLElement>('[data-investment-puzzle]').forEach(initInvestmentPuzzle);
</script>

<style>
  .asset-puzzle {
    --puzzle-background: #061e17;
    --puzzle-edge: rgba(255, 241, 217, 0.6);
    --puzzle-muted: #aabdb1;
    --gradient-gold: linear-gradient(177deg, rgba(255, 241, 217, 0.87) 25.714%, rgba(168, 133, 72, 0.87) 120.56%);
    padding-block: 20px 56px;
    color: #f6f3e8;
    background: var(--puzzle-background);
    font-family: var(--font-accent);
    scroll-margin-top: 88px;
    overflow-anchor: none;
    zoom: calc(1 / var(--desktop-reference-zoom, 1));
  }

  .investment-container {
    width: calc(100% - 40px);
    max-width: 1280px;
    margin-inline: auto;
  }

  .investment-heading {
    border-top: 1px solid rgba(217, 188, 131, 0.2);
    padding-top: 16px;
    margin-bottom: 14px;
  }

  .investment-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    color: #d9bc83;
    font-size: clamp(13px, 4.1vw, 16px);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .investment-eyebrow span {
    flex: 0 0 20px;
    height: 1px;
    background: var(--gradient-gold);
  }

  .investment-heading h2 {
    margin-top: 7px;
    font-size: clamp(29px, 8.72vw, 38px);
    line-height: 1.16;
  }

  .investment-desktop-title {
    display: none;
  }

  .investment-stage,
  .investment-grid {
    display: contents;
  }

  .investment-copy {
    margin-bottom: 24px;
    color: #b8c2b8;
    font-size: 16px;
    line-height: 1.23;
  }

  .investment-details p {
    margin-top: 7px;
  }

  .investment-more {
    display: none;
    min-height: 44px;
    margin-top: 10px;
    padding: 5px 14px;
    align-items: center;
    gap: 10px;
    border: 1px solid var(--puzzle-edge);
    border-radius: 8px;
    color: #fff1d9;
    background: #0d291e;
    text-align: left;
    cursor: pointer;
  }

  [data-puzzle-ready] .investment-more {
    display: inline-flex;
  }

  [data-puzzle-ready]:not([data-puzzle-expanded]) .investment-details {
    display: none;
  }

  .investment-chevron {
    width: 7px;
    height: 7px;
    border: solid currentColor;
    border-width: 0 1px 1px 0;
    transform: translateY(-2px) rotate(45deg);
  }

  [data-puzzle-expanded] .investment-chevron {
    transform: translateY(2px) rotate(225deg);
  }

  .investment-visual {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    background: var(--puzzle-background);
  }

  .investment-capital {
    display: grid;
    align-content: center;
    min-height: 140px;
    padding: 12px 13px;
    border: 1px solid rgba(217, 188, 131, 0.4);
    border-radius: 9px;
    background: #0d291e;
  }

  .investment-capital-label {
    font-size: 13px;
  }

  .investment-amount {
    display: flex;
    align-items: baseline;
    gap: 8px;
    justify-content: space-between;
    margin-top: 10px;
    line-height: 1.1;
    white-space: nowrap;
  }

  .investment-amount > :first-child {
    font-size: clamp(27px, 8.46vw, 36px);
    font-variant-numeric: tabular-nums;
  }

  .investment-amount > :last-child {
    font-size: 18px;
    color: var(--puzzle-muted);
  }

  .investment-count {
    display: flex;
    justify-content: space-between;
    margin-top: 9px;
    color: var(--puzzle-muted);
    font-size: 12px;
  }

  .investment-progress {
    height: 5px;
    margin-top: 9px;
    overflow: hidden;
    border-radius: 3px;
    background: #404036;
  }

  .investment-progress span {
    display: block;
    height: 100%;
    transform: scaleX(var(--investment-progress, 1));
    transform-origin: left;
    background: var(--gradient-gold);
  }

  .investment-phase {
    margin-top: 4px;
    color: var(--puzzle-muted);
    font-size: 11px;
  }

  .investment-board figcaption {
    margin-bottom: 7px;
    color: #dedede;
    font-size: 10px;
    text-transform: uppercase;
  }

  .investment-scene {
    padding: 5px 4px 7px;
    border: 1px solid var(--puzzle-edge);
    border-radius: 9px;
    background: #071814;
  }

  .investment-scene svg {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(181, 156, 102, 0.64);
    border-radius: 4px;
    overflow: hidden;
  }

  .investment-flight-label {
    fill: #fff1d9;
    stroke: #092219;
    stroke-width: 7px;
    stroke-linejoin: round;
    paint-order: stroke;
    font-size: 45px;
  }

  .investment-directions {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    grid-template-areas: 'tenants logo permits' 'contractors logo infrastructure';
    align-items: center;
    gap: 5px;
    min-height: 78px;
    padding: 9px 12px;
    border: 1px solid var(--puzzle-edge);
    border-radius: 9px;
    background: #081a14;
    color: #ebd6b0;
    font-size: clamp(9px, 2.8vw, 11px);
    text-transform: uppercase;
  }

  .investment-directions::before {
    content: '';
    position: absolute;
    inset: 50% 12px auto;
    height: 1px;
    background: linear-gradient(90deg, #d1b58261, transparent 42% 58%, #d1b58261);
  }

  .investment-directions span:nth-child(1) { grid-area: tenants; }
  .investment-directions span:nth-child(2) { grid-area: permits; }
  .investment-directions span:nth-child(3) { grid-area: contractors; }
  .investment-directions span:nth-child(4) { grid-area: infrastructure; }
  .investment-directions span:nth-child(even) { text-align: right; }

  .investment-directions picture {
    grid-area: logo;
    display: grid;
    place-items: center;
    width: 50px;
    min-height: 45px;
    border: 1px solid var(--puzzle-edge);
    border-radius: 9px;
  }

  .investment-disclaimer {
    color: var(--puzzle-muted);
    font-size: 10px;
    line-height: 1.3;
  }

  [data-puzzle-marker] {
    height: 0;
  }

  @media (640px <= width < 1024px) {
    .investment-container {
      max-width: 680px;
    }
  }

  @media (640px <= width < 1024px) and (max-height: 550px) {
    .investment-visual {
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      align-items: start;
      gap: 10px 14px;
    }

    .investment-capital {
      grid-area: 1 / 1;
    }

    .investment-amount > :first-child {
      font-size: clamp(22px, 4vw, 30px);
    }

    .investment-amount > :last-child {
      font-size: 15px;
    }

    .investment-board {
      grid-area: 1 / 2 / 3;
    }

    .investment-directions {
      grid-area: 2 / 1;
    }

    .investment-disclaimer {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .asset-puzzle {
      padding-top: 48px;
      scroll-margin-top: 112px;
    }

    .investment-container {
      width: calc(100% - 2 * clamp(30px, 5.56%, 80px));
    }

    .investment-stage {
      display: block;
      background: var(--puzzle-background);
    }

    .investment-heading {
      margin-bottom: clamp(26px, 3.3vw, 48px);
      padding-top: 0;
      border: 0;
    }

    .investment-heading h2 {
      font-size: clamp(35px, 3.48vw, 50px);
      letter-spacing: 0.01em;
    }

    .investment-desktop-title {
      display: inline;
    }

    .investment-mobile-title,
    .investment-board figcaption,
    [data-puzzle-ready] .investment-more {
      display: none;
    }

    .investment-details,
    [data-puzzle-ready]:not([data-puzzle-expanded]) .investment-details {
      display: contents;
    }

    .investment-grid {
      display: grid;
      grid-template-columns: minmax(0, 466fr) minmax(0, 788fr);
      grid-template-rows: minmax(212px, auto) minmax(212px, auto) auto;
      gap: 16px clamp(16px, 2.08vw, 30px);
      align-items: start;
      background: var(--puzzle-background);
    }

    .investment-copy {
      grid-area: 1 / 1;
      margin: 0;
      color: #dedede;
      line-height: 1.12;
    }

    .investment-details p {
      margin-top: 3px;
    }

    .investment-copy > p,
    .investment-details p:first-child {
      display: inline;
    }

    .investment-visual {
      display: contents;
    }

    .investment-capital {
      grid-area: 2 / 1;
      align-content: space-between;
      align-self: end;
      min-height: 212px;
      padding: 20px;
      border-color: var(--puzzle-edge);
      background: #071814;
    }

    .investment-capital-label {
      font-size: 20px;
    }

    .investment-amount > :first-child {
      font-size: clamp(31px, 3.54vw, 51px);
    }

    .investment-amount > :last-child {
      font-size: clamp(16px, 1.53vw, 22px);
    }

    .investment-count, .investment-phase {
      font-size: 13px;
    }

    .investment-progress {
      height: 6px;
    }

    .investment-board {
      grid-area: 1 / 2 / 3;
    }

    .investment-scene {
      padding: clamp(5px, 0.69vw, 10px);
      padding-block: clamp(7px, 0.97vw, 14px) clamp(9px, 1.39vw, 20px);
    }

    .investment-scene svg {
      border-radius: 9px;
    }

    .investment-directions {
      grid-area: 2 / 2;
      align-self: end;
      grid-template-columns: auto minmax(0, 1fr) auto minmax(0, 1fr) auto;
      grid-template-areas: 'tenants permits logo contractors infrastructure';
      min-height: 48px;
      padding: 7px clamp(10px, 1.87vw, 27px);
      gap: clamp(4px, 0.69vw, 10px);
      font-size: clamp(11px, 1.12vw, 16px);
      text-transform: none;
    }

    .investment-directions::before {
      display: none;
    }

    .investment-directions span:nth-child(even) { text-align: left; }
    .investment-directions span:nth-child(3) { text-align: right; }

    .investment-directions picture {
      width: 58px;
      min-height: 25px;
      border: 0;
    }

    .investment-disclaimer {
      grid-area: 3 / 1 / 4 / -1;
      font-size: 11px;
    }
  }

  @media (min-width: 1024px) {
    [data-puzzle-compact] .investment-heading {
      margin-bottom: 20px;
    }

    [data-puzzle-compact] .investment-grid {
      grid-template-rows: minmax(185px, auto) minmax(170px, auto) auto;
      gap: 12px clamp(16px, 2.08vw, 30px);
    }

    [data-puzzle-compact] .investment-copy {
      font-size: 14px;
    }

    [data-puzzle-compact] .investment-capital {
      min-height: 170px;
      padding-block: 12px;
    }

    [data-puzzle-compact] .investment-scene svg {
      width: min(100%, calc(clamp(140px, var(--investment-room) - 260px, 350px) * 1880 / 836));
      margin-inline: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    [data-puzzle-motion] .investment-scroll-space {
      height: var(--investment-scroll, 0px);
    }

    [data-puzzle-motion] [data-puzzle-pin='mobile'] {
      position: sticky;
      top: var(--investment-pin, 0px);
    }

    @media (min-width: 1024px) {
      [data-puzzle-motion] [data-puzzle-pin='mobile'] {
        position: static;
      }

      [data-puzzle-motion] [data-puzzle-pin='desktop'] {
        position: sticky;
        top: var(--investment-pin, 0px);
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .investment-animated-art {
      display: none;
    }
  }
</style>
