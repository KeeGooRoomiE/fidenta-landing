---
/*
  УРОВЕНЬ 3 — БЛОК «Инвестиции и то, что вокруг» (сравнительная таблица)
  Источник: Figma, узел 974:65901 («block 6 Sravnenie»)

  Настоящая семантическая таблица (<table>), не grid-имитация — данные
  реально табличные (7 характеристик × 4 варианта вложений). Колонка
  «Доля в объекте с Фидентой» подсвечена фоном #6E8078 (приглушённый sage,
  НЕ акцентное золото — так в Figma) на всю высоту таблицы; её заголовок —
  обычным кремовым цветом, остальные три заголовка — золотым градиентом
  (намеренная асимметрия, не унифицируем).

  Hairline-разделители: после шапки — полной непрозрачности (#CAD7D1),
  между остальными строками — 40% (так и в Figma, два разных значения).

  Плейсхолдер [ДАННЫЕ: порядок и срок] — как и в остальных блоках, взят
  из Figma дословно, не выдуман.

  МОБИЛЬНАЯ ВЕРСИЯ (по правке дизайнера, до md): таблица 7×4 на телефоне не
  помещается, поэтому вместо неё — «Фидента против одного»: переключатель из
  трёх альтернатив («Банковский вклад» / «Квартира» / «ЗПИФ») и две колонки —
  слева всегда наша (подсвечена #6E8078), справа выбранная. Данные те же
  (массивы columns/rows), поэтому правятся в одном месте. Полная таблица
  показывается с md и шире (hidden md:block), мобильный вид — md:hidden.
*/
const columns = ['Доля в объекте с Фидентой', 'Банковский вклад', 'Квартира под аренду', 'ЗПИФ недвижимости'];

const rows = [
  {
    label: 'Что вы покупаете',
    values: [
      'долю в конкретном здании по конкретному адресу',
      'обязательство банка вернуть сумму',
      'квартиру целиком',
      'пай фонда, состав активов определяет УК',
    ],
  },
  {
    label: 'Порог входа',
    values: ['от 200 000 ₽', 'от 1 000 ₽', 'цену квартиры целиком', 'от 1 000 ₽ у биржевых фондов'],
  },
  {
    label: 'Кто управляет',
    values: ['Фидента — тот же, кто управлял объектом до вашего входа', 'никто', 'вы сами', 'управляющая компания'],
  },
  {
    label: 'Откуда доход',
    values: ['аренда коммерческого помещения', 'процент банка', 'аренда жилья', 'аренда активов фонда и переоценка'],
  },
  {
    label: 'Как выйти',
    values: [
      'продажа доли, [ДАННЫЕ: порядок и срок]',
      'в любой день, с потерей процентов',
      'продажа квартиры, месяцы',
      'продажа пая, у биржевых — за день',
    ],
  },
  {
    label: 'Что защищает',
    values: [
      'договор. Страхования вкладов и лицензии ЦБ нет',
      'страхование АСВ в пределах лимита',
      'только право собственности',
      'лицензия ЦБ и спецдепозитарий',
    ],
  },
  {
    label: 'Главный риск',
    values: [
      'арендатор съезжает, ставка аренды снижается',
      'доход ниже инфляции',
      'простой, износ, спор с жильцом',
      'комиссии фонда и переоценка активов',
    ],
  },
];
---

<section class="py-20 md:py-28">
  <div class="container-page">
    <!-- Заголовок блока -->
    <div class="flex flex-col gap-3">
      <div class="flex items-center gap-2.5">
        <span class="h-px w-5 shrink-0" style="background: #CAD7D1;"></span>
        <span class="font-accent text-xl uppercase tracking-[0.1em] text-gold-plate">Сравнение</span>
      </div>
      <h2 class="font-accent text-4xl leading-[1.16] tracking-[-0.02em] text-fg sm:text-5xl md:text-[50px]">
        Инвестиции и то, что вокруг
      </h2>
      <p class="font-accent text-xl text-fg">Семь основных различий</p>
    </div>

    <!-- МОБИЛЬНЫЙ ВИД: «Фидента против …» с переключателем (md:hidden) -->
    <div class="mt-8 md:hidden" data-compare>
      <div class="flex flex-wrap gap-2" role="group" aria-label="С чем сравнить">
        {columns.slice(1).map((col, i) => (
          <button type="button" class="aud-btn aud-btn--sm" data-alt={i} aria-pressed={i === 0 ? 'true' : 'false'}>
            {col}
          </button>
        ))}
      </div>

      {columns.slice(1).map((col, i) => (
        <div data-panel={i} hidden={i !== 0} class="mt-6">
          <!-- Шапка двух колонок -->
          <div class="grid grid-cols-2 gap-px font-accent text-base">
            <div class="px-3 py-2 text-fg" style="background: #6E8078;">{columns[0]}</div>
            <div class="px-3 py-2 text-gold-plate">{col}</div>
          </div>
          {rows.map((row, ri) => (
            <div style={`border-top: 1px solid ${ri === 0 ? '#CAD7D1' : 'rgba(202, 215, 209, 0.4)'};`} class="mt-0">
              <p class="px-0 pb-1 pt-3 font-accent text-sm text-gold-plate">{row.label}</p>
              <div class="grid grid-cols-2 gap-px font-accent text-[15px] leading-snug text-fg">
                <p class="px-3 py-2" style="background: #6E8078;">{row.values[0]}</p>
                <p class="px-3 py-2">{row.values[i + 1]}</p>
              </div>
            </div>
          ))}
        </div>
      ))}
    </div>

    <!-- Полная таблица: md и шире (на узких экранах скрыта — см. мобильный вид выше) -->
    <div class="mt-10 hidden overflow-x-auto md:block">
      <table class="w-full min-w-[960px] border-collapse font-accent">
        <thead>
          <tr>
            <th class="w-[220px] pb-[18px] pr-6 text-left"></th>
            {columns.map((col, i) => (
              <th
                class={`px-6 pb-[18px] text-left text-xl font-normal ${i === 0 ? 'text-fg' : 'text-gold-plate'}`}
                style={i === 0 ? 'background: #6E8078;' : undefined}
              >
                {col}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {rows.map((row, ri) => (
            <tr style={`border-top: 1px solid ${ri === 0 ? '#CAD7D1' : 'rgba(202, 215, 209, 0.4)'};`}>
              <td class="py-5 pr-6 align-top text-[15px] text-gold-plate">{row.label}</td>
              {row.values.map((val, ci) => (
                <td
                  class="px-6 py-5 align-top text-[15px] text-fg"
                  style={ci === 0 ? 'background: #6E8078;' : undefined}
                >
                  {val}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<script>
  // Мобильный переключатель: показываем панель выбранной альтернативы
  const root = document.querySelector<HTMLElement>('[data-compare]');
  root?.querySelectorAll<HTMLElement>('[data-alt]').forEach((btn) =>
    btn.addEventListener('click', () => {
      root.querySelectorAll<HTMLElement>('[data-alt]').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== btn.dataset.alt));
    }),
  );
</script>
