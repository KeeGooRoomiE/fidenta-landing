---
import SectionHeading from '../ui/SectionHeading.astro';
import Section from '../ui/Section.astro';

const base = import.meta.env.BASE_URL;
const cards = [
  {
    icon: 'investor.svg',
    title: 'Для инвестора',
    text: 'Организуем совместное участие инвесторов в масштабных проектах коммерческой недвижимости',
  },
  {
    icon: 'owner.svg',
    title: 'Для собственника',
    text: 'Берём на себя согласованные задачи, освобождая ваше время для новых возможностей',
  },
  {
    icon: 'object.svg',
    title: 'Для объекта',
    text: 'Изучаем потенциал недвижимости, выявляем сильные стороны, ограничения и точки роста',
  },
  {
    icon: 'bridge.svg',
    title: 'Архитектура капитала',
    text: 'Соединяем людей, ресурсы и возможности в проекты, рассчитанные на долгосрочное развитие',
  },
];
---

<Section id="about" class="about-section" aria-label="О компании">
  <SectionHeading eyebrow="О компании" leadMax="max-w-[948px]" class="about-heading">
    <span class="text-gold-plate">Раскрываем потенциал</span> коммерческой недвижимости
    <Fragment slot="lead">
      <span>Мы верим, что за каждым объектом стоят не только квадратные метры, но и возможности.</span>
      <span>Фидента объединяет капитал, опыт и людей, чтобы находить новые пути развития коммерческой недвижимости</span>
    </Fragment>
  </SectionHeading>

  <div class="about-grid">
    <figure class="about-figure">
      <div class="about-photo plat-outline">
        <img
          src={`${base}images/office.webp`}
          alt="Офис управляющей компании «Фидента»"
          width="1535"
          height="1024"
          loading="lazy"
          decoding="async"
        />
      </div>

      <figcaption class="about-caption plat-outline">
        <p>
          Что будет востребовано здесь через год, пять, десять лет?<br class="mobile-break" />
          Во сколько это обойдётся? <br class="desktop-break" />Кому доверить работу?<br class="mobile-break" />
          Эти вопросы стоит задать до того, как <span class="desktop-wording">в проект </span>вложены миллионы
        </p>
      </figcaption>
    </figure>

    <ul class="about-cards">
      {cards.map(({ icon, title, text }) => (
        <li class="about-card plat-outline">
          <span class:list={['about-icon', { 'about-icon--bridge': icon === 'bridge.svg' }]}>
            {icon === 'bridge.svg' && (
              <svg class="about-icon-frame" viewBox="0 0 63 58" aria-hidden="true">
                <defs>
                  <linearGradient id="about-bridge-frame" x1="-16.2" y1="-14.9143" x2="58.6232" y2="83.1439" gradientUnits="userSpaceOnUse">
                    <stop stop-color="#fff1d9" />
                    <stop offset="1" stop-color="#a88548" />
                  </linearGradient>
                </defs>
                <rect x="0.35" y="0.35" width="62.3" height="57.3" rx="8.65" fill="none" stroke="url(#about-bridge-frame)" stroke-opacity="0.87" stroke-width="0.7" />
              </svg>
            )}
            <img
              src={`${base}icons/about/${icon}`}
              width={icon === 'bridge.svg' ? 58 : 63}
              height={icon === 'bridge.svg' ? 28 : 58}
              alt=""
              loading="lazy"
            />
          </span>
          <div>
            <h3 class="text-gold-plate">{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .about-section {
    --gradient-gold: linear-gradient(177deg, rgba(255, 241, 217, 0.87) 25.714%, rgba(168, 133, 72, 0.87) 120.56%);
    font-family: var(--font-accent);
    scroll-margin-top: 32px;
    zoom: calc(1 / var(--desktop-reference-zoom, 1));
  }

  .about-section :global(.container-page) {
    width: calc(100% - 2 * clamp(20px, 5.556%, 80px));
    max-width: 1280px;
    padding-inline: 0;
  }

  .about-section :global(.about-heading .text-eyebrow) {
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.2;
    letter-spacing: 0.104em;
  }

  .about-section :global(.about-heading .text-h2) {
    margin-top: 4px;
    color: #f6f3e8;
    font-size: clamp(30px, 3.48vw, 50px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .about-section :global(.about-heading .text-lead) {
    margin-top: 0;
    color: #b8c2b8;
    font-size: 16px;
    line-height: 1.25;
  }

  .about-section :global(.about-heading .text-lead > span) {
    display: block;
  }

  @media (max-width: 639px) {
    .about-section :global(.about-heading .text-lead) {
      max-width: 100%;
    }

    .about-section :global(.about-heading .text-lead > span) {
      display: inline;
    }

    .about-section :global(.about-heading .text-lead > span + span) {
      margin-top: 0.25em;
    }
  }

  .about-grid,
  .about-figure,
  .about-cards {
    display: grid;
    gap: 12px;
  }

  .about-grid {
    gap: 20px;
    margin-top: clamp(26px, 3.2vw, 46px);
  }

  .about-photo {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border-radius: 9px;
  }

  .about-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 8%;
  }

  .about-card,
  .about-caption {
    display: flex;
    align-items: center;
    border-radius: 9px;
    background: var(--color-tile);
    color: #dedede;
  }

  .about-card {
    min-height: 100px;
    gap: 14px;
    padding: 12px 16px;
  }

  .about-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 49px;
    aspect-ratio: 63 / 58;
  }

  .about-icon img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .about-icon--bridge {
    position: relative;
  }

  .about-icon-frame {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .about-icon--bridge img {
    max-width: calc(100% - 3px);
  }

  .about-card h3 {
    font-size: clamp(18px, 1.4vw, 20px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .about-card p,
  .about-caption {
    font-size: 16px;
    line-height: 1.1;
  }

  .about-card p {
    margin-top: 3px;
    letter-spacing: -0.05em;
  }

  .about-caption {
    min-height: 86px;
    justify-content: center;
    padding: 14px 18px;
    text-align: center;
  }

  .about-caption p {
    width: 100%;
    max-width: 534px;
    letter-spacing: -0.05em;
  }

  .desktop-break, .desktop-wording {
    display: none;
  }

  @media (max-width: 639px) {
    .about-section :global(.about-heading .text-h2) {
      font-size: 34px;
      line-height: 40px;
    }

    .about-grid, .about-cards { gap: 10px; }
    .about-figure { display: contents; }
    .about-photo { aspect-ratio: 350 / 190; }
    .about-card { min-height: 98px; padding: 10px; gap: 11px; }
    .about-icon { width: 42px; }
    .about-card p { font-size: 14px; margin-top: 0; }
    .about-card:nth-child(3) p { font-size: 16px; }

    .about-caption::after { display: none; }

    .about-caption {
      order: 1;
      margin-top: 10px;
      min-height: 0;
      padding: 0;
      border: 0;
      background: transparent;
      color: #b8c2b8;
      text-align: center;
      font-size: 14px;
    }
  }

  @media (min-width: 640px) {
    .about-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .about-section :global(.about-heading) {
      margin-inline-start: 10px;
    }

    .about-grid {
      grid-template-columns: minmax(0, 466fr) minmax(0, 800fr);
      gap: 14px;
    }

    .about-cards {
      grid-area: 1 / 1;
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .about-figure {
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 20px;
    }

    .about-photo {
      aspect-ratio: auto;
    }

    .about-card {
      min-height: 120px;
      padding-inline: clamp(18px, 2.78vw, 40px);
    }

    .about-card:first-child {
      padding-inline-end: clamp(14px, 1.53vw, 22px);
    }

    .about-card:first-child p {
      line-height: 1;
    }

    .about-icon {
      width: 63px;
    }

    .about-caption {
      min-height: 120px;
      padding: 12px 0;
      color: #b8c2b8;
    }

    .about-caption p { max-width: none; }
    .mobile-break { display: none; }
    .desktop-break, .desktop-wording { display: inline; }
  }
</style>
