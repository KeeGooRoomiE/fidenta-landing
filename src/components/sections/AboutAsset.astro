---
import SectionHeading from '../ui/SectionHeading.astro';
import Section from '../ui/Section.astro';

const base = import.meta.env.BASE_URL;
const cards = [
  {
    icon: 'investor.svg',
    title: 'Для инвестора',
    text: 'Организуем совместное участие инвесторов в более масштабных проектах коммерческой недвижимости',
  },
  {
    icon: 'owner.svg',
    title: 'Для собственника',
    text: 'Берём на себя согласованные задачи, освобождая ваше время для новых возможностей',
  },
  {
    icon: 'object.svg',
    title: 'Для объекта',
    text: 'Анализируем состояние объекта и определяем варианты его дальнейшего использования.',
  },
  {
    icon: 'bridge.svg',
    title: 'Архитектура капитала',
    text: 'Соединяем людей, ресурсы и возможности в проекты, рассчитанные на долгосрочное развитие',
  },
];
---

<Section id="about" class="about-section" aria-label="О компании">
  <SectionHeading eyebrow="О компании" leadMax="max-w-[948px]" class="about-heading">
    <span class="text-gold-plate">Раскрываем потенциал</span> коммерческой недвижимости
    <Fragment slot="lead">
      Мы верим, что за каждым объектом стоят не только квадратные метры, но и возможности. Фидента объединяет капитал, опыт и людей, чтобы находить новые пути развития коммерческой недвижимости
    </Fragment>
  </SectionHeading>

  <div class="about-grid">
    <figure class="about-figure">
      <div class="about-photo">
        <img
          src={`${base}images/office.webp`}
          alt="Офис управляющей компании «Фидента»"
          width="1535"
          height="1024"
          loading="lazy"
          decoding="async"
        />
      </div>

      <figcaption class="about-quote">
        <blockquote>«Недвижимость становится по-настоящему ценным активом, когда за ней стоят стратегия, профессиональное управление и понимание перспектив».</blockquote>
      </figcaption>
    </figure>

    <ul class="about-cards">
      {cards.map(({ icon, title, text }) => (
        <li class="about-card">
          <span class:list={['about-icon', { 'about-icon--bridge': icon === 'bridge.svg' }]}>
            <img
              src={`${base}icons/about/${icon}`}
              width={icon === 'bridge.svg' ? 58 : 63}
              height={icon === 'bridge.svg' ? 28 : 58}
              alt=""
              loading="lazy"
            />
          </span>
          <div>
            <h3 class="text-gold-plate">{title}</h3>
            <p>{text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .about-section {
    --gradient-gold: linear-gradient(177deg, rgba(255, 241, 217, 0.87) 25.714%, rgba(168, 133, 72, 0.87) 120.56%);
    font-family: var(--font-accent);
    scroll-margin-top: 32px;
    zoom: calc(1 / var(--desktop-reference-zoom, 1));
  }

  .about-section :global(.container-page) {
    width: calc(100% - 2 * clamp(20px, 5.556%, 80px));
    max-width: 1280px;
    padding-inline: 0;
  }

  .about-section :global(.about-heading .text-eyebrow) {
    font-size: clamp(16px, 1.4vw, 20px);
    line-height: 1.2;
    letter-spacing: 0.104em;
  }

  .about-section :global(.about-heading .text-h2) {
    margin-top: 4px;
    color: #f6f3e8;
    font-size: clamp(30px, 3.48vw, 50px);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .about-section :global(.about-heading .text-lead) {
    margin-top: 0;
    color: #b8c2b8;
    font-size: 16px;
    line-height: 1.25;
  }

  .about-grid,
  .about-figure,
  .about-cards {
    display: grid;
    gap: 12px;
  }

  .about-grid {
    gap: 20px;
    margin-top: clamp(26px, 3.2vw, 46px);
  }

  .about-photo {
    position: relative;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    border: 1px solid rgba(255, 241, 217, 0.7);
    border-radius: 9px;
  }

  .about-photo img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 8%;
  }

  .about-card,
  .about-quote {
    display: flex;
    align-items: center;
    border: 0.7px solid rgba(255, 241, 217, 0.58);
    border-radius: 9px;
    background: var(--color-tile);
    color: #dedede;
  }

  .about-card {
    min-height: 100px;
    gap: 14px;
    padding: 12px 16px;
  }

  .about-icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    width: 49px;
    aspect-ratio: 63 / 58;
  }

  .about-icon img {
    display: block;
    max-width: 100%;
    height: auto;
  }

  .about-icon--bridge {
    border: 1px solid rgba(255, 241, 217, 0.7);
    border-radius: 9px;
  }

  .about-icon--bridge img {
    max-width: calc(100% - 3px);
  }

  .about-card h3 {
    font-size: clamp(18px, 1.4vw, 20px);
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .about-card p,
  .about-quote {
    font-size: 16px;
    line-height: 1.1;
  }

  .about-card p {
    margin-top: 3px;
    letter-spacing: -0.05em;
  }

  .about-quote {
    min-height: 86px;
    justify-content: center;
    padding: 14px 18px;
  }

  .about-quote blockquote {
    width: 100%;
    max-width: 534px;
  }

  @media (min-width: 640px) {
    .about-cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .about-section :global(.about-heading) {
      margin-inline-start: 10px;
    }

    .about-grid {
      grid-template-columns: minmax(0, 466fr) minmax(0, 800fr);
      gap: 14px;
    }

    .about-cards {
      grid-area: 1 / 1;
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }

    .about-figure {
      grid-template-rows: minmax(0, 1fr) auto;
      gap: 20px;
    }

    .about-photo {
      aspect-ratio: auto;
    }

    .about-card {
      min-height: 120px;
      padding-inline: clamp(18px, 2.78vw, 40px);
    }

    .about-card:first-child {
      padding-inline-end: clamp(14px, 1.53vw, 22px);
    }

    .about-card:first-child p {
      line-height: 1;
    }

    .about-icon {
      width: 63px;
    }

    .about-quote {
      min-height: 120px;
    }
  }
</style>
