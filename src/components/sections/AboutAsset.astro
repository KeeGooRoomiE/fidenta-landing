---
/*
  УРОВЕНЬ 3 — БЛОК «Превращаем недвижимость в актив» (о компании)
  Источник раскладки: Figma, узел 974:65230 — референс ТОЛЬКО по пропорциям
  и группировке (там нет ни резиновости, ни нормальной размерной сетки,
  фикс. пиксельные ширины 466/800px — не копируем буквально).

  Структура:
   - Заголовок секции (eyebrow + H2 с золотым акцентом + подзаголовок)
   - Левая колонка — 1/3: 4 карточки подряд (инвестор/собственник/объект/
     архитектура капитала) — раньше «Архитектура капитала» была в отдельном
     нижнем ряду 50/50 с текстом, из-за чего не было самого понятия «первая
     часть» — теперь это одна левая колонка целиком.
   - Правая колонка — 2/3: фото офиса сверху, широкая текстовая карточка снизу.
   - lg:items-stretch + flex-1 на фото — правая колонка по высоте равна левой
     (4 карточки), фото тянется, текстовая карточка снизу — auto.
   - На мобильном/планшете — одна колонка, порядок как в разметке (карточки,
     потом фото, потом текст).

  Иконки карточек — inline-SVG (золото), плейсхолдеры под экспорт из Figma.
*/
import SectionHeading from '../ui/SectionHeading.astro';

const base = import.meta.env.BASE_URL;

// Три верхние карточки. key управляет тем, какую иконку рисуем.
const cards = [
  { key: 'investor', title: 'Для инвестора', text: 'Обеспечиваем прозрачные процессы, аналитику' },
  { key: 'owner', title: 'Для собственника', text: 'Снимаем операционную нагрузку, повышаем доходность и сохраняем ценность актива' },
  { key: 'object', title: 'Для объекта', text: 'Повышаем заполняемость и рыночную стоимость недвижимости.' },
];
---

<section id="about" class="py-20 md:py-28">
  <div class="container-page">
    <SectionHeading
      eyebrow="О компании"
      title="Превращаем недвижимость"
      accent="в актив"
      description="Фидента берёт на себя управление коммерческой недвижимостью, чтобы собственник получал стабильный доход, а объект становился дороже."
    />

    <!-- Левая колонка 1/3: 4 карточки. Правая колонка 2/3: фото + текст. -->
    <div class="mt-8 grid gap-6 lg:mt-12 lg:grid-cols-[1fr_2fr] lg:items-stretch lg:gap-4">
      <!-- Левая колонка. На мобильном (max-lg:order-2) идёт ПОСЛЕ фото с подписью, плитки компактные -->
      <div class="flex flex-col gap-3 max-lg:order-2 lg:gap-4">
        {cards.map((card) => (
          <article class="flex items-start gap-4 rounded-lg border border-border bg-surface p-4 lg:gap-5 lg:p-6">
            <!-- Иконка-бокс 56×56, золотой line-icon -->
            <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-accent/30 text-accent lg:size-14">
              {card.key === 'investor' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 17 9 11l4 4 8-8" />
                  <path d="M16 4h5v5" />
                </svg>
              )}
              {card.key === 'owner' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="8" r="4" />
                  <path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1" />
                </svg>
              )}
              {card.key === 'object' && (
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="4" y="3" width="16" height="18" rx="1" />
                  <path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2" />
                </svg>
              )}
            </div>
            <div>
              <h3 class="text-lg font-medium lg:text-xl">{card.title}</h3>
              <p class="mt-1 text-sm leading-snug text-muted lg:mt-1.5 lg:leading-relaxed">{card.text}</p>
            </div>
          </article>
        ))}

        <!-- «Архитектура капитала» — раньше стояла отдельным нижним рядом
             50/50 с текстом; теперь часть той же левой колонки (1/3), как в
             Figma-референсе. -->
        <article class="flex items-start gap-4 rounded-lg border border-border bg-surface p-4 lg:gap-5 lg:p-6">
          <div class="flex size-10 shrink-0 items-center justify-center rounded-lg border border-accent/30 text-accent lg:size-14">
            <!-- Знак-мост (упрощённый line-icon) -->
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M2 18h20" />
              <path d="M7 18V7M17 18V7" />
              <path d="M7 7 2 14M7 7l5 7M17 7l-5 7M17 7l5 7" />
            </svg>
          </div>
          <div>
            <h3 class="text-lg font-medium lg:text-xl">Архитектура капитала</h3>
            <p class="mt-1 text-sm leading-snug text-muted lg:mt-1.5 lg:leading-relaxed">Это наша философия. Мост соединяющий возможности.</p>
          </div>
        </article>
      </div>

      <!-- Правая колонка: фото (тянется, flex-1) + широкая текстовая карточка снизу (auto). -->
      <!-- Правая колонка. На мобильном (max-lg:order-1) идёт первой: фото, под ним подпись -->
      <div class="flex flex-col gap-3 max-lg:order-1 lg:gap-4">
        <div class="relative aspect-[2/1] flex-1 overflow-hidden rounded-lg lg:aspect-auto lg:min-h-[320px]">
          <img
            src={`${base}images/office.webp`}
            alt="Офис управляющей компании «Фидента»"
            class="absolute inset-0 h-full w-full object-cover object-[right_30%] lg:object-center"
          />
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-canvas/60 via-transparent to-transparent"></div>
        </div>

        <!-- На мобильном — простая подпись под фото (без рамки и фона), на lg — карточка -->
        <div class="flex items-center lg:rounded-lg lg:border lg:border-border lg:bg-surface lg:p-8">
          <p class="text-sm leading-relaxed text-text-soft lg:text-base">
            <!-- Мобильный — короткая версия (по правке дизайнера: полный текст слишком длинный), lg — полный -->
            <span class="lg:hidden">
              Каждый объект имеет скрытый потенциал. Мы раскрываем его грамотным управлением и долгосрочной стратегией.
            </span>
            <span class="max-lg:hidden">
              Каждый объект имеет скрытый потенциал. Мы раскрываем его за счёт грамотного управления,
              оптимизации процессов и долгосрочной стратегии развития, превращая коммерческую
              недвижимость в надёжный инвестиционный актив.
            </span>
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
