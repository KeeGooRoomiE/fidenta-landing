---
/*
  КОМПОНЕНТ — CookieBanner (баннер согласия на cookie)
  Источник: Figma, узел 974:65603 (ручная правка пользователя, узел 974:65347)

  ВАЖНО: это обычный блок в потоке документа (не fixed/overlay) — в финальной
  версии пользователь поместил его между заголовком Hero и плитками, прижатым
  вправо. Используется внутри Hero.astro: <div class="flex justify-end"><CookieBanner /></div>

  Спека:
   - фон rgba(50,63,47,0.3), сплошная кремовая рамка, backdrop-blur 100px, radius 9
     (всё — через утилиту plat-card + отдельный backdrop-blur, см. global.css)
   - padding 16/14 (top/x), gap между текстом и кнопкой — 32px
   - текст обычным переносом (в Figma текст был разбит вручную на 4 строки фикс.
     шириной — здесь НЕ повторяем, т.к. это ломает адаптивность; смысл тот же)
   - ссылка «политикой использования cookie» — цвет #ddc386 (отдельный оттенок
     золота, не входит в общую палитру — используется только здесь)
   - кнопка «Принять» — текст СПЛОШНОЙ (#f4f1ea), НЕ градиент, tracking 2.24px

  Логика: после «Принять» баннер скрывается, выбор запоминается в localStorage,
  поэтому повторно не показывается. Обёрнуто в try/catch (приватный режим и т.п.).
*/
const base = import.meta.env.BASE_URL;
---

<div id="cookie-banner" class="plat-card flex max-w-[340px] flex-col gap-8 px-3.5 py-4 backdrop-blur-[100px]">
  <p class="font-accent text-base leading-normal tracking-[-0.01em] text-fg">
    Мы используем cookie для корректной работы сайта и аналитики. Продолжая пользоваться сайтом,
    вы соглашаетесь с <a href={`${base}cookie`} class="underline decoration-from-font underline-offset-2" style="color: #ddc386;">политикой использования cookie</a>.
  </p>

  <!-- Текст сплошной (не text-gold-plate), tracking шире обычного — так в Figma именно
       у этой кнопки. letter-spacing через inline style — надёжнее, чем перебивать
       классом Tailwind значение из @utility btn-hero (конфликт порядка в CSS). -->
  <button id="cookie-accept" type="button" class="btn-hero btn-outline self-start text-fg" style="letter-spacing: 0.14em;">
    Принять
  </button>
</div>

<script>
  // Показываем баннер только если согласие ещё не дано.
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  const KEY = 'fidenta-cookie-accepted';

  try {
    if (localStorage.getItem(KEY) === '1') {
      banner?.remove();
    }
  } catch (_) {
    /* localStorage недоступен — просто показываем баннер */
  }

  accept?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, '1');
    } catch (_) {
      /* молча игнорируем, если хранилище недоступно */
    }
    banner?.remove();
  });
</script>
