---
/*
  КОМПОНЕНТ — CookieBanner (баннер согласия на cookie)
  Источник: Figma, узел 974:65603 (внутри 974:65347)

  Фростед-панель справа снизу поверх страницы (fixed — в макете статичный absolute,
  fixed удобнее для реальной прокрутки страницы).
   - фон rgba(50,63,47,0.3), сплошная кремовая рамка, radius 9 (через утилиту plat-card)
   - backdrop-blur 100px — единственное место на сайте с таким сильным размытием
     (у плиток Hero blur нет вообще). Тяжело для рендера, но так в Figma.
   - padding 16/50/10/8 (top/right/bottom/left), gap между текстом и кнопкой — 32px
   - текст "Принять" — СПЛОШНОЙ цвет (#f4f1ea), НЕ градиент (в отличие от других кнопок),
     широкий tracking 2.24px — так в Figma именно у этой кнопки

  Логика: после «Принять» баннер скрывается, выбор запоминается в localStorage,
  поэтому повторно не показывается. Обёрнуто в try/catch (приватный режим и т.п.).
*/
const base = import.meta.env.BASE_URL;
---

<div
  id="cookie-banner"
  class="plat-card fixed bottom-6 right-6 z-[60] flex w-[340px] max-w-[calc(100vw-2rem)] flex-col gap-8 pb-2.5 pl-2 pr-[50px] pt-4 backdrop-blur-[100px]"
>
  <p class="font-accent text-base leading-normal tracking-[-0.01em] text-fg">
    Мы используем cookie для корректной работы сайта и аналитики. Продолжая пользоваться сайтом,
    вы соглашаетесь с <a href={`${base}cookie`} class="text-accent-soft underline decoration-from-font underline-offset-2 hover:text-accent">политикой использования cookie</a>.
  </p>

  <!-- Текст сплошной (не text-gold-plate), tracking шире обычного — так в Figma именно
       у этой кнопки. letter-spacing через inline style — надёжнее, чем перебивать
       классом Tailwind значение из @utility btn-hero (конфликт порядка в CSS). -->
  <button id="cookie-accept" type="button" class="btn-hero btn-outline self-start text-fg" style="letter-spacing: 0.14em;">
    Принять
  </button>
</div>

<script>
  // Показываем баннер только если согласие ещё не дано.
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  const KEY = 'fidenta-cookie-accepted';

  try {
    if (localStorage.getItem(KEY) === '1') {
      banner?.remove();
    }
  } catch (_) {
    /* localStorage недоступен — просто показываем баннер */
  }

  accept?.addEventListener('click', () => {
    try {
      localStorage.setItem(KEY, '1');
    } catch (_) {
      /* молча игнорируем, если хранилище недоступно */
    }
    banner?.remove();
  });
</script>
