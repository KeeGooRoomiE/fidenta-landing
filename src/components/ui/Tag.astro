---
/*
  UI-АТОМ — Tag

  Маленькая метка-бейдж. В портфеле помечает тип объекта:
  ОФИСЫ / РИТЕЙЛ / СКЛАД / АПАРТАМЕНТЫ.

  Пример: <Tag>Офисы</Tag>
*/
interface Props {
  class?: string;
}
const { class: extraClass = '' } = Astro.props;
---

<span
  class={`inline-block rounded-md border border-border bg-canvas/40 px-3 py-1 text-[0.7rem] font-semibold uppercase tracking-wider text-accent ${extraClass}`}
>
  <slot />
</span>
