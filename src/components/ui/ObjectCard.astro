---
interface Props {
  title: string;
  lead: string;
  photos: string[];
  facts?: string[];
  labels?: string[];
  extraFacts?: { label: string; value: string }[];
  story?: { title: string; text: string }[];
  storyTitle?: string;
  id: string;
  class?: string;
  projectHref?: string;
}

const { title, lead, photos, facts = [], labels: factLabels = ['В управлении', 'Профиль', 'Заполняемость'], extraFacts = [], story = [], storyTitle = title, id, class: className, projectHref } = Astro.props;
const ctaClass = 'flex min-h-11 w-full items-center border-t pt-3 text-left text-xl leading-tight hover:underline';
---

<article class:list={['object-card relative overflow-hidden rounded-[9px] bg-interface/50 font-accent text-fg', className]} data-object-card={projectHref ? undefined : ''}>
  <div class="flex grow flex-col" data-object-front>
    <div class="relative isolate aspect-[402/225] touch-pan-y select-none overflow-hidden" data-gallery={projectHref ? undefined : ''} role="group" aria-label={projectHref ? undefined : `Фото объекта «${title}»`}>
      {photos.map((src, index) => (
        <img
          src={src}
          alt={projectHref ? '' : `${title}, фото ${index + 1}`}
          width={projectHref ? 900 : 960}
          height={projectHref ? 600 : 640}
          loading="lazy"
          decoding="async"
          draggable="false"
          data-slide={projectHref ? undefined : ''}
          hidden={index > 0}
          class:list={['absolute inset-0 size-full object-cover', projectHref && 'project-photo']}
        />
      ))}

      <div class="photo-tone" aria-hidden="true"></div>

      {!projectHref && (
        <>
          <button class="photo-arrow left-1" type="button" data-photo-step="-1" aria-label="Предыдущее фото" disabled={photos.length < 2}>
            <span class="photo-chevron" aria-hidden="true"></span>
          </button>
          <button class="photo-arrow right-1" type="button" data-photo-step="1" aria-label="Следующее фото" disabled={photos.length < 2}>
            <span class="photo-chevron" aria-hidden="true"></span>
          </button>
          <span class="photo-control absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full px-2.5 py-0.5 text-sm tabular-nums"><span class="text-gold-plate text-plat-dense" data-photo-count aria-live="polite">1 / {photos.length}</span></span>
        </>
      )}
    </div>

    <div class="card-content flex grow flex-col gap-3 p-4 sm:p-5">
      <div class="object-summary grow">
        <h3 class:list={['text-[28px] leading-tight', projectHref && 'project-title']}><slot name="title">{title}</slot></h3>
        <p class="mt-2 text-base leading-snug text-copy">{lead}</p>
      </div>
      {!projectHref && <div class="object-facts border-t border-cream/20 pt-3">
        <dl class:list={['fact-strip', extraFacts.length > 0 && 'fact-strip--scroll']} tabindex="0" aria-label={`Показатели: ${title}`}>
          {[...factLabels.map((label, index) => ({ label, value: facts[index] })), ...extraFacts].map(({ label, value }) => (
            <div><dt class="text-[11px] leading-tight text-copy">{label}</dt>
              <dd class="mt-1 text-base leading-tight text-copy">{value}</dd></div>
          ))}
        </dl>
      </div>}
      {projectHref ? (
        <a href={projectHref} class:list={[ctaClass, 'border-cream/20']}><span class="text-gold-plate">Обсудить проект <span aria-hidden="true">→</span></span></a>
      ) : (
        <button type="button" class:list={[ctaClass, 'border-cream/20']} data-object-open aria-controls={id} aria-expanded="false"><span class="object-detail-label">Подробнее об объекте <span aria-hidden="true">→</span></span></button>
      )}
    </div>
  </div>

  {!projectHref && <div id={id} class="story-card px-5 pb-2.5 pt-5 sm:px-6" data-object-back inert>
    <p class="story-eyebrow text-gold-plate font-body text-xs uppercase">История объекта</p>
    <h3 class="mt-3 border-b border-[#38604d] pb-4 text-[26px] leading-[1.16] text-fg" tabindex="-1"><span>{storyTitle}</span></h3>
    <ol class="story mt-[18px]">
      {story.map(({ title: step, text }, index) => {
        const result = index === story.length - 1 && step === 'Результат';
        const [summary, ...description] = text.split('\n');
        return (
          <li>
            <h4 class="text-xl leading-[1.16] text-gold-plate">{step}</h4>
            {result ? (
              <div class="story-result mt-2.5 rounded-[9px] plat-outline bg-interface/90 px-4 py-5">
                <p class="text-xl leading-[1.16] text-gold-plate">{summary}</p>
                {description.length > 0 && <p class="mt-1.5 text-[15px] leading-[1.22] text-copy">{description.join('. ')}</p>}
              </div>
            ) : (
              <p class="mt-2 whitespace-pre-line text-sm leading-[1.27] text-copy">{text}</p>
            )}
          </li>
        );
      })}
    </ol>
    <div class="story-footer mt-auto pt-3">
      <button type="button" class:list={[ctaClass, 'border-[#38604d]']} data-object-close><span class="text-gold-plate"><span aria-hidden="true">←</span> Вернуться к объекту</span></button>
    </div>
  </div>}
</article>

<style>
  .object-card::after {
    position: absolute;
    z-index: 3;
    inset: 0;
    padding: 1px 1px 0.7px;
    border-radius: inherit;
    background: linear-gradient(180deg, rgb(237 220 185 / 82%), rgb(186 158 111 / 74%) 43%, rgb(186 158 111 / 43%) 62%, rgb(168 133 72 / 43%));
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    pointer-events: none;
    content: '';
  }

  .object-card {
    --photo-control-bg: var(--surface-90);
  }

  .object-card:has([data-object-front]:not([inert]))::after {
    padding-top: 1.5px;
    background: linear-gradient(180deg, #26312e, #384138 40%, rgb(186 158 111 / 43%) 62%, rgb(168 133 72 / 43%));
  }

  .photo-control, .photo-arrow { opacity: .84; }
  .photo-control {
    z-index: 2;
    background: var(--photo-control-bg);
  }
  .photo-tone {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(10 28 70 / 7%), rgb(10 28 70 / 2%) 60%, rgb(10 28 70 / 6%)), rgb(20 55 112 / 4%);
  }

  .object-card--deeper-tone .photo-tone {
    background: linear-gradient(180deg, rgb(10 28 70 / 15%), rgb(10 28 70 / 7%) 60%, rgb(10 28 70 / 12%)), rgb(13 29 56 / 21%);
  }

  .fact-strip {
    gap: 8px;
    display: flex;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
  }
  .fact-strip > div { flex: 1 0 max-content; white-space: nowrap; scroll-snap-align: start; }
  .fact-strip--scroll > div { min-width: max-content; flex: 0 0 29%; scroll-snap-align: start; }
  .fact-strip dt { font-family: var(--font-legal); }
  .fact-strip dd { color: #d2d4cf; }
  .object-facts, [data-object-open] { border-color: rgb(191 178 151 / 42%); }
  .fact-strip--scroll { cursor: grab; }
  .fact-strip[data-dragging] { scroll-snap-type: none; user-select: none; cursor: grabbing; }
  .fact-strip:focus-visible { outline: 1px solid #ab9c81; outline-offset: 2px; }
  .object-detail-label { color: #cebea0; }
  [data-object-card]:has(#wash) [data-slide]:first-child,
  [data-object-card]:has(#detailing) [data-slide]:first-child { object-position: center 56%; }
  .object-facts { min-block-size: var(--facts-height, 0px); align-content: start; }
  .card-content {
    container-type: inline-size;
  }

  .project-title {
    font-size: min(28px, 10.5cqi);
  }

  .project-photo {
    object-position: center 45%;
  }

  @media (width < 768px) {
    .object-summary h3 {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .object-summary > p {
      display: -webkit-box;
      max-block-size: 3lh;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 3;
    }

    .object-facts dd {
      font-size: 14px;
      line-height: 1.2;
    }
  }

  .photo-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    width: 48px;
    height: 48px;
    translate: 0 -50%;
    place-items: center;
    isolation: isolate;
    cursor: pointer;
  }

  .photo-arrow::before {
    position: absolute;
    inset: 5px;
    z-index: -1;
    border-radius: 9px;
    background: var(--photo-control-bg);
    content: '';
  }

  .photo-arrow:hover:not(:disabled)::before {
    filter: brightness(1.12);
  }

  .photo-arrow:disabled {
    cursor: default;
  }

  .photo-chevron {
    width: 9px;
    height: 16px;
    background-image: var(--gradient-gold);
    clip-path: polygon(16% 0, 100% 50%, 16% 100%, 0 91%, 69% 50%, 0 9%);
  }

  .photo-arrow[data-photo-step='-1'] .photo-chevron {
    scale: -1 1;
  }

  .photo-arrow:disabled .photo-chevron {
    opacity: 0.6;
  }

  .object-card { display: grid; grid-template-columns: minmax(0, 1fr); min-height: var(--object-height, 0px); }
  .object-card > [data-object-front], .object-card > [data-object-back] { grid-area: 1 / 1; display: flex; flex-direction: column; }
  .object-card > [inert] { visibility: hidden; pointer-events: none; }
  .story-card {
    display: flex;
    flex: 1;
    flex-direction: column;
    background: var(--surface-60);
  }

  .story {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-inline-start: 6px;
    padding-inline-start: 28px;
  }

  .story:has(.story-result),
  .story:has(.story-result) > li:nth-last-child(2) {
    flex-grow: 1;
  }

  .story-result { padding-block: 12px; min-height: 0; flex: 1; display: flex; flex-direction: column; justify-content: center; }

  .story-result > p + p { block-size: 3lh; overflow: auto; }

  .story-eyebrow {
    --plat-text-fill: var(--gradient-gold);
  }

  .story,
  .story-footer {
    --plat-text-fill: var(--gradient-plat-subtle);
  }

  .story-footer {
    margin-inline-start: 34px;
  }

  .story li {
    position: relative;
  }

  .story-card h3 > span { display: block; min-height: var(--story-title-height, 0px); }
  .story:has(.story-result) li:not(:last-child) > p { block-size: 3lh; overflow: auto; }

  .story-card:has(.story-result) {
    padding-top: 14px;
  }
  .story-card:has(.story-result) h3 { margin-top: 7px; padding-bottom: 9px; }
  .story:has(.story-result) { margin-top: 10px; gap: 8px; }
  .story:has(.story-result) li:not(:last-child) > p { margin-top: 5px; }
  .story:has(.story-result) li:last-child { display: flex; flex-direction: column; min-height: var(--story-result-height, 0px); }
  .story-card:has(.story-result) .story-footer { padding-top: 8px; }


  .story li:not(:last-child) {
    min-height: 42px;
  }

  .story li:not(:last-child)::after {
    position: absolute;
    top: 10px;
    bottom: -24px;
    left: -22.5px;
    width: 1.5px;
    background: #38604d;
    content: '';
  }

  .story li::before {
    position: absolute;
    top: 4px;
    left: -28px;
    z-index: 1;
    width: 12px;
    height: 12px;
    border: 1px solid #d6bd8d;
    border-radius: 50%;
    background: radial-gradient(circle, #d4b981 28%, #0a2019 31%);
    content: '';
  }
</style>
