---
interface Props {
  type: string;
  title: string;
  lead: string;
  photos: string[];
  facts: string[];
  story?: { title: string; text: string }[];
  storyTitle?: string;
  id: string;
  class?: string;
}

const { type, title, lead, photos, facts, story = [], storyTitle = title, id, class: className } = Astro.props;
const factLabels = ['В управлении', 'Профиль', 'Заполняемость'];
---

<article class:list={['flex flex-col overflow-hidden rounded-[9px] border border-border bg-canvas font-accent text-fg', className]} data-object-card>
  <div class="flex grow flex-col" data-object-front>
    <div class="relative isolate aspect-[402/225] touch-pan-y select-none overflow-hidden" data-gallery role="group" aria-label={`Фото объекта «${title}»`}>
      {photos.map((src, index) => (
        <img
          src={src}
          alt={`${title}, фото ${index + 1}`}
          width="960"
          height="640"
          loading="lazy"
          decoding="async"
          draggable="false"
          data-slide
          hidden={index > 0}
          class="absolute inset-0 size-full object-cover"
        />
      ))}

      <div class="photo-tone" aria-hidden="true"></div>
      <span class="photo-control absolute left-3 top-3 rounded-full px-3 py-1 text-xs uppercase tracking-[0.08em]"><span class="text-gold-plate">{type}</span></span>

      <button class="photo-arrow left-1" type="button" data-photo-step="-1" aria-label="Предыдущее фото" disabled={photos.length < 2}>
        <span class="photo-chevron" aria-hidden="true"></span>
      </button>
      <button class="photo-arrow right-1" type="button" data-photo-step="1" aria-label="Следующее фото" disabled={photos.length < 2}>
        <span class="photo-chevron" aria-hidden="true"></span>
      </button>
      <span class="photo-control absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full px-2.5 py-0.5 text-sm tabular-nums"><span class="text-gold-plate" data-photo-count aria-live="polite">1 / {photos.length}</span></span>
    </div>

    <div class="flex grow flex-col gap-4 p-5 sm:p-6">
      <div class="grow">
        <h3 class="text-[28px] leading-tight">{title}</h3>
        <p class="mt-2 text-base leading-snug text-fg-dim">{lead}</p>
      </div>
      <dl class="grid grid-cols-3 gap-2 border-t border-cream/20 pt-3">
        {factLabels.map((label, index) => (
          <div>
            <dt class="text-[11px] leading-tight text-muted">{label}</dt>
            <dd class="mt-1 text-base leading-tight">{facts[index]}</dd>
          </div>
        ))}
      </dl>
      <button type="button" class="min-h-11 border-t border-cream/20 pt-3 text-left hover:underline" data-object-open aria-controls={id} aria-expanded="false"><span class="text-gold-plate">Подробнее об объекте <span aria-hidden="true">→</span></span></button>
    </div>
  </div>

  <div id={id} class="story-card px-5 pb-2.5 pt-5 sm:px-6" data-object-back hidden>
    <p class="text-gold-plate font-body text-xs uppercase">История объекта</p>
    <h3 class="mt-3 border-b border-[#38604d] pb-4 text-[26px] leading-[1.16] text-[#f4f1e9]" tabindex="-1">{storyTitle}</h3>
    <ol class="story mt-[18px]">
      {story.map(({ title: step, text }, index) => {
        const result = index === story.length - 1 && step === 'Результат';
        const [summary, ...description] = text.split('\n');
        return (
          <li>
            <h4 class:list={['text-xl leading-[1.16]', result ? 'text-[#d4b981]' : index === 1 ? 'text-gold-plate' : 'text-[#dedede]']}>{step}</h4>
            {result ? (
              <div class="mt-2.5 rounded-[9px] border border-cream bg-[#071814] px-4 py-3">
                <p class="text-xl leading-[1.16] text-[#d4b981]">{summary}</p>
                {description.length > 0 && <p class="mt-1.5 whitespace-pre-line text-[15px] leading-[1.22] text-[#dedede]">{description.join('\n')}</p>}
              </div>
            ) : (
              <p class="mt-2 whitespace-pre-line text-sm leading-[1.27] text-[#dedede]">{text}</p>
            )}
          </li>
        );
      })}
    </ol>
    <div class="mt-auto pt-3">
      <button type="button" class="min-h-9 w-full border-t border-[#38604d] text-left hover:underline" data-object-close><span class="text-gold-plate"><span aria-hidden="true">←</span> Вернуться к объекту</span></button>
    </div>
  </div>
</article>

<style>
  [data-gallery] {
    --photo-control-bg: #071814;
  }

  .photo-control {
    z-index: 2;
    background: var(--photo-control-bg);
  }
  .photo-tone {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(7 21 52 / 18%), rgb(12 30 62 / 8%) 60%, rgb(7 21 52 / 17%));
  }

  .photo-arrow {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: grid;
    width: 48px;
    height: 48px;
    translate: 0 -50%;
    place-items: center;
    isolation: isolate;
    cursor: pointer;
  }

  .photo-arrow::before {
    position: absolute;
    inset: 5px;
    z-index: -1;
    border-radius: 9px;
    background: var(--photo-control-bg);
    content: '';
  }

  .photo-arrow:hover:not(:disabled)::before {
    filter: brightness(1.12);
  }

  .photo-arrow:disabled {
    cursor: default;
  }

  .photo-chevron {
    width: 9px;
    height: 16px;
    background-image: var(--gradient-gold);
    clip-path: polygon(16% 0, 100% 50%, 16% 100%, 0 91%, 69% 50%, 0 9%);
  }

  .photo-arrow[data-photo-step='-1'] .photo-chevron {
    scale: -1 1;
  }

  .photo-arrow:disabled .photo-chevron {
    opacity: 0.6;
  }

  .story-card:not([hidden]) {
    display: flex;
    flex: 1;
    flex-direction: column;
    background: #0a2019;
    box-shadow: inset 0 0 0 1px #fff1d9;
    border-radius: 8px;
  }

  .story {
    display: grid;
    gap: 14px;
    margin-inline-start: 6px;
    padding-inline-start: 28px;
  }

  .story li {
    position: relative;
  }

  .story li:not(:last-child) {
    min-height: 79px;
  }

  .story li:not(:last-child)::after {
    position: absolute;
    top: 10px;
    bottom: -24px;
    left: -22.5px;
    width: 1.5px;
    background: #38604d;
    content: '';
  }

  .story li::before {
    position: absolute;
    top: 4px;
    left: -28px;
    z-index: 1;
    width: 12px;
    height: 12px;
    border: 1px solid #d6bd8d;
    border-radius: 50%;
    background: radial-gradient(circle, #d4b981 28%, #0a2019 31%);
    content: '';
  }
</style>
