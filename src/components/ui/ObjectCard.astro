---
interface Props {
  type: string;
  title: string;
  lead: string;
  photos: string[];
  facts?: { label: string; value: string }[];
  story?: { title: string; text: string }[];
  id: string;
  class?: string;
}

const { type, title, lead, photos, facts = [], story = [], id, class: className } = Astro.props;
---

<article class:list={['flex flex-col overflow-hidden rounded-[9px] border border-border bg-canvas font-accent text-fg', className]} data-object-card>
  <div class="flex grow flex-col" data-object-front>
    <div class="relative aspect-[402/225] touch-pan-y select-none overflow-hidden" data-gallery role="group" aria-label={`Фото объекта «${title}»`}>
      {photos.map((src, index) => (
        <img
          src={src}
          alt={`${title}, фото ${index + 1}`}
          width="960"
          height="640"
          loading="lazy"
          decoding="async"
          draggable="false"
          data-slide
          hidden={index > 0}
          class="absolute inset-0 size-full object-cover"
        />
      ))}

      <div class="photo-tone" aria-hidden="true"></div>
      <span class="absolute left-3 top-3 rounded-full bg-[#091d17]/90 px-3 py-1 text-xs uppercase tracking-[0.08em] text-cream">{type}</span>

      {photos.length > 1 && (
        <>
          <button class="photo-arrow left-1" type="button" data-photo-step="-1" aria-label="Предыдущее фото">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </button>
          <button class="photo-arrow right-1" type="button" data-photo-step="1" aria-label="Следующее фото">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </button>
          <span class="absolute bottom-3 left-1/2 -translate-x-1/2 rounded-full bg-[#081320]/75 px-2.5 py-0.5 text-sm tabular-nums text-white" data-photo-count aria-live="polite">1 / {photos.length}</span>
        </>
      )}
    </div>

    <div class="flex grow flex-col gap-4 p-5 sm:p-6">
      <div class="grow">
        <h3 class="text-[28px] leading-tight">{title}</h3>
        <p class="mt-2 text-base leading-snug text-fg-dim">{lead}</p>
      </div>
      {facts.length > 0 && (
        <dl class="flex flex-wrap gap-x-5 gap-y-2">
          {facts.map(({ label, value }) => (
            <div>
              <dt class="text-xs uppercase tracking-wide text-muted">{label}</dt>
              <dd class="mt-0.5 text-lg leading-tight">{value}</dd>
            </div>
          ))}
        </dl>
      )}
      <button type="button" class="border-t border-cream/20 pt-3 text-left text-cream hover:underline" data-object-open aria-controls={id} aria-expanded="false">История объекта <span aria-hidden="true">↗</span></button>
    </div>
  </div>

  <div id={id} class="p-5 sm:p-6" data-object-back hidden>
    <p class="text-eyebrow text-gold-plate">История объекта</p>
    <h3 class="mt-2 border-b border-cream/20 pb-4 text-[28px] leading-tight" tabindex="-1">{title}</h3>
    <ol class="story mt-5">
      {story.map(({ title: step, text }, index) => (
        <li>
          <h4 class="text-xl text-cream">{step}</h4>
          <p class:list={['mt-1 text-base leading-snug text-fg-dim', index === story.length - 1 && 'rounded-lg border border-cream/20 bg-[#102923] p-3']}>{text}</p>
        </li>
      ))}
    </ol>
    <button type="button" class="mt-5 w-full border-t border-cream/20 pt-3 text-left text-cream hover:underline" data-object-close>← Назад к карточке</button>
  </div>
</article>

<style>
  .photo-tone {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(180deg, rgb(7 21 52 / 18%), rgb(12 30 62 / 8%) 60%, rgb(7 21 52 / 17%));
  }

  .photo-arrow {
    position: absolute;
    top: 50%;
    display: grid;
    width: 48px;
    height: 48px;
    translate: 0 -50%;
    place-items: center;
    isolation: isolate;
    color: white;
    cursor: pointer;
  }

  .photo-arrow::before {
    position: absolute;
    inset: 5px;
    z-index: -1;
    border-radius: 9px;
    background: rgb(9 30 25 / 76%);
    content: '';
  }

  .photo-arrow:hover::before {
    background: rgb(9 30 25 / 92%);
  }

  .story {
    display: grid;
    gap: 16px;
    margin-inline-start: 6px;
    border-inline-start: 1px solid rgb(255 241 217 / 30%);
    padding-inline-start: 17px;
  }

  .story li {
    position: relative;
  }

  .story li::before {
    position: absolute;
    top: 8px;
    left: -22px;
    width: 9px;
    height: 9px;
    border: 1px solid #d6bd8d;
    border-radius: 50%;
    background: #0a2019;
    content: '';
  }
</style>
