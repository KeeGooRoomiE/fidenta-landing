---
/*
  UI-АТОМ — Input

  Поле формы: подпись (label) + input. Используется в блоке CTA.
  name важен — по нему данные попадут в питон-скрипт отправки заявки
  (см. scripts/send_cta.py и .github/workflows/cta-email.yml).

  Пример:
    <Input label="Имя" name="name" placeholder="Александр" required />
    <Input label="E-mail" name="client_email" type="email" placeholder="example@mail.ru" />
*/
interface Props {
  label: string;
  name: string;
  type?: 'text' | 'email' | 'tel' | 'number' | 'password';
  placeholder?: string;
  required?: boolean;
}

const { label, name, type = 'text', placeholder = '', required = false } = Astro.props;
---

<label class="flex flex-col gap-2">
  <span class="text-sm text-muted">{label}</span>
  <input
    type={type}
    name={name}
    placeholder={placeholder}
    required={required}
    class="rounded-lg border border-border bg-canvas/40 px-4 py-3 text-fg placeholder:text-muted/60 transition-colors focus:border-accent focus:outline-none"
  />
</label>
