---
/*
  UI-ЭЛЕМЕНТ — StepItem

  Один шаг процесса в блоке «От заявки до стабильного дохода».
  Номер в кружке + заголовок + короткое описание.

  Пример:
    <StepItem number={1} title="Заявка" text="Оставляете заявку, обсуждаем объект и ваши цели." />
*/
interface Props {
  number: number;
  title: string;
  text: string;
}
const { number, title, text } = Astro.props;
---

<div class="flex flex-col items-center text-center">
  <div
    class="mb-5 flex h-14 w-14 items-center justify-center rounded-full border border-border text-lg font-semibold text-accent"
  >
    {number}
  </div>
  <h3 class="mb-2 text-lg">{title}</h3>
  <p class="max-w-[13rem] text-sm leading-relaxed text-muted">{text}</p>
</div>
