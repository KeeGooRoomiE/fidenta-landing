# Переменные окружения — шаблон
#
# Скопируй этот файл в .env и заполни реальными значениями:
#   cp .env.example .env
#
# НИКОГДА не коммить .env с реальными данными — он в .gitignore.
# Для GitHub Actions настраивай секреты в Settings → Secrets → Actions.

# ============================================================
# ASTRO
# Базовый путь для сборки. Устанавливается автоматически в CI.
# Локально можно не указывать — astro.config.mjs подставит значение по умолчанию.
# ============================================================
ASTRO_BASE_PATH=/fidenta-landing/

# ============================================================
# SMTP — для отправки CTA-заявок (scripts/send_cta.py)
# ============================================================
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=587
SMTP_USER=noreply@fidenta.ru
SMTP_PASSWORD=your_app_password_here

# ============================================================
# CTA EMAIL — куда приходят заявки с формы
# ============================================================
CTA_RECIPIENT_EMAIL=manager@fidenta.ru

# ============================================================
# TELEGRAM — для уведомлений о статусе воркфлоу
# Настраивается только в GitHub Secrets, локально не нужно.
# ============================================================
TELEGRAM_BOT_TOKEN=123456789:ABC-your-bot-token-here
TELEGRAM_CHAT_ID=-100123456789
